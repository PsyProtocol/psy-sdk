  "query": "\n            SELECT\n                user_id, public_key, tx_type,\n                metadata, timestamp, created_at, updated_at\n            FROM user_events\n            WHERE tx_type = 'GUTA'\n                AND metadata->>'checkpoint_id' = $1::text\n            ORDER BY timestamp DESC\n            ",
