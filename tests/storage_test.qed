impl Contract {
    pub fn new() -> Self {
        return new Contract {
            a: 0,
            b: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0
            },
            c: 0,
            d: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0
            }
        };
    }

    pub fn set_abcd(a: Felt, b: Person, c: Felt, d: Person) {
        Contract::set_a(a);
        Contract::set_b(b);
        Contract::set_c(c);
        Contract::set_d(d);
    }

