fn match_test_case(input: Felt) -> Felt {
    let mut result: Felt = 0;

    match input {
        0 => {
            result += 10;
        },
        1 => {
            result += 20;
        },
        2 => {
            result += 30;
        },
        //❌ 3 | 4 => {
        3 => {
            result += 40;
        },
        4 => {
            result += 40;
        },
        //❗ MUST have a "_" case
        _ => {
            result += 50;
        },
    //❌ }
    };


    let extra: Felt = match input {
        0 => {100},
        1 => {200},
        2 => {300},
        _ => {400},
    };

    result + extra
}

fn main() {
    assert_eq(match_test_case(0), 110, "test match ");  // 10 + 100
    assert_eq(match_test_case(1), 220, "test match "); // 20 + 200
    assert_eq(match_test_case(2), 330, "test match "); // 30 + 300
    assert_eq(match_test_case(3), 440, "test match "); // 40 + 400
    assert_eq(match_test_case(4), 440, "test match "); // 40 + 400
    assert_eq(match_test_case(5), 450, "test match "); // 50 + 400
    assert_eq(match_test_case(99), 450, "test match "); // 50 + 400
}