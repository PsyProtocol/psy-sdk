
pub mod person{
    pub struct Person {
        age: Felt,
        height: Felt,
        weight: Felt,
        isMale: Felt,
    }

    impl Person {
        pub fn cal1(a: Felt, b: Felt) -> Felt {
            let c: Felt = a + b;
            return c;
        }
        fn cal2(name: Felt, age: Felt, height: Felt, weight: Felt) -> Felt {
            let c: Felt = age + height + weight;
            let d: Felt = 10;
            return c;
        }
    }
}
