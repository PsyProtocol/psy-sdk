pub mod person;

pub use person::Person;

fn test_path(a: Felt, b: Felt) -> Felt {
    let c: Felt = a + b;
    return c;
}

struct Person {
    age: Felt,
    height: Felt,
    weight: Felt,
}

impl Person {
    pub fn cal1(a: Felt, b: Felt) -> Felt {
        let c: Felt = a + b;
        return c;
    }

    fn cal2(name: Felt, age: Felt, height: Felt, weight: Felt) -> Felt {
        let c: Felt = age + height + weight;
        let d: Felt = 10;
        return c;
    }
}


struct Person1 {
    age: Felt,
    height: Felt,
}

impl Person1 {
    pub fn cal1(a: Felt, b: Felt) -> Felt {
        let c: Felt = a + b;
        return c;
    }

    fn cal2(name: Felt, age: Felt, height: Felt, weight: Felt) -> Felt {
        let c: Felt = age + height + weight;
        let d: Felt = 10;
        return c;
    }
}

fn main() {
    let mut c: Felt = 10;
    c = 5;
    let e: Felt = Person::cal1(3, 4);
    let f: Felt = Person1::cal1(3, 4);
    let g: Felt = person::Person::cal1(3, 4);
}
