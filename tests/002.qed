mod math;

use math::*;

struct Person {
    age_height: [Felt; 2],
    year_of_birth: Felt
}

impl Person {
    fn set_age(self: Person, new_age: Felt) {
        self.age_height[0] = new_age;
    }

    fn get_age(self: Person) -> Felt {
        return self.age_height[0];
    }

    fn set_height(self: Person, new_height: Felt) {
        self.age_height[1] = new_height;
    }

    fn get_height(self: Person) -> Felt {
        return self.age_height[1];
    }
}

fn main() {
    let a: Felt = 1;
    let b: Felt = 2;

    let c: Felt = a + -b;
    let d: [Felt; 2] = [a, b];
    let e: Felt = d[0];

    let t: bool = true;
    let f: bool = false;

    let r: bool = !t && f;

    min(a, b);

    let person: Person = (Person{
        year_of_birth: 1990,
        age_height: [1, 1]
    });
    person.set_age(10);
    person.set_height(20);
    let age: Felt = person.get_age();
    let height: Felt = person.get_height();
}
