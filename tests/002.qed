fn main() -> Felt {
    let storage: ContractStorage = ContractStorage::constructor();
    storage.set_a(10);
    storage.set_b(new Person {
        age: 20,
        height: 180,
        year_of_birth: 2000
    });
    // storage.set_c(30);
    // storage.set_d(new Person {
    //     age: 40,
