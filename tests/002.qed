impl ContractStorage {
    pub fn constructor() -> Self {
        return new ContractStorage {
            a: 0,
            b: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0
            },
            c: 0,
            d: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0
            }
        };
    }

    pub fn set_abcd(self: Self, a: Felt, b: Person, c: Felt, d: Person) {
        self.set_a(a);
        self.set_b(b);
        self.set_c(c);
        self.set_d(d);
    }

