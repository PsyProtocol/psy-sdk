mod pub_mod;

pub use pub_mod::*;

struct Test{
    pub x: Felt,
    y: Felt
}

impl Test{
    pub fn get_sum(self: Test) -> Felt{
        return self.x + self.y;
    }
}


fn main(a: Felt, b: Felt) -> Felt {

    let t: Test = new Test{
        x: a,
        y: b
    };

    let res: Felt = t.get_sum();

    let a: Add = Add::new(a, b);

    let res2: Felt = a.get_sum();

    pub_mod::void_fn();

    return t.x;
}
