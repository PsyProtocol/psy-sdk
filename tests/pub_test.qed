mod pub_mod;

use pub_mod::*;

struct Test{
    x: Felt,
    y: Felt
}

impl Test{
    fn get_sum(this: Test) -> Felt{
        return this.x + this.y;
    }
}


fn main(a: Felt, b: Felt) -> Felt {

    let t: Test = new Test{
        x: a,
        y: b
    };
    
    let res: Felt = t.get_sum();

    let a: Add = Add::new_(a, b);

    let res2: Felt = a.get_sum();

    pub_mod::void_fn();

    return t.x;
}