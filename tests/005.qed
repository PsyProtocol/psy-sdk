struct Person {
    age: Felt,
    male: bool
}

impl Person {
    fn set_age(self: Person, new_age: Felt) {
        self.age = new_age;
    }
    fn get_age(self: Person) -> Felt {
        return self.age;
    }
}

struct Family {
    father: Person,
    mother: Person,
    children: [Person; 2]
}

fn main() {
    let father: Person = new Person { age: 50, male: true };
    let mother: Person = new Person { age: 50, male: false };
    let boy: Person = new Person { age: 20, male: true };
    let girl: Person = new Person { age: 20, male: false };

    let family: Family = new Family { father: father, mother: mother, children: [boy, girl]};

    let boy_age: Felt = family.children[0].get_age();
}
