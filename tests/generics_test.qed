impl<T, N: u32> [T; N] {
    pub const fn len() -> u32 {
        return N + (1 as u32);
    }
}

pub trait Hello {
    pub fn hello(self);
}

impl Hello for Felt {
    pub fn hello(self) {
    }
}

struct Box<T: Hello> {
    pub data: T
}


impl<T: Hello> Box<T> {
    pub fn new(data: T) -> Box<T> {
        return new Box { data };
    }
}

fn main() -> Felt {
    let mut b: Box<Felt> = <Box<Felt>>::new(42);
    b.data += 1;
    b.data + (<[Felt; 3]>::len() as Felt)
}
