struct Person<T> {
    pub age: T
}

fn modify_person<T>(mut p: Person<T>) {
    p.age += 1;
}

impl<T> Person<T> {
    pub fn new(age: T) -> Self {
        new Person#<T> { age: age }
    }

    pub fn set_age(mut self: Self, age: T) {
        self.age = age;
    }

    pub fn get_age(self: Self) -> T {
        self.age
    }
}

fn main() -> Felt {
    let age = 10;
    let p = new Person { age };
    // let arr: [Felt; 2] = [0, 1];
    p.set_age(20);
    modify_person(p);
    p.age
}
