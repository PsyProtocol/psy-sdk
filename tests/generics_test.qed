impl<T, N> [T; N] {
    pub const fn len() -> u32 {
        return N;
    }
}

struct Box<T> {
    pub data: T
}


impl<T> Box<T> {
    pub fn new(data: T) -> Box<T> {
        return new Box { data };
    }
}

fn main() -> Felt {
    let mut b: Box<Felt> = Box::new(42);
    b.data += 1;
    b.data
}
