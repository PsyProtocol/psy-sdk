
#[test]
#[should_panic]
fn test_simple_panic() {
  // Directly assert false to trigger a panic
  assert(false, "This assertion is deliberately false to test should_panic");
}
#[test]
#[should_panic]
fn test_panic_with_expected_message() {
  // Another direct assert with a specific message
  assert_eq(1, 2, "expected failure message");
}
// Test that should pass normally
#[test]
fn test_that_passes() {
  assert(true, "This should pass");
}
fn main(a: Felt, b: Felt) -> Felt {
  assert(a < b, "a should be less than b");
  return a + b;
}