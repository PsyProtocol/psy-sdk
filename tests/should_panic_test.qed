// Test file for should_panic functionality

// Test with should_panic attribute - no expected message
#[test]
#[should_panic]
fn test_simple_panic() {
  // Directly assert false to trigger a panic
  assert(false, "This assertion is deliberately false to test should_panic");
}

// Test with should_panic attribute with expected message
#[test]
#[should_panic]
fn test_panic_with_expected_message() {
  // Another direct assert with a specific message
  assert_eq(1, 2, "expected failure message");
}

// Test that should pass normally
#[test]
fn test_that_passes() {
  assert(true, "This should pass");
}

// Main function for executing directly with the 'execute' command
// This should fail immediately because of the false assertion
fn main(a: Felt, b: Felt) -> Felt {
  // This assertion should fail during execution
  assert(false, "This assertion should always fail");
  return a + b;
} 