fn cal1(a: Felt, b: Felt) -> Felt {
    let c: Felt = a + b;
    return c;
}
fn min(a: Felt, b: Felt) -> Felt {
    if a < b { a } else { b }
}
fn middle(a: Felt, b: Felt, c: Felt) -> Felt {
    if a > b {
        if b > c {
            b
        } else if a > c {
            c
        } else {
            a
        }
    } else {
        if a > c {
            a
        } else if b > c {
            c
        } else {
            b
        }
    }
}
fn cal2(a: Felt, b: Felt)  {
