mod math{
    pub fn max(a: Felt, b: Felt) -> Felt {
        return a * ((a > b) as Felt) + b * ((a <= b) as Felt);
    }

    pub fn min(a: Felt, b: Felt) -> Felt {
        return a * ((a < b) as Felt) + b * ((a >=b) as Felt);
    }
}

pub use math::*;

fn main() {

}

#[test]
fn test_min() {
    assert!(min(2, 3) == 2, "min(2, 3) == 2");
}

#[test]
fn test_max() {
    assert!(max(2, 3) == 3, "max(2, 3) == 3");
}
