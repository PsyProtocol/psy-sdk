{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, public_key, checkpoint_id, reward_amount,\n                   timestamp, created_at, updated_at\n            FROM worker_event_rewards\n            WHERE public_key = $1\n                AND checkpoint_id >= $2\n                AND checkpoint_id <= $3\n            ORDER BY checkpoint_id DESC, timestamp DESC\n            ",
