{
  "name": "@qed/qed-ts-sdk",
  "version": "1.0.0",
  "main": "dist/index",
  "types": "dist/index",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json",
    "bind": "npx barrelsby -c .barrelsby.json",
    "prepublishOnly": "pnpm run build",
    "test:integration": "jest --testNamePattern=\"Integration\"",
    "test:unit": "jest --testNamePattern=\"(?!Integration)\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "30.0.0-beta.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "barrelsby": "^2.8.1",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "rimraf": "~5.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "~4.9.0"
  },
  "dependencies": {
    "doge-sdk": "^0.4.1",
    "lossless-json": "^4.0.1",
    "poseidon-goldilocks-lite": "^0.2.3"
  }
}
