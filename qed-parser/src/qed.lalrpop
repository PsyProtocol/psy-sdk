use qed_common::{FileId, Arena};
use qed_builder::{Context, ContextFelt};
use qed_ast::*;
use qed_lexer::{Token, Error};

grammar<'input, F, C>(
    file_content: &'input str,
    file_id: FileId,
    module_name: IdentId,
    expr_nodes: &mut Arena<ExprId, ExprNode<F>>,
    stmt_nodes: &mut Arena<StmtId, StmtNode<F>>,
    def_nodes: &mut Arena<DefId, DefinitionNode>,
    interner: &mut Interner,
    is_std: bool,
    is_self_std: bool,
    is_self_prelude: bool,
    ctx: &mut C
) where F: ContextFelt, C: Context<F>;

use super::Loc;
use std::convert::TryFrom;
use std::collections::HashMap;

pub Module: ModuleNode = {
    <l:@L> <mut modules:ModuleDecl*> <mut uses:ModuleUse*> <definitions:Definition*> <r:@R> => ModuleNode {
        name: module_name,
        file_id,
        modules: {
            if !is_std {
                modules.insert(0, IdentId::STD);
            }
            modules
        },
        uses: {
            if !is_std  {
                uses.insert(0, UsePath {
                    kind: UseKind::MODULE(IdentId::STD),
                    segments: vec![IdentId::PRELUDE],
                    target: None,
                });
            } else if !is_self_std && !is_self_prelude {
                uses.insert(0, UsePath {
                    kind: UseKind::MODULE(IdentId::PRELUDE),
                    segments: vec![],
                    target: None,
                });
            }
            uses
        },
        definitions: def_nodes.alloc_items(definitions),
        is_std,
        is_self_std,
        is_self_prelude,
    }
}

ModuleDecl: IdentId = {
    <l:@L> MOD <name:Identifier> ";" <r:@R> => name
}

ModuleUse: UsePath = {
    <l:@L> USE <path:Path> ";" <r:@R> => UsePath {
        kind: UseKind::from(path.0),
        target: path.2,
        segments: path.1,
    }
}

Statement: StmtNode<F> = {
    VariableStatement,
    AssignmentStatement,
    ReturnStatement,
    WhileStatement,
    BlockStatement,
    IfStatement,
    Definition => StmtNode::Definition(def_nodes.alloc_item(<>)),
    ExpressionStatement
}

ExpressionStatement: StmtNode<F> = {
    <l:@L> <expr:Expression> ";" <r:@R> => StmtNode::Expression(expr_nodes.alloc_item(expr))
}

Definition: DefinitionNode = {
    ImplDef => DefinitionNode::Impl(<>),
    TraitDef => DefinitionNode::Trait(<>),
    EnumDef => DefinitionNode::Enum(<>),
    StructDef => DefinitionNode::Struct(<>),
    FunctionDef => <>,
}

ImplDef: ImplNode = {
   <l:@L> IMPL <generic_parameters_lhs:GenericParameters?> <ty:Identifier> <generic_parameters_rhs:GenericParameters?> "{" <body:FunctionDef*> "}" <r:@R> => {
       assert_eq!(generic_parameters_lhs, generic_parameters_rhs);
       ImplNode {
           generic_parameters: generic_parameters_lhs.unwrap_or(Vec::new()),
           trait_name: None,
           ty,
           body: def_nodes.alloc_items(body)
       }
   },
   <l:@L> IMPL <generic_parameters_lhs:GenericParameters?> <trait_name:Identifier> FOR <ty:Identifier> <generic_parameters_rhs:GenericParameters?> "{" <body:FunctionDef*> "}" <r:@R> => {
       assert_eq!(generic_parameters_lhs, generic_parameters_rhs);
       ImplNode {
           generic_parameters: generic_parameters_lhs.unwrap_or(Vec::new()),
           trait_name: Some(trait_name),
           ty,
           body: def_nodes.alloc_items(body)
       }
   }
}

TraitDef: TraitNode = {
   <l:@L> TRAIT <name:Identifier> <generic_parameters:GenericParameters?> "{" <body:FunctionDecl*> "}" <r:@R> => {
       TraitNode {
           generic_parameters: generic_parameters.unwrap_or(Vec::new()),
           name,
           body
       }
   }
}

EnumDef: EnumNode = {
    <l:@L> ENUM <name:Identifier> <generic_parameters:GenericParameters?> "{" <variants:Comma<EnumVariant>>  "}" <r:@R> => EnumNode {
        name,
        generic_parameters: generic_parameters.unwrap_or(Vec::new()),
        variants
    }
}

Attribute: AttrNode = {
    <l:@L> "#" "[" <name:IdentifierOrDerive>  <properties:AttributeProperties?> "]" <r:@R> => AttrNode { name, properties: properties.unwrap_or(Vec::new()) }
}

AttributeProperties: Vec<IdentId> = {
    <l:@L> "(" <properties:Comma<Identifier>> ")" <r:@R> => properties
}

StructDef: StructNode = {
    <l:@L> <attrs:Attribute*> STRUCT <name:Identifier> <generic_parameters:GenericParameters?> "{" <fields:Comma<TypeAnnotation>> "}" <r:@R> => StructNode {
        name,
        generic_parameters: generic_parameters.unwrap_or(Vec::new()),
        fields,
        attrs
    }
}

FunctionDef: DefinitionNode = {
    <l:@L> FN <name:Identifier> <generic_parameters:GenericParameters?> "(" <parameters:Comma<FunctionParameter>> ")" <return_type:FunctionReturn?> <block_stmt:BlockStatement> <r:@R> => DefinitionNode::Function(FunctionNode {
        name,
        parameters,
        generic_parameters: generic_parameters.unwrap_or(Vec::new()),
        body: Some(stmt_nodes.alloc_item(block_stmt)),
        return_type,
        is_extern: false
    })
}

FunctionDecl: FunctionNode = {
    <l:@L> <is_extern:EXTERN?> FN <name:Identifier> <generic_parameters:GenericParameters?> "(" <parameters:Comma<FunctionParameter>> ")" <return_type:FunctionReturn?> ";" <r:@R> => FunctionNode {
        name,
        parameters,
        generic_parameters: generic_parameters.unwrap_or(Vec::new()),
        body: None,
        return_type,
        is_extern: is_extern.is_some()
    }
}

FunctionReturn: UncheckedType = {
    <l:@L> "->" <return_type:Ty> <r:@R> => return_type
}

EnumVariant: EnumVariant = {
    <l:@L> <name:Identifier> <r:@R> => EnumVariant::Basic(name),
    <l:@L> <name:Identifier> "(" <members:Comma<Ty>> ")" <r:@R> => EnumVariant::Tuple(name, members),
    <l:@L> <name:Identifier> "{" <fields:Comma<TypeAnnotation>> "}" <r:@R> => EnumVariant::Struct(name, fields)
}

FunctionParameter: (IdentId, bool, UncheckedType) = {
    <l:@L> <mutable:MUT?> <name:IdentifierOrSelf> ":" <ty:Ty> <r:@R> => (name, mutable.is_some(), ty)
}

TypeAnnotation: (IdentId, UncheckedType) = {
    <l:@L> <name:Identifier> ":" <ty:Ty> <r:@R> => (name, ty)
}

GenericParameters: Vec<IdentId> = {
    <l:@L> "<" <generic_parameters:Comma<Identifier>> ">" <r:@R> => generic_parameters
}

BlockStatement: StmtNode<F> = {
    <l:@L> "{" <stmts:Statement*> "}" <r:@R> => StmtNode::Block(BlockNode { stmts: stmt_nodes.alloc_items(stmts) }),
}

WhileStatement: StmtNode<F> = {
    <l:@L> WHILE <predicate:Expression> <block_stmt:BlockStatement> <r:@R>  => StmtNode::While(WhileNode {
        predicate: expr_nodes.alloc_item(predicate),
        body: stmt_nodes.alloc_item(block_stmt)
    }),
}

IfStatement: StmtNode<F> = {
    <l:@L> <if_branch:IfBranch> <elseif_branch:ElseIfBranch*> <else_branch:ElseBranch?> <r:@R> => StmtNode::If(
        IfNode {
            if_branch,
            elseif_branch,
            else_branch
        }
    ),
}

IfBranch: Case = {
    <l:@L> IF <predicate:Expression> <block_stmt:BlockStatement> <r:@R> => Case::new(
        expr_nodes.alloc_item(predicate),
        stmt_nodes.alloc_item(block_stmt)
    ),
}

ElseIfBranch: Case = {
    <l:@L> ELSE IF <predicate:Expression> <block_stmt:BlockStatement> <r:@R> => Case::new(
        expr_nodes.alloc_item(predicate),
        stmt_nodes.alloc_item(block_stmt)
    ),
}

ElseBranch: StmtId = {
    <l:@L> ELSE <block_stmt:BlockStatement> <r:@R> => stmt_nodes.alloc_item(block_stmt),
}

ReturnStatement: StmtNode<F> = {
    <l:@L> RETURN <ret:Expression?> ";" <r:@R> => StmtNode::Return(ReturnNode(ret.map(|x| expr_nodes.alloc_item(x))))
}

VariableStatement: StmtNode<F> = {
    <l:@L> LET <mutable:MUT?> <decl:TypeAnnotation> "=" <value:Expression> ";" <r:@R>  => StmtNode::Variable(
        VariableNode {
            name: decl.0,
            ty: decl.1,
            mutable: mutable.is_some(),
            cnst: false,
            value: expr_nodes.alloc_item(value)
        }
    ),
    <l:@L> CONST <decl:TypeAnnotation> "=" <value:Expression> ";" <r:@R>  => StmtNode::Variable(
        VariableNode {
            name: decl.0,
            ty: decl.1,
            mutable: false,
            cnst: true,
            value: expr_nodes.alloc_item(value)
        }
    ),
}

AssignmentStatement: StmtNode<F> = {
    <l:@L> <variable:Expression> "=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::Eq, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "+=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::AddAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "-=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::SubAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "*=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::MulAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "/=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::DivAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "%=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::ModAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "&=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitAndAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "|=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitOrAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "^=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitXorAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> "<<=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitShlAssign, expr_nodes.alloc_item(value))
    ),
    <l:@L> <variable:Expression> ">>=" <value:Expression> ";" <r:@R> => StmtNode::Assignment(
        AssignmentNode::new(expr_nodes.alloc_item(variable), AssignmentOperator::BitShrAssign, expr_nodes.alloc_item(value))
    )
}

Term: ExprNode<F> = {
    <l:@L> "(" <expr:Expression> ")" <r:@R> => expr,
    ValueExpression,
    <l:@L> <name:IdentifierOrSelf> <r:@R> => ExprNode::<F>::Path(PathNode(name)),
}

Expression: ExprNode<F> = {
    #[precedence(level="1")]
    Term,

    #[precedence(level="2")]
    <l:@L> <variable:Expression> <generic_parameters:Monomorphization?> "(" <args:Comma<Expression>> ")" <r:@R> => ExprNode::<F>::Call(
        CallNode {
            receiver: if let ExprNode::<F>::MemberAccess(MemberAccessNode { value: receiver, .. }) = &variable { Some(receiver.clone()) } else { None },
            variable: expr_nodes.alloc_item(variable),
            generic_parameters: generic_parameters.unwrap_or(Vec::new()),
            args: expr_nodes.alloc_items(args)
        }
    ),
    <l:@L> <variable:Expression> "[" <index:NUMBER> "]" <r:@R> => ExprNode::<F>::IndexAccess(IndexAccessNode {
        value: expr_nodes.alloc_item(variable),
        index: usize::try_from(index).unwrap()
    }),
    <l:@L> <variable:Expression> "." <field:Identifier> <r:@R> => ExprNode::<F>::MemberAccess(MemberAccessNode {
        value: expr_nodes.alloc_item(variable),
        field
    }),

    #[precedence(level="3")]
    <l:@L> "!" <rhs:Expression> <r:@R> => ExprNode::<F>::Unary(
        UnaryNode{operator: UnaryOperator::Not, rhs: expr_nodes.alloc_item(rhs)}
    ),
    <l:@L> "-" <rhs:Expression> <r:@R> => ExprNode::<F>::Unary(
        UnaryNode{operator: UnaryOperator::Neg, rhs: expr_nodes.alloc_item(rhs)}
    ),

    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> AS <ty:TYPE_FELT> <r:@R> => ExprNode::<F>::Cast(
        CastNode::new(expr_nodes.alloc_item(lhs), UncheckedType::Basic(IdentId::TYPE_FELT))
    ),
    <l:@L> <lhs:Expression> AS <ty:TYPE_BOOL> <r:@R> => ExprNode::<F>::Cast(
        CastNode::new(expr_nodes.alloc_item(lhs), UncheckedType::Basic(IdentId::TYPE_BOOL))
    ),

    #[precedence(level="5")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "*" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Mul, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "/" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Div, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "%" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Mod, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "+" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Add, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "-" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Sub, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="7")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "<<" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::BitShl, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> ">>" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::BitShr, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="8")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "&" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::BitAnd, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="9")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "^" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::BitXor, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="10")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "|" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::BitOr, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="11")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> ">" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Gt, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "<" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Lt, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> ">=" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Gte, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "<=" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Lte, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="12")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "==" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Eq, expr_nodes.alloc_item(rhs))
    ),
    <l:@L> <lhs:Expression> "!=" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Neq, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="13")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "&&" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::And, expr_nodes.alloc_item(rhs))
    ),

    #[precedence(level="14")] #[assoc(side="left")]
    <l:@L> <lhs:Expression> "||" <rhs:Expression> <r:@R> => ExprNode::<F>::Binary(
        BinaryNode::new(expr_nodes.alloc_item(lhs), BinaryOperator::Or, expr_nodes.alloc_item(rhs))
    ),
}

ValueExpression: ExprNode<F> = {
    FeltExpression,
    BoolExpression,
    ArrayExpression,
    NEW <StructExpression>
}

FeltExpression: ExprNode<F> = {
    <l:@L> <n:NUMBER> <r:@R> => ExprNode::<F>::Value(ValueNode::Felt(ctx.op_const(n))),
}

BoolExpression: ExprNode<F> = {
    <l:@L> <b:BOOL> <r:@R> => ExprNode::<F>::Value(ValueNode::Bool(ctx.op_bool(b)))
}

StructExpression: ExprNode<F> = {
    <l:@L> <name:Identifier> <generic_parameters:Monomorphization?> "{" <kv:Comma<KeyValue>> "}" <r:@R> => ExprNode::<F>::Value(ValueNode::Struct(
        name,
        generic_parameters.unwrap_or(Vec::new()),
        kv.into_iter().collect()
    )),
}

KeyValue: (IdentId, ExprId) = {
    <l:@L> <name:Identifier> ":" <value:Expression> <r:@R> => (name, expr_nodes.alloc_item(value))
}

ArrayExpression: ExprNode<F> = {
    <l:@L> "[" <elements:Comma<Expression>> "]" <r:@R> => ExprNode::<F>::Value(
        ValueNode::Array(elements.len(), expr_nodes.alloc_items(elements))
    ),
}

Path: (IdentId, Vec<IdentId>, Option<IdentId>) =
    <a:ModuleUseKind> "::" <h:(<Identifier> "::")*> <t:IdentifierOrAll> => {
        (a, h, t)
    };

Monomorphization: Vec<UncheckedType> = {
    <l:@L> "::" "<" <generic_parameters:Comma<Ty>> ">" <r:@R> => generic_parameters
}

Ty: UncheckedType = {
    BasicType,
    ArrayType,
    GenericType
}

GenericType: UncheckedType = {
    <l:@L> <name:Identifier> "<" <generic_parameters:Comma<Ty>> ">" <r:@R> => UncheckedType::Generic(name, generic_parameters)
}

ArrayType: UncheckedType = {
    <l:@L> "[" <ty:Ty> ";" <n:NUMBER> "]" <r:@R> => UncheckedType::Array(Box::new(ty), usize::try_from(n).unwrap())
}

BasicType: UncheckedType = {
    <l:@L> <ty:TYPE_FELT>  <r:@R> => UncheckedType::Basic(IdentId::TYPE_FELT),
    <l:@L> <ty:TYPE_BOOL>  <r:@R> => UncheckedType::Basic(IdentId::TYPE_BOOL),
    <l:@L> <ty:TYPE_SELF>  <r:@R> => UncheckedType::Basic(IdentId::TYPE_SELF),
    <l:@L> <ty:Identifier> <r:@R> => UncheckedType::Basic(ty)
}

ModuleUseKind: IdentId = {
    <l:@L> SELF            <r:@R> => IdentId::SELF,
    <l:@L> SUPER           <r:@R> => IdentId::SUPER,
    <l:@L> CRATE           <r:@R> => IdentId::CRATE,
    <l:@L>  <k:Identifier> <r:@R> => k
}

IdentifierOrAll: Option<IdentId> = {
    Identifier => Some(<>),
    <l:@L> "*" <r:@R> => None
}

IdentifierOrSelf: IdentId = {
    Identifier,
    <l:@L> <name:SELF> <r:@R> => IdentId::SELF
}

IdentifierOrDerive: IdentId = {
    Identifier,
    <l:@L> <name:DERIVE> <r:@R> => IdentId::DERIVE
}

Identifier: IdentId = {
    <l:@L> <name:IDENT> <r:@R> => interner.intern_ident(name)
}

Sep<E,S>: Vec<E> =
    <v0:(<E> S)*> <e1:E?> =>
        v0.into_iter().chain(e1).collect();

DoubleColon<E>: Vec<E> = Sep<E, "::">;
Dot<E>: Vec<E> = Sep<E, ".">;
Comma<E>: Vec<E> = Sep<E, ",">;
Plus<E>: Vec<E> = Sep<E, "+">;

extern {
    type Location = Loc;
    type Error = Error;

    enum Token<'input> {
        CONST => Token::KeywordConst,
        LET => Token::KeywordLet,

        MUT => Token::KeywordMut,

        FN => Token::KeywordFn,
        STRUCT => Token::KeywordStruct,
        ENUM => Token::KeywordEnum,
        IMPL => Token::KeywordImpl,
        TRAIT => Token::KeywordTrait,
        RETURN => Token::KeywordReturn,
        IF => Token::KeywordIf,
        ELSE => Token::KeywordElse,
        WHILE => Token::KeywordWhile,
        FOR => Token::KeywordFor,
        WHERE => Token::KeywordWhere,

        MOD => Token::KeywordMod,
        USE => Token::KeywordUse,
        SUPER => Token::KeywordSuper,
        CRATE => Token::KeywordCrate,
        SELF => Token::KeywordSelf,

        PUB => Token::KeywordPub,

        STD => Token::KeywordStd,

        IDENT => Token::Ident(<&'input str>),

        BOOL => Token::Bool(<bool>),
        NUMBER => Token::Number(<u64>),

        TYPE_BOOL => Token::TypeBool,
        TYPE_FELT => Token::TypeFelt,
        TYPE_SELF => Token::TypeSelf,

        DERIVE => Token::KeywordDerive,

        AS => Token::KeywordAs,
        EXTERN => Token::KeywordExtern,
        NEW => Token::KeywordNew,

        "#" => Token::Pound,

        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        "[" => Token::LBracket,
        "]" => Token::RBracket,

        "=" => Token::Assign,
        ";" => Token::Semicolon,
        "," => Token::Comma,
        "." => Token::Dot,
        ":" => Token::Colon,
        "::" => Token::DoubleColon,
        "->" => Token::Arrow,

        "+" => Token::OperatorAdd,
        "-" => Token::OperatorSub,
        "*" => Token::OperatorMul,
        "/" => Token::OperatorDiv,
        "%" => Token::OperatorMod,

        "==" => Token::OperatorEq,
        "!=" => Token::OperatorNeq,
        "<" => Token::OperatorLt,
        "<=" => Token::OperatorLte,
        ">" => Token::OperatorGt,
        ">=" => Token::OperatorGte,
        "&&" => Token::OperatorAnd,
        "||" => Token::OperatorOr,

        "&" => Token::OperatorBitAnd,
        "|" => Token::OperatorBitOr,
        "^" => Token::OperatorBitXor,

        "<<" => Token::OperatorShl,
        ">>" => Token::OperatorShr,

        "!" => Token::OperatorNot,

        "+=" => Token::OperatorAddAssign,
        "-=" => Token::OperatorSubAssign,
        "*=" => Token::OperatorMulAssign,
        "/=" => Token::OperatorDivAssign,
        "%=" => Token::OperatorModAssign,

        "|=" => Token::OperatorBitOrAssign,
        "&=" => Token::OperatorBitAndAssign,
        "^=" => Token::OperatorBitXorAssign,

        "<<=" => Token::OperatorBitShlAssign,
        ">>=" => Token::OperatorBitShrAssign,
    }
}
