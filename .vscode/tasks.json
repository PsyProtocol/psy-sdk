{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "file-run",
      "type": "shell",
      "command": "rustc \"${file}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": "RUN"
    },
    {
      "label": "project-build",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "BUILD",
      "isBackground": true,
      "presentation": {
        "revealProblems": "onProblem"
      }
    },
    {
      "label": "project-run",
      "type": "shell",
      "command": "cargo run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "RUN"
    },
    {
      "label": "project-test",
      "type": "shell",
      "command": "cargo test ${input:testName} -- --nocapture",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "TEST"
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Enter the name of the test to run"
    }
  ]
}
