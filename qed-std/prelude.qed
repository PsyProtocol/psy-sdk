pub trait Storage {
    pub fn size() -> Felt;
    pub extern fn read(offset: Felt) -> Self;
    pub extern fn write(offset: Felt, value: Self);
}

impl Storage for Felt {
    pub fn size() -> Felt {
        return 1;
    }

    pub extern fn read(offset: Felt) -> Self {}
    pub extern fn write(offset: Felt, value: Self) {}
}

impl Storage for bool {
    pub fn size() -> Felt {
        return 1;
    }

    pub extern fn read(offset: Felt) -> Self {}
    pub extern fn write(offset: Felt, value: Self) {}
}
