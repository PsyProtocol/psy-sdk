pub trait Storage {
    pub fn size() -> Felt;
    pub extern fn read(offset: Felt) -> Self;
    pub extern fn write(offset: Felt, value: Self);
}

impl Storage for Felt {
    pub fn size() -> Felt {
        return 1;
    }

    pub extern fn read(offset: Felt) -> Self {}
    pub extern fn write(offset: Felt, value: Self) {}
}

impl Storage for bool {
    pub fn size() -> Felt {
        return 1;
    }

    pub extern fn read(offset: Felt) -> Self {}
    pub extern fn write(offset: Felt, value: Self) {}
}

pub extern fn get_user_id() -> Felt { }

pub extern fn get_contract_id() -> Felt {}

pub extern fn get_checkpoint_id() -> Felt {}

pub extern fn get_last_nonce() -> Felt {}

pub extern fn get_user_public_key_hash() -> [Felt; 4] {}

pub extern fn get_state_hash_at(slot_index: Felt) -> [Felt; 4] {}

pub extern fn get_other_contract_state_hash_at(contract_state_tree_height: Felt, contract_id: Felt, slot_index: Felt) -> [Felt; 4] {}

pub extern fn get_other_user_contract_state_hash_at(contract_state_tree_height: Felt, user_id: Felt, contract_id: Felt, slot_index: Felt) -> [Felt; 4] {}

pub extern fn cset_state_hash_at(slot_index: Felt, new_value: [Felt; 4]) -> [Felt; 4] {}
