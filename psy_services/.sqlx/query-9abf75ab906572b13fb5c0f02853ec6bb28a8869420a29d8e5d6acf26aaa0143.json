  "query": "\n            SELECT\n                user_id, public_key, tx_type as \"tx_type: UserEventTxType\",\n                metadata, timestamp, created_at, updated_at\n            FROM user_events\n            WHERE timestamp >= $1 AND timestamp <= $2\n            ORDER BY timestamp DESC\n            ",
