{
  "name": "@psy-protocol/psy-sdk",
  "version": "1.1.8",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./local-web-compiler": {
      "import": "./dist/local-web-compiler/index.mjs",
      "require": "./dist/local-web-compiler/index.cjs",
      "types": "./dist/local-web-compiler/index.d.ts"
    },
    "./local-web-compiler/compiler": {
      "import": "./dist/local-web-compiler/compiler.mjs",
      "require": "./dist/local-web-compiler/compiler.cjs",
      "types": "./dist/local-web-compiler/compiler.d.ts"
    },
    "./local-web-compiler/psy_compiler": {
      "import": "./dist/local-web-compiler/psy_compiler.mjs",
      "require": "./dist/local-web-compiler/psy_compiler.cjs",
      "types": "./dist/local-web-compiler/psy_compiler.d.ts"
    },
    "./local-web-compiler/wasm-binary": {
      "import": "./dist/local-web-compiler/wasm-binary.mjs",
      "require": "./dist/local-web-compiler/wasm-binary.cjs",
      "types": "./dist/local-web-compiler/wasm-binary.d.ts"
    },
    "./local-web-prover": {
      "import": "./dist/local-web-prover/index.mjs",
      "require": "./dist/local-web-prover/index.cjs",
      "types": "./dist/local-web-prover/index.d.ts"
    },
    "./local-web-prover/prover": {
      "import": "./dist/local-web-prover/prover.mjs",
      "require": "./dist/local-web-prover/prover.cjs",
      "types": "./dist/local-web-prover/prover.d.ts"
    },
    "./local-web-prover/psy_prover": {
      "import": "./dist/local-web-prover/psy_prover.mjs",
      "require": "./dist/local-web-prover/psy_prover.cjs",
      "types": "./dist/local-web-prover/psy_prover.d.ts"
    },
    "./local-web-prover/wasm-binary": {
      "import": "./dist/local-web-prover/wasm-binary.mjs",
      "require": "./dist/local-web-prover/wasm-binary.cjs",
      "types": "./dist/local-web-prover/wasm-binary.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.cjs",
      "types": "./dist/*/index.d.ts"
    },
    "./*/*": {
      "import": "./dist/*/*.mjs",
      "require": "./dist/*/*.cjs",
      "types": "./dist/*/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' src/local-web-prover/build-wasm-binary.ts",
    "build:wasm-compiler": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' src/local-web-compiler/build-wasm-binary.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' pnpm run precompile && NODE_OPTIONS='--max-old-space-size=8192' pnpm run compile",
    "precompile": "cpx ../../../config.json src/config && pnpm run clean && pnpm run build:wasm && pnpm run build:wasm-compiler",
    "clean": "rimraf dist",
    "compile": "rollup -c",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 100",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "type-check": "pnpm run precompile && tsc --noEmit",
    "bind": "npx barrelsby -c .barrelsby.json",
    "prepublishOnly": "pnpm run build",
    "test:integration": "jest --testNamePattern=\"Integration\"",
    "test:unit": "jest --testNamePattern=\"(?!Integration)\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "30.0.0-beta.3",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "barrelsby": "^2.8.1",
    "cpx": "^1.5.0",
    "eslint": "^8.57.1",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "rimraf": "~5.0.10",
    "rollup": "^4.59.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~4.9.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "doge-sdk": "^0.4.5",
    "lossless-json": "^4.3.0",
    "poseidon-goldilocks-lite": "^0.2.3"
  }
}
