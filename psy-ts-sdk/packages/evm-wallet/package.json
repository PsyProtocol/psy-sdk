{
  "name": "@psy-protocol/evm-wallet",
  "version": "0.1.0",
  "description": "EVM wallet integration for the Psy network: sign in and authorize every Psy operation (deposit, withdraw, transfer, private transfer, claim, UPS proof sessions, inbox, activity) with any EVM wallet via personal_sign — no held key, no seed phrase.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs",
      "types": "./dist/react/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.mjs",
      "types": "./dist/worker.d.ts"
    }
  },
  "sideEffects": [
    "./dist/worker.mjs",
    "./dist/worker.cjs"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "compile": "tsc --noEmit && rollup -c",
    "build": "pnpm run clean && pnpm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@psy-protocol/psy-sdk": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "ethers": "^6.13.0",
    "react": "^18.0.0 || ^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "nostr-tools": "^2.10.0",
    "poseidon-goldilocks-lite": "^0.2.3"
  },
  "devDependencies": {
    "@jest/globals": "30.0.0-beta.3",
    "@psy-protocol/psy-sdk": "workspace:*",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tanstack/react-query": "^5.51.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.0",
    "ethers": "^6.16.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "rimraf": "~5.0.10",
    "rollup": "^4.59.1",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.0",
    "typescript": "^5.5.2",
    "viem": "^2.51.0",
    "wagmi": "^2.19.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
