{
  "name": "@psy-protocol/contract-sdk",
  "version": "1.1.13",
  "description": "ZK Contract SDK with generated contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "abi"
  ],
  "scripts": {
    "clean": "rm -rf dist generated/*",
    "build": "tsc -p tsconfig.build.json",
    "generate": "tsx src/cli.ts -i ./abi/contract.abi.json -o ./generated",
    "postgenerate": "prettier --write ./generated/**/*.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@psy-protocol/psy-sdk": "workspace:*",
    "@psy-protocol/utils": "workspace:*",
    "commander": "^11.1.0",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~4.9.5"
  }
}
