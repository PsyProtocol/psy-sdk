{
  "name": "contract-sdk",
  "version": "1.0.0",
  "description": "ZK Contract SDK with generated contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist generated/*",
    "build": "tsc -p tsconfig.build.json",
    "generate": "tsx src/cli.ts -i ./abi/contract.abi.json -o ./generated",
    "postgenerate": "prettier --write ./generated/**/*.ts"
  },
  "dependencies": {
    "@qed/psy-sdk": "workspace:*",
    "@qed/utils": "workspace:*",
    "commander": "^11.0.0",
    "ethers": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "tsx": "^4.7.0",
    "typescript": "~4.9.0",
    "prettier": "^3.5.3"
  }
}