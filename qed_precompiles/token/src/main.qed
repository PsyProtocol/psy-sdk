use std::prelude::*;
use new_rewards::PsyPOWMiningRewardsClaimContractRef;

#[derive(Storage, StorageRef)]
struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[contract]
#[derive(Storage, StorageRef)]
struct PsyTokenContract {
    pub balance: Felt,
    pub other_user_info: [OtherUserInfo; 1073741824],
    pub last_claimed_pow_rewards_checkpoint_id: Felt
}

impl PsyTokenContractRef {
    pub fn simple_mint(amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        c.balance.set(c.balance.get() + amount);
        // invoke_deferred(0, 354447671, [999, 1]);
    }

    pub fn simple_burn(amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");
        c.balance.set(current_balance - amount);
    }

    pub fn simple_transfer(recipient: Felt, amount: Felt) {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");

        let mut recipient_info = c.other_user_info.index(recipient).get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

        c.other_user_info.index(recipient).set(new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed
        });

        c.balance.set(current_balance - amount);
    }

    pub fn simple_claim(sender: Felt) {
        let self_user_id = get_user_id();
        assert(sender != self_user_id, "you cannot claim from your self");

        let c = PsyTokenContractRef::new(ContractMetadata::current());

        let sender_user_contract = PsyTokenContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_total_sent = sender_user_contract.other_user_info.index(self_user_id).get().amount_sent;

        let mut sender_info = c.other_user_info.index(sender).get();
        assert(sender_info.amount_claimed < sender_total_sent, "no tokens to claim from this sender");
        let claimed = sender_total_sent - sender_info.amount_claimed;

        c.other_user_info.index(sender).set(new OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent
        });

        c.balance.set(c.balance.get() + claimed);
    }

    pub fn simple_claim_pow_rewards() {
        let c = PsyTokenContractRef::new(ContractMetadata::current());
        let self_user_id: Felt = get_user_id();

        let pow_rewards_persistant_state: Hash = get_other_user_contract_state_hash_at(0, self_user_id, 2, 0);

        let checkpoint_id = get_checkpoint_id();

        assert(pow_rewards_persistant_state[1] == checkpoint_id, "the claims must be from the latest ups");
        assert(pow_rewards_persistant_state[3] == checkpoint_id, "the checkpoint must be sealed");
        assert(c.last_claimed_pow_rewards_checkpoint_id.get() < checkpoint_id, "must haven't already claimed during this ups");

        c.last_claimed_pow_rewards_checkpoint_id.set(checkpoint_id);

        c.balance.set(c.balance.get() + pow_rewards_persistant_state[2]);
    }

    pub fn claim_pow_rewards() {
        let c = PsyTokenContractRef::new(ContractMetadata::current());

        let psy_pow_mining_rewards_claim_contract = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::new(2, get_user_id()));
        let pow_rewards_persistant_state = psy_pow_mining_rewards_claim_contract.persistant_state.get();

        let checkpoint_id = get_checkpoint_id();

        assert(pow_rewards_persistant_state.last_claimed_ups_checkpoint_id == checkpoint_id, "the claims must be from the latest ups");
        assert(pow_rewards_persistant_state.sealed_for_ups_checkpoint_id == checkpoint_id, "the checkpoint must be sealed");
        assert(c.last_claimed_pow_rewards_checkpoint_id.get() < checkpoint_id, "must haven't already claimed during this ups");

        c.last_claimed_pow_rewards_checkpoint_id.set(checkpoint_id);

        c.balance.set(c.balance.get() + pow_rewards_persistant_state.claimed_rewards);
    }
}
