pub trait KVQBinaryStoreCached {
    fn begin_transaction(&self) -> u64;
    fn commit(&self) -> anyhow::Result<()>;
    fn rollback(&self) -> anyhow::Result<()>;
}

impl<S: KVQBinaryStoreAsync + Send + Sync> KVQBinaryStoreCached for KVQSimpleCachedStore<S> {
    fn begin_transaction(&self) -> u64 {
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(self.begin_transaction()))
    }

    fn commit(&self) -> anyhow::Result<()> {
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(self.commit()))
    }

    fn rollback(&self) -> anyhow::Result<()> {
        tokio::task::block_in_place(|| tokio::runtime::Handle::current().block_on(self.rollback()))
    }
}

