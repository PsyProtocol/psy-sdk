use std::{
    collections::{BTreeMap, HashMap},
    ops::Bound::Included,
    sync::{
        atomic::{AtomicU64, Ordering},
        Arc,
    },
};

use anyhow::Result;
use tokio::sync::RwLock;

use crate::{
    traits::{KVQBinaryStore, KVQBinaryStoreAsync, KVQPair},
    transactional::{KVQTransactionalStore, KVQTransactionalStoreAsync},
};

#[derive(Clone, Debug)]
pub enum CacheValueType {
    Bytes(Vec<u8>),
    Removed,
}

#[derive(Clone)]
pub struct KVQSimpleCachedStore<S: KVQBinaryStoreAsync> {
    pub store: Arc<S>,
    pub proper_delete_return: bool,
    pub transactions: Arc<RwLock<HashMap<u64, BTreeMap<Vec<u8>, CacheValueType>>>>,
    pub tx_stack: Arc<RwLock<Vec<u64>>>,
    pub tx_id_counter: Arc<AtomicU64>,
}

impl<S: KVQBinaryStoreAsync> KVQSimpleCachedStore<S> {
    pub fn new(store: Arc<S>) -> Self {
        Self {
            store,
            proper_delete_return: false,
            transactions: Arc::new(RwLock::new(HashMap::new())),
            tx_stack: Arc::new(RwLock::new(Vec::new())),
            tx_id_counter: Arc::new(AtomicU64::new(1)),
        }
    }

    pub async fn begin_transaction(&self) -> u64 {
        let tx_id = self.tx_id_counter.fetch_add(1, Ordering::SeqCst);
        self.transactions.write().await.insert(tx_id, BTreeMap::new());
        self.tx_stack.write().await.push(tx_id);
        tx_id
    }

    pub async fn commit(&self) -> anyhow::Result<()> {
        let tx_id = self
            .tx_stack
            .write()
            .await
            .pop()
            .ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let changes = self.transactions.write().await.remove(&tx_id);
        if let Some(changes) = changes {
            let keys_to_set: Vec<KVQPair<Vec<u8>, Vec<u8>>> = changes
                .iter()
                .filter_map(|(k, v)| match v {
                    CacheValueType::Bytes(b) => Some(KVQPair {
                        key: k.clone(),
                        value: b.clone(),
                    }),
                    CacheValueType::Removed => None,
                })
                .collect();

            let keys_to_delete: Vec<Vec<u8>> = changes
                .iter()
                .filter_map(|(k, v)| match v {
                    CacheValueType::Bytes(_) => None,
                    CacheValueType::Removed => Some(k.clone()),
                })
                .collect();

            let keys_to_set_ref: Vec<KVQPair<&Vec<u8>, &Vec<u8>>> = keys_to_set
                .iter()
                .map(|kv| KVQPair {
                    key: &kv.key,
                    value: &kv.value,
                })
                .collect();

            self.store.set_many_ref(&keys_to_set_ref).await?;
            self.store.delete_many(&keys_to_delete).await?;
        }
        Ok(())
    }

    pub async fn rollback(&self) -> anyhow::Result<()> {
        let tx_id = self
            .tx_stack
            .write()
            .await
            .pop()
            .ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        self.transactions.write().await.remove(&tx_id);
        Ok(())
    }

    fn get_leq_from_cache(&self, key: &Vec<u8>, fuzzy_bytes: usize, map: &BTreeMap<Vec<u8>, CacheValueType>) -> Option<KVQPair<Vec<u8>, Vec<u8>>> {
        if fuzzy_bytes == 0 {
            for (k, v) in map.range(..=key.clone()).rev() {
                match v {
                    CacheValueType::Bytes(b) => {
                        return Some(KVQPair {
                            key: k.clone(),
                            value: b.clone(),
                        });
                    }
                    CacheValueType::Removed => {}
                }
            }
        } else {
            let key_end = key.to_vec();
            let mut base_key = key.to_vec();
            let key_len = base_key.len();

            for i in 0..fuzzy_bytes {
                base_key[key_len - i - 1] = 0;
            }

            for (k, v) in map.range((Included(base_key), Included(key_end))).rev() {
                match v {
                    CacheValueType::Bytes(b) => {
                        return Some(KVQPair {
                            key: k.clone(),
                            value: b.clone(),
                        });
                    }
                    CacheValueType::Removed => {}
                }
            }
        }
        None
    }
}

#[async_trait::async_trait]
impl<S: KVQBinaryStoreAsync + Send + Sync> KVQBinaryStoreAsync for KVQSimpleCachedStore<S> {
    async fn get_exact_if_exists(&self, key: &Vec<u8>) -> Result<Option<Vec<u8>>> {
        let tx_stack = self.tx_stack.read().await;
        if let Some(tx_id) = tx_stack.last() {
            let transactions = self.transactions.read().await;
            let map = transactions.get(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;

            if let Some(value) = map.get(key) {
                match value {
                    CacheValueType::Bytes(b) => return Ok(Some(b.clone())),
                    CacheValueType::Removed => return Ok(None),
                }
            }
        }
        self.store.get_exact_if_exists(key).await
    }

    async fn get_exact(&self, key: &Vec<u8>) -> Result<Vec<u8>> {
        let tx_stack = self.tx_stack.read().await;
        if let Some(tx_id) = tx_stack.last() {
            let transactions = self.transactions.read().await;
            let map = transactions.get(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;

            if let Some(value) = map.get(key) {
                match value {
                    CacheValueType::Bytes(b) => return Ok(b.clone()),
                    CacheValueType::Removed => return Err(anyhow::anyhow!("Key was deleted from cache")),
                }
            }
        }
        self.store.get_exact(key).await
    }

    async fn get_many_exact(&self, keys: &[Vec<u8>]) -> Result<Vec<Vec<u8>>> {
        let tx_stack = self.tx_stack.read().await;
        if let Some(tx_id) = tx_stack.last() {
            let transactions = self.transactions.read().await;
            let map = transactions.get(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;

            let mut results = Vec::with_capacity(keys.len());
            let mut missing_indices = Vec::new();
            let mut missing_keys = Vec::new();

            for (i, key) in keys.iter().enumerate() {
                if let Some(value) = map.get(key) {
                    match value {
                        CacheValueType::Bytes(b) => results.push(Some(b.clone())),
                        CacheValueType::Removed => return Err(anyhow::anyhow!("Key was deleted from cache")),
                    }
                } else {
                    results.push(None);
                    missing_indices.push(i);
                    missing_keys.push(key.clone());
                }
            }

            if !missing_keys.is_empty() {
                let store_values = self.store.get_many_exact(&missing_keys).await?;
                for (idx, value) in missing_indices.iter().zip(store_values) {
                    results[*idx] = Some(value);
                }
            }

            results.into_iter().map(|r| r.ok_or_else(|| anyhow::anyhow!("Missing value"))).collect()
        } else {
            self.store.get_many_exact(keys).await
        }
    }

    async fn get_leq(&self, key: &Vec<u8>, fuzzy_bytes: usize) -> Result<Option<Vec<u8>>> {
        if fuzzy_bytes > key.len() {
            return Err(anyhow::anyhow!("Fuzzy bytes must be less than or equal to key length"));
        }

        let tx_stack = self.tx_stack.read().await;
        let empty_map = BTreeMap::new();
        let transactions = self.transactions.read().await;

        let cache_map = if let Some(tx_map) = tx_stack.last().and_then(|tx_id| transactions.get(tx_id)) {
            tx_map
        } else {
            &empty_map
        };

        let cache_candidate = self.get_leq_from_cache(key, fuzzy_bytes, cache_map);
        let store_candidate = self.store.get_leq_kv(key, fuzzy_bytes).await?;

        match (cache_candidate, store_candidate) {
            (None, None) => Ok(None),
            (Some(c), None) => Ok(Some(c.value)),
            (None, Some(s)) => {
                if cache_map.get(&s.key).map_or(false, |v| matches!(v, CacheValueType::Removed)) {
                    Ok(None)
                } else {
                    Ok(Some(s.value))
                }
            }
            (Some(c), Some(s)) => {
                if cache_map.get(&s.key).map_or(false, |v| matches!(v, CacheValueType::Removed)) {
                    Ok(Some(c.value))
                } else {
                    Ok(Some(if c.key >= s.key { c.value } else { s.value }))
                }
            }
        }
    }

    async fn get_fuzzy_range_leq_kv(&self, key: &Vec<u8>, fuzzy_bytes: usize) -> Result<Vec<KVQPair<Vec<u8>, Vec<u8>>>> {
        if fuzzy_bytes > key.len() {
            return Err(anyhow::anyhow!("Fuzzy bytes must be less than or equal to key length"));
        }

        let tx_stack = self.tx_stack.read().await;
        let empty_map = BTreeMap::new();
        let transactions = self.transactions.read().await;

        let cache_map = if let Some(tx_map) = tx_stack.last().and_then(|tx_id| transactions.get(tx_id)) {
            tx_map
        } else {
            &empty_map
        };

        let key_end = key.to_vec();
        let mut base_key = key.to_vec();
        let key_len = base_key.len();

        for i in 0..fuzzy_bytes {
            base_key[key_len - i - 1] = 0;
        }

        let mut results = BTreeMap::new();

        for item in self.store.get_fuzzy_range_leq_kv(key, fuzzy_bytes).await? {
            results.insert(item.key.clone(), item);
        }

        for (k, v) in cache_map.range((Included(base_key), Included(key_end))) {
            match v {
                CacheValueType::Bytes(b) => {
                    results.insert(
                        k.clone(),
                        KVQPair {
                            key: k.clone(),
                            value: b.clone(),
                        },
                    );
                }
                CacheValueType::Removed => {
                    results.remove(k);
                }
            }
        }

        Ok(results.into_values().collect())
    }

    async fn get_leq_kv(&self, key: &Vec<u8>, fuzzy_bytes: usize) -> Result<Option<KVQPair<Vec<u8>, Vec<u8>>>> {
        if fuzzy_bytes > key.len() {
            return Err(anyhow::anyhow!("Fuzzy bytes must be less than or equal to key length"));
        }

        let tx_stack = self.tx_stack.read().await;
        let empty_map = BTreeMap::new();
        let transactions = self.transactions.read().await;

        let cache_map = if let Some(tx_map) = tx_stack.last().and_then(|tx_id| transactions.get(tx_id)) {
            tx_map
        } else {
            &empty_map
        };

        let cache_candidate = self.get_leq_from_cache(key, fuzzy_bytes, cache_map);
        let store_candidate = self.store.get_leq_kv(key, fuzzy_bytes).await?;

        match (cache_candidate, store_candidate) {
            (None, None) => Ok(None),
            (Some(c), None) => Ok(Some(c)),
            (None, Some(s)) => {
                if cache_map.get(&s.key).map_or(false, |v| matches!(v, CacheValueType::Removed)) {
                    Ok(None)
                } else {
                    Ok(Some(s))
                }
            }
            (Some(c), Some(s)) => {
                if cache_map.get(&s.key).map_or(false, |v| matches!(v, CacheValueType::Removed)) {
                    Ok(Some(c))
                } else {
                    Ok(Some(if c.key >= s.key { c } else { s }))
                }
            }
        }
    }

    async fn get_many_leq(&self, keys: &[Vec<u8>], fuzzy_bytes: usize) -> Result<Vec<Option<Vec<u8>>>> {
        let mut results = Vec::with_capacity(keys.len());
        for key in keys {
            results.push(<Self as KVQBinaryStoreAsync>::get_leq(self, key, fuzzy_bytes).await?);
        }
        Ok(results)
    }

    async fn get_many_leq_kv(&self, keys: &[Vec<u8>], fuzzy_bytes: usize) -> Result<Vec<Option<KVQPair<Vec<u8>, Vec<u8>>>>> {
        let mut results = Vec::with_capacity(keys.len());
        for key in keys {
            results.push(<Self as KVQBinaryStoreAsync>::get_leq_kv(self, key, fuzzy_bytes).await?);
        }
        Ok(results)
    }

    async fn set(&self, key: Vec<u8>, value: Vec<u8>) -> Result<()> {
        let tx_stack = self.tx_stack.read().await;
        let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let mut transactions = self.transactions.write().await;
        let tx_map = transactions.get_mut(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;
        tx_map.insert(key, CacheValueType::Bytes(value));
        Ok(())
    }

    async fn set_ref(&self, key: &Vec<u8>, value: &Vec<u8>) -> Result<()> {
        let tx_stack = self.tx_stack.read().await;
        let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let mut transactions = self.transactions.write().await;
        let tx_map = transactions.get_mut(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;
        tx_map.insert(key.clone(), CacheValueType::Bytes(value.clone()));
        Ok(())
    }

    async fn set_many_ref<'a>(&self, items: &[KVQPair<&'a Vec<u8>, &'a Vec<u8>>]) -> Result<()> {
        let tx_stack = self.tx_stack.read().await;
        let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let mut transactions = self.transactions.write().await;
        let tx_map = transactions.get_mut(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;
        for item in items {
            tx_map.insert(item.key.clone(), CacheValueType::Bytes(item.value.clone()));
        }
        Ok(())
    }

    async fn set_many_vec(&self, items: Vec<KVQPair<Vec<u8>, Vec<u8>>>) -> Result<()> {
        let tx_stack = self.tx_stack.read().await;
        let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let mut transactions = self.transactions.write().await;
        let tx_map = transactions.get_mut(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;
        for item in items {
            tx_map.insert(item.key, CacheValueType::Bytes(item.value));
        }
        Ok(())
    }

    async fn delete(&self, key: &Vec<u8>) -> Result<bool> {
        let tx_stack = self.tx_stack.read().await;
        let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
        let mut transactions = self.transactions.write().await;
        let tx_map = transactions.get_mut(tx_id).ok_or_else(|| anyhow::anyhow!("Transaction not found"))?;

        let exists = if tx_map.contains_key(key) {
            matches!(tx_map.get(key), Some(CacheValueType::Bytes(_)))
        } else {
            self.store.get_exact_if_exists(key).await?.is_some()
        };

        tx_map.insert(key.clone(), CacheValueType::Removed);
        Ok(exists)
    }

    async fn delete_many(&self, keys: &[Vec<u8>]) -> Result<Vec<bool>> {
        let mut results = Vec::with_capacity(keys.len());
        for key in keys {
            results.push(<Self as KVQBinaryStoreAsync>::delete(self, key).await?);
        }
        Ok(results)
    }

    async fn set_many_split_ref(&self, keys: &[Vec<u8>], values: &[Vec<u8>]) -> Result<()> {
        if keys.len() != values.len() {
            anyhow::bail!("Keys and values must have the same length");
        } else {
            let tx_stack = self.tx_stack.read().await;
            let tx_id = tx_stack.last().ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
            let mut transactions = self.transactions.write().await;
            let tx_map = transactions.get_mut(&tx_id).ok_or_else(|| anyhow::anyhow!("No active transaction"))?;
            for i in 0..keys.len() {
                tx_map.insert(keys[i].clone(), CacheValueType::Bytes(values[i].clone()));
            }
            Ok(())
        }
    }
}

