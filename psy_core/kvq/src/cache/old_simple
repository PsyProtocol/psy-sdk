    }

    fn delete_many(&self, keys: &[Vec<u8>]) -> Result<Vec<bool>> {
        tokio::task::block_in_place(|| {
            tokio::runtime::Handle::current().block_on(async { <Self as KVQBinaryStoreAsync>::delete_many(self, keys).await })
