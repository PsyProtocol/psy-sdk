    #[tokio::test]
    async fn test_concurrency() {
        use std::sync::Arc;

        use tokio::task;

        let backing = Arc::new(KVQSimpleMemoryBackingStore::new());
        let cache = Arc::new(KVQSimpleCachedStore::new(backing.clone()));

        let mut handles = Vec::new();

        for i in 0..10 {
            let cache_clone = cache.clone();
            let handle = task::spawn(async move {
                let _tx_id = <KVQSimpleCachedStore<_> as KVQBinaryStoreCachedAsync>::begin_transaction(&*cache_clone).await;
                let key = vec![i];
                let value = vec![i * 10];
                <KVQSimpleCachedStore<_> as KVQBinaryStoreAsync>::set_ref(&*cache_clone, &key, &value)
                    .await
                    .unwrap();

                let result = <KVQSimpleCachedStore<_> as KVQBinaryStoreAsync>::get_exact(&*cache_clone, &key)
                    .await
                    .unwrap();
                assert_eq!(result, value);

                <KVQSimpleCachedStore<_> as KVQBinaryStoreCachedAsync>::commit(&*cache_clone)
                    .await
                    .unwrap();
            });
            handles.push(handle);
        }

        for handle in handles {
            handle.await.unwrap();
        }
    }
