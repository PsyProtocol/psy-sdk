#[cfg(test)]
mod tests {
    use std::sync::Arc;

    use super::*;
    use crate::{
        memory::simple::KVQSimpleMemoryBackingStore,
        traits::{KVQBinaryStore, KVQBinaryStoreAsync},
    };

    #[tokio::test]
    async fn test_basic_operations() {
        let backing = Arc::new(KVQSimpleMemoryBackingStore::new());
        let cache = KVQSimpleCachedStore::new(backing.clone());
        cache.begin_transaction().await;

        <KVQSimpleCachedStore<_> as KVQBinaryStoreAsync>::set_ref(&cache, &vec![1], &vec![10])
            .await
            .unwrap();
        assert_eq!(
            <KVQSimpleCachedStore<_> as KVQBinaryStoreAsync>::get_exact(&cache, &vec![1])
                .await
                .unwrap(),
            vec![10]
