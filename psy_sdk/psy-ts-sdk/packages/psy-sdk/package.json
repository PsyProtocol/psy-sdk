{
  "name": "@psy/psy-sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "node src/local-web-prover/build-wasm-binary.js",
    "build": "pnpm run clean && pnpm run build:wasm && pnpm run compile",
    "clean": "rimraf ./dist",
    "compile": "tsc -p tsconfig.build.json && cpx 'src/local-prover/psy_prover_bg.*' dist/local-prover",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 100",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "type-check": "tsc --noEmit",
    "bind": "npx barrelsby -c .barrelsby.json",
    "prepublishOnly": "pnpm run build",
    "test:integration": "jest --testNamePattern=\"Integration\"",
    "test:unit": "jest --testNamePattern=\"(?!Integration)\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "30.0.0-beta.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "barrelsby": "^2.8.1",
    "cpx": "^1.5.0",
    "eslint": "^8.44.0",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "rimraf": "~5.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "~4.9.0"
  },
  "dependencies": {
    "doge-sdk": "^0.4.1",
    "lossless-json": "^4.0.1",
    "poseidon-goldilocks-lite": "^0.2.3"
  }
}
