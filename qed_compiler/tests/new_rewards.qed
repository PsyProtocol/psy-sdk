    pub fn advance_and_claim_guta_proof(
        claim_checkpoint_id: Felt,
        reward_commitment_preimage: PMRewardCommitmentPreimage,
        proof: VariableHeightRewardMerkleProof,
        proposed_reward: Felt
    ) {

        Self::advance_to_checkpoint(claim_checkpoint_id);


        Self::claim_guta_proof(claim_checkpoint_id, reward_commitment_preimage, proof, proposed_reward);
    }

    pub fn advance_to_checkpoint_and_seal(new_claim_checkpoint_id: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        assert(new_claim_checkpoint_id > persistant_state.min_allowed_claimed_checkpoint, "checkpoint must be greater");

        clear_entire_tree(32);

        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: new_claim_checkpoint_id,
            last_claimed_ups_checkpoint_id: get_checkpoint_id(),
            claimed_rewards: 0,
            sealed_for_ups_checkpoint_id: get_checkpoint_id(),
        });
    }

    pub fn claim_simple_reward(claim_checkpoint_id: Felt, proposed_reward: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_checkpoint = get_checkpoint_id();
        let claim_rewards_cooldown = 16;


        assert(current_checkpoint > claim_checkpoint_id + claim_rewards_cooldown, "cooldown not satisfied");

        let persistant_state = c.persistant_state.get();


        assert(persistant_state.min_allowed_claimed_checkpoint == claim_checkpoint_id, "invalid claim checkpoint");

        let old_claimed_rewards = if persistant_state.last_claimed_ups_checkpoint_id == current_checkpoint {
            persistant_state.claimed_rewards
        } else {
            0
        };


        assert(proposed_reward > 0 && proposed_reward <= 1000000000, "invalid reward amount");


        c.persistant_state.set(new PersistantState {
            min_allowed_claimed_checkpoint: persistant_state.min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: old_claimed_rewards + proposed_reward,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }
}

fn main() {
    let c = ContractRef::new(ContractMetadata::current());
    let initial_state = new PersistantState {
        min_allowed_claimed_checkpoint: 0,
        last_claimed_ups_checkpoint_id: 0,
        claimed_rewards: 0,
        sealed_for_ups_checkpoint_id: 0,
    };
    c.persistant_state.set(initial_state);
}
