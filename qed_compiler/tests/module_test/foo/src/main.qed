use bar::test_fn;
fn add(a: Felt, b: Felt) -> Felt{
    let c: Felt = a + b;
    return c;
}
fn sub(a: Felt, b: Felt) -> Felt{
    let c: Felt = a - b;
    return c;
}
fn mul(a: Felt, b: Felt) -> Felt{
    let c: Felt = a * b;
    return c;
}
fn div(a: Felt, b: Felt) -> Felt{
    let c: Felt = a / b;
    return c;
}
fn main(a: Felt, b: Felt) -> Felt{
    let c: Felt = test_fn(a, b);

    let add_result: Felt = add(a, b);
    let sub_result: Felt = sub(a, b);
    let mul_result: Felt = mul(a, b);
    let div_result: Felt = div(a, b);

    return c;
}
