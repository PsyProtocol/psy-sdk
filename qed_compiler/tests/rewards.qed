#[derive(Storage, StorageRef)]
struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Storage, StorageRef)]
struct Nullifier {
    pub used: bool,
}

#[contract]
#[derive(Storage, StorageRef)]
struct Contract {
    pub balance: Felt,
    pub other_user_info: [OtherUserInfo; 1073741824],
    pub nullifiers: [[Nullifier; 1073741824]; 65536],
}

impl ContractRef {
    pub fn claim_register_users_job_reward(
        checkpoint_id: Felt,
        job_id: Felt,
        proof_value: Hash,
        proof_siblings: [Hash; 32],
        sibling_is_left: [bool; 32],
        sibling_count: Felt,
        proof_root: Hash,
        reward_amount: Felt
    ) {
        let c = ContractRef::new(ContractMetadata::current());
        let user_id = get_user_id();
        
        assert(checkpoint_id < 65536, "checkpoint_id out of bounds");
        assert(user_id < 1073741824, "user_id out of bounds");
        
        let nullifier_ref = c.nullifiers.index(checkpoint_id).index(user_id);
        let nullifier = nullifier_ref.get();
        assert(!nullifier.used, "reward already claimed for this checkpoint");
        
        let expected_root = get_register_users_root(checkpoint_id);
        assert(proof_root == expected_root, "invalid proof root");
        
        let mut current_hash = proof_value;
        let mut i = 0;
        while i < sibling_count {
            let sibling = proof_siblings[i];
            if sibling_is_left[i] {
                current_hash = hash_two(sibling, current_hash);
            } else {
                current_hash = hash_two(current_hash, sibling);
            };
            i += 1;
        }
        
        assert(current_hash == proof_root, "invalid proof");
        
        let worker_public_key = hash_to_felt(proof_value);
        let user_public_key = get_user_public_key(user_id);
        assert(worker_public_key == user_public_key, "proof value does not match user public key");
        
        nullifier_ref.set(new Nullifier { used: true });
        
        c.balance.set(c.balance.get() + reward_amount);
    }
    
