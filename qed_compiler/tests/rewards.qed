#[derive(Storage, StorageRef)]
struct JobProofSibling {
    pub sibling_hash: [Felt; 4],
    pub is_left: Felt,
}

#[derive(Storage, StorageRef)]
struct JobProof {
    pub value: [Felt; 4],
    pub siblings: [JobProofSibling; 32],
    pub root: [Felt; 4],
}

#[derive(Storage, StorageRef)]
struct JobClaim {
    pub job_type: Felt,
    pub proof: JobProof,
    pub reward: Felt,
}

#[derive(Storage, StorageRef)]
struct OtherUserInfo {
    pub amount_sent: Felt,
    pub amount_claimed: Felt,
}

#[derive(Storage, StorageRef)]
struct Nullifier {
    pub used: Felt,
}

#[contract]
#[derive(Storage, StorageRef)]
struct Contract {
    pub balance: Felt,
    pub other_user_info: [OtherUserInfo; 1073741824],
    pub nullifiers: [Nullifier; 67108864],
}

impl ContractRef {
    pub fn get_nullifier_index(checkpoint_id: Felt, user_id: Felt) -> Felt {
        checkpoint_id * 1024 + (user_id % 1024)
    }

    pub fn verify_proof(proof: JobProof, expected_root: [Felt; 4]) -> bool {
        let mut current = proof.value;

        for i in 0u32..32u32 {
            let idx = i as Felt;
            let sibling = proof.siblings[idx];
            // Check if hash is non-zero (process only non-zero siblings)
            let is_nonzero = (sibling.sibling_hash[0] != 0 || sibling.sibling_hash[1] != 0 ||
                             sibling.sibling_hash[2] != 0 || sibling.sibling_hash[3] != 0);

            if is_nonzero {
                if sibling.is_left == 1 {
                    let combined = hash_two_to_one(sibling.sibling_hash, current);
                    current[0] = combined[0];
                    current[1] = combined[1];
                    current[2] = combined[2];
                    current[3] = combined[3];
                } else {
                    let combined = hash_two_to_one(current, sibling.sibling_hash);
                    current[0] = combined[0];
                    current[1] = combined[1];
                    current[2] = combined[2];
                    current[3] = combined[3];
                };
            };
        }

        let root_matches = current[0] == proof.root[0] && current[1] == proof.root[1] &&
                          current[2] == proof.root[2] && current[3] == proof.root[3];
        let expected_matches = proof.root[0] == expected_root[0] && proof.root[1] == expected_root[1] &&
                               proof.root[2] == expected_root[2] && proof.root[3] == expected_root[3];

        root_matches && expected_matches
    }

    pub fn get_expected_root(checkpoint_id: Felt, job_type: Felt) -> [Felt; 4] {
        if job_type == 0 {
            get_register_users_root(checkpoint_id)
        } else if job_type == 1 {
            get_gutas_root(checkpoint_id)
        } else if job_type == 2 {
            get_deploy_contracts_root(checkpoint_id)
        } else {
            // Return zero root for invalid job types
            [0, 0, 0, 0]
        }
    }

    pub fn claim_batch_job_rewards(
        checkpoint_id: Felt,
        claims: [JobClaim; 32]
    ) {
        let c = ContractRef::new(ContractMetadata::current());
        let user_id = get_user_id();

        assert(checkpoint_id < 65536, "checkpoint_id out of bounds");
        assert(user_id < 1073741824, "user_id out of bounds");

        let nullifier_idx = Self::get_nullifier_index(checkpoint_id, user_id);
        let nullifier_ref = c.nullifiers.index(nullifier_idx);
        assert(nullifier_ref.get().used == 0, "already claimed");

        let mut total_reward = 0;

        for i in 0u32..32u32 {
            let idx = i as Felt;
            let claim = claims[idx];

            if claim.reward > 0 {
                let expected_root = Self::get_expected_root(checkpoint_id, claim.job_type);
                assert(Self::verify_proof(claim.proof, expected_root), "invalid proof");
                let user_key = get_user_public_key_hash();
                assert(claim.proof.value[0] == user_key[0] &&
                       claim.proof.value[1] == user_key[1] &&
                       claim.proof.value[2] == user_key[2] &&
                       claim.proof.value[3] == user_key[3], "wrong public key");
                total_reward = total_reward + claim.reward;
            };
        }

        assert(total_reward > 0, "no valid claims");
        nullifier_ref.set(new Nullifier { used: 1 });
        c.balance.set(c.balance.get() + total_reward);
    }


    pub fn simple_transfer(recipient: Felt, amount: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");

        let mut recipient_info = c.other_user_info.index(recipient).get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

        c.other_user_info.index(recipient).set(new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed
        });

        c.balance.set(current_balance - amount);
    }

    pub fn simple_claim(sender: Felt) {
        let self_user_id = get_user_id();
        assert(sender != self_user_id, "you cannot claim from your self");

        let c = ContractRef::new(ContractMetadata::current());

        let sender_user_contract = ContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_other_user_info = sender_user_contract.other_user_info.index(self_user_id).get();
        let sender_total_sent = sender_other_user_info.amount_sent;

        let mut sender_info = c.other_user_info.index(sender).get();
        assert(sender_info.amount_claimed < sender_total_sent, "no tokens to claim from this sender");
        let claimed = sender_total_sent - sender_info.amount_claimed;

        c.other_user_info.index(sender).set(new OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent
        });

        c.balance.set(c.balance.get() + claimed);
    }

    pub fn get_balance() -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        c.balance.get()
    }
}

fn main() {
    let user_id = get_user_id();
    assert(user_id == 42, "user_id should be 42");
}
