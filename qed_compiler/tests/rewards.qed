    pub fn claim_deploy_contracts_job_reward(
        checkpoint_id: Felt,
        job_id: Felt,
        proof_value: Hash,
        proof_siblings: [Hash; 32],
        sibling_is_left: [bool; 32],
        sibling_count: Felt,
        proof_root: Hash,
        reward_amount: Felt
    ) {
        let c = ContractRef::new(ContractMetadata::current());
        let user_id = get_user_id();
        
        assert(checkpoint_id < 65536, "checkpoint_id out of bounds");
        assert(user_id < 1073741824, "user_id out of bounds");
        
        let nullifier_ref = c.nullifiers.index(checkpoint_id).index(user_id);
        let nullifier = nullifier_ref.get();
        assert(!nullifier.used, "reward already claimed for this checkpoint");
        
        let expected_root = get_deploy_contracts_root(checkpoint_id);
        assert(proof_root == expected_root, "invalid proof root");
        
        let mut current_hash = proof_value;
        let mut i = 0;
        while i < sibling_count {
            let sibling = proof_siblings[i];
            if sibling_is_left[i] {
                current_hash = hash_two(sibling, current_hash);
            } else {
                current_hash = hash_two(current_hash, sibling);
            };
            i += 1;
        }
        
        assert(current_hash == proof_root, "invalid proof");
        
        let worker_public_key = hash_to_felt(proof_value);
        let user_public_key = get_user_public_key(user_id);
        assert(worker_public_key == user_public_key, "proof value does not match user public key");
        
        nullifier_ref.set(new Nullifier { used: true });
        
        c.balance.set(c.balance.get() + reward_amount);
    }
    
    pub fn simple_transfer(recipient: Felt, amount: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance");

        let mut recipient_info = c.other_user_info.index(recipient).get();
        assert(recipient_info.amount_sent + amount > recipient_info.amount_sent, "amount sent overflow");

        c.other_user_info.index(recipient).set(new OtherUserInfo {
            amount_sent: recipient_info.amount_sent + amount,
            amount_claimed: recipient_info.amount_claimed
        });

        c.balance.set(current_balance - amount);
    }

    pub fn simple_claim(sender: Felt) {
        let self_user_id = get_user_id();
        assert(sender != self_user_id, "you cannot claim from your self");

        let c = ContractRef::new(ContractMetadata::current());

        let sender_user_contract = ContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_total_sent = sender_user_contract.other_user_info.index(self_user_id).get().amount_sent;

        let mut sender_info = c.other_user_info.index(sender).get();
        assert(sender_info.amount_claimed < sender_total_sent, "no tokens to claim from this sender");
        let claimed = sender_total_sent - sender_info.amount_claimed;

        c.other_user_info.index(sender).set(new OtherUserInfo {
            amount_sent: sender_info.amount_sent,
            amount_claimed: sender_total_sent
        });

        c.balance.set(c.balance.get() + claimed);
    }
    
    pub fn get_balance() -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        c.balance.get()
    }
}

fn main() {
    let c = ContractRef::new(ContractMetadata::current());
    
    assert_eq(c.balance.get(), 0, "initial balance should be 0");
    
    let test_checkpoint_id = 1;
    let test_job_id = 123;
    let test_proof_value = hash([1, 2, 3, 4]);
    let test_siblings = [hash([5, 6, 7, 8]); 32];
    let test_sibling_is_left = [true; 32];
    let test_sibling_count = 1;
    let test_proof_root = hash_two(test_siblings[0], test_proof_value);
    let test_reward = 1000;
    
    let test_nullifier_ref = c.nullifiers.index(test_checkpoint_id).index(get_user_id());
    let test_nullifier = test_nullifier_ref.get();
    assert(!test_nullifier.used, "nullifier should not be used initially");
}