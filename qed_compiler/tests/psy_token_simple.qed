#[contract]
#[derive(Storage, StorageRef)]
struct Contract {
    pub balance: Felt,
    pub last_claimed_pow_rewards_checkpoint_id: Felt,
    pub sent_to_other: [Felt; 32],
    pub received_from_others: [Felt; 32],
}

impl ContractRef {
    pub fn get_balance() -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        c.balance.get()
    }
    
    pub fn mint(amount: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        c.balance.set(current_balance + amount);
    }
    
    pub fn burn(amount: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_balance = c.balance.get();
        assert(current_balance >= amount, "insufficient balance for burn");
        c.balance.set(current_balance - amount);
    }
    
    pub fn transfer(recipient: Felt, amount: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let sender_id = get_user_id();
        let current_balance = c.balance.get();
        
        assert(current_balance >= amount, "insufficient balance for transfer");
        assert(recipient != sender_id, "cannot transfer to self");
        assert(recipient < 32, "recipient must be less than 32 for simplified version");
        
        // Update sender's balance
        c.balance.set(current_balance - amount);
        
        // Update sent_to_other tracking
        let current_sent = c.sent_to_other.index(recipient).get();
        c.sent_to_other.index(recipient).set(current_sent + amount);
        
        // Update recipient's received_from_others tracking (in recipient's contract state)
        let recipient_contract = ContractRef::new(ContractMetadata::new(get_contract_id(), recipient));
        let current_received = recipient_contract.received_from_others.index(sender_id).get();
        recipient_contract.received_from_others.index(sender_id).set(current_received + amount);
    }
    
    pub fn claim_from(sender: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let recipient_id = get_user_id();
        
        assert(sender != recipient_id, "cannot claim from self");
        assert(sender < 32, "sender must be less than 32 for simplified version");
        
        // Get amount that sender has sent to us but we haven't claimed yet
        let received_from_sender = c.received_from_others.index(sender).get();
        
        // Get sender's record of what they sent to us
        let sender_contract = ContractRef::new(ContractMetadata::new(get_contract_id(), sender));
        let sender_sent_to_us = sender_contract.sent_to_other.index(recipient_id).get();
        
        assert(sender_sent_to_us > received_from_sender, "no tokens to claim from sender");
        
        let claimable_amount = sender_sent_to_us - received_from_sender;
        
        // Update our balance
        let current_balance = c.balance.get();
        c.balance.set(current_balance + claimable_amount);
        
        // Update received tracking to reflect that we've claimed
        c.received_from_others.index(sender).set(sender_sent_to_us);
    }
    
    pub fn claim_pow_rewards() {
        let c = ContractRef::new(ContractMetadata::current());
        let current_checkpoint = get_checkpoint_id();
        let user_id = get_user_id();
        let psy_mining_rewards_contract_id = 1;
        
        // Get the POW rewards from the mining rewards contract (simplified)
        let mining_contract = ContractRef::new(ContractMetadata::new(psy_mining_rewards_contract_id, user_id));
        
        // Simplified: just add a fixed reward amount for now
        let reward_amount = 100;
        
        // Ensure we haven't already claimed during this checkpoint
        let last_claimed = c.last_claimed_pow_rewards_checkpoint_id.get();
        assert(last_claimed < current_checkpoint, "already claimed for this checkpoint");
        
        // Update our last claimed checkpoint
        c.last_claimed_pow_rewards_checkpoint_id.set(current_checkpoint);
        
        // Add the reward to our balance
        let current_balance = c.balance.get();
        c.balance.set(current_balance + reward_amount);
    }
    
    pub fn get_sent_to(user_id: Felt) -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        assert(user_id < 32, "user_id must be less than 32");
        c.sent_to_other.index(user_id).get()
    }
    
    pub fn get_received_from(user_id: Felt) -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        assert(user_id < 32, "user_id must be less than 32");
        c.received_from_others.index(user_id).get()
    }
    
    pub fn get_last_claimed_checkpoint() -> Felt {
        let c = ContractRef::new(ContractMetadata::current());
        c.last_claimed_pow_rewards_checkpoint_id.get()
    }
}

fn main() {
    // Test initialization
    let c = ContractRef::new(ContractMetadata::current());
    c.balance.set(0);
    c.last_claimed_pow_rewards_checkpoint_id.set(0);
    
    // Test basic functionality
    ContractRef::mint(1000);
    assert_eq(ContractRef::get_balance(), 1000, "balance should be 1000");
    
    ContractRef::burn(500);  
    assert_eq(ContractRef::get_balance(), 500, "balance should be 500 after burn");
}