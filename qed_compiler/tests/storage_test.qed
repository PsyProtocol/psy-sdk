    mod math {
        use std::prelude::*;
        pub fn max(a: Felt, b: Felt) -> Felt {
            return a * ((a > b) as Felt) + b * ((a <= b) as Felt);
        }
        pub fn min(a: Felt, b: Felt) -> Felt {
            return a * ((a < b) as Felt) + b * ((a >= b) as Felt);
        }
    }
    use math::*;
    struct Person {
        pub age: Felt,
        pub height: Felt,
        pub year_of_birth: Felt,
    }
    impl Storage for Person {
        pub fn size() -> Felt {
            Felt::size() + Felt::size() + Felt::size()
        }
        pub fn read(offset: Felt) -> Self {
            new Person {
                age: Felt::read(offset),
                height: Felt::read(offset + Felt::size()),
                year_of_birth: Felt::read(offset + Felt::size() + Felt::size()),
            }
        }
        pub fn write(offset: Felt, value: Self) {
            Felt::write(offset, value.age);
            Felt::write(offset + Felt::size(), value.height);
            Felt::write(offset + Felt::size() + Felt::size(), value.year_of_birth);
        }
    }
    struct Contract {
        pub a: Felt,
        pub b: Person,
        pub c: Felt,
        pub e: [Felt; 4],
        pub d: Person,
        pub f: [Felt; 4],
    }
    impl Storage for Contract {
        pub fn size() -> Felt {
            Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size() + <[Felt; 4]>::size()
        }
        pub fn read(offset: Felt) -> Self {
            new Contract {
                a: Felt::read(offset),
                b: Person::read(offset + Felt::size()),
                c: Felt::read(offset + Felt::size() + Person::size()),
                e: <[Felt; 4]>::read(offset + Felt::size() + Person::size() + Felt::size()),
                d: Person::read(offset + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size()),
                f: <[Felt; 4]>::read(offset + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size()),
            }
        }
        pub fn write(offset: Felt, value: Self) {
            Felt::write(offset, value.a);
            Person::write(offset + Felt::size(), value.b);
            Felt::write(offset + Felt::size() + Person::size(), value.c);
            <[Felt; 4]>::write(offset + Felt::size() + Person::size() + Felt::size(), value.e);
            Person::write(offset + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size(), value.d);
            <[Felt; 4]>::write(offset + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size(), value.f);
        }
    }
    impl Contract {
        pub fn get_a() -> Felt {
            Felt::read(0)
        }
        pub fn set_a(value: Felt) {
            Felt::write(0, value);
        }
        pub fn get_b() -> Person {
            Person::read(0 + Felt::size())
        }
        pub fn set_b(value: Person) {
            Person::write(0 + Felt::size(), value);
        }
        pub fn get_c() -> Felt {
            Felt::read(0 + Felt::size() + Person::size())
        }
        pub fn set_c(value: Felt) {
            Felt::write(0 + Felt::size() + Person::size(), value);
        }
        pub fn get_e() -> [Felt; 4] {
            <[Felt; 4]>::read(0 + Felt::size() + Person::size() + Felt::size())
        }
        pub fn set_e(value: [Felt; 4]) {
            <[Felt; 4]>::write(0 + Felt::size() + Person::size() + Felt::size(), value);
        }
        pub fn get_e_at(index: Felt) -> Felt {
            <[Felt; 4]>::read_at(0 + Felt::size() + Person::size() + Felt::size(), index)
        }
        pub fn set_e_at(index: Felt, value: Felt) {
            <[Felt; 4]>::write_at(0 + Felt::size() + Person::size() + Felt::size(), index, value);
        }
        pub fn get_d() -> Person {
            Person::read(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size())
        }
        pub fn set_d(value: Person) {
            Person::write(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size(), value);
        }
        pub fn get_f() -> [Felt; 4] {
            <[Felt; 4]>::read(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size())
        }
        pub fn set_f(value: [Felt; 4]) {
            <[Felt; 4]>::write(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size(), value);
        }
        pub fn get_f_at(index: Felt) -> Felt {
            <[Felt; 4]>::read_at(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size(), index)
        }
        pub fn set_f_at(index: Felt, value: Felt) {
            <[Felt; 4]>::write_at(0 + Felt::size() + Person::size() + Felt::size() + <[Felt; 4]>::size() + Person::size(), index, value);
        }
    }
    impl Contract {
        pub fn new() -> Self {
            return new Contract {
                a: 0,
                b: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0,
            },
                c: 0,
                d: new Person {
                age: 0,
                height: 0,
                year_of_birth: 0,
            },
                e: [1, 2, 3, 4],
                f: [5, 6, 7, 8],
            };
        }
        pub fn set_abcde(a: Felt, b: Person, c: Felt, d: Person, e: [Felt; 4], f: [Felt; 4]) {
            Contract::set_a(a);
            Contract::set_b(b);
            Contract::set_c(c);
            Contract::set_e(e);
            Contract::set_d(d);
            Contract::set_f(f);
        }
    }
    fn main() -> Felt {
        assert_eq(Felt::size(), 1, "Error: Felt::size() should be 1");
        assert_eq(bool::size(), 1, "Error: bool::size() should be 1");
        assert_eq(Person::size(), 3, "Error: Person::size() should be 3");
        assert_eq(Contract::size(), 16, "Error: Contract::size() should be 16");
        Contract::set_e([4, 3, 2, 1]);
        Contract::set_d(new Person {
            age: 40,
            height: 170,
            year_of_birth: 1980,
        });
        Contract::set_f([8, 7, 6, 5]);
        Contract::set_a(10);
        Contract::set_b(new Person {
            age: 20,
            height: 180,
            year_of_birth: 2000,
        });
        Contract::set_c(30);
        let a: Felt = Contract::get_a();
        assert_eq(a, 10, "Error: a should be 10");
        let b: Person = Contract::get_b();
        assert_eq(b.age, 20, "Error: b.age should be 20");
        assert_eq(b.height, 180, "Error: b.height should be 180");
        assert_eq(b.year_of_birth, 2000, "Error: b.year_of_birth should be 2000");
        let c: Felt = Contract::get_c();
        assert_eq(c, 30, "Error: c should be 30");
        let d: Person = Contract::get_d();
        assert_eq(d.age, 40, "Error: d.age should be 40");
        assert_eq(d.height, 170, "Error: d.height should be 170");
        assert_eq(d.year_of_birth, 1980, "Error: d.age should be 1980");
        let e: [Felt; 4] = Contract::get_e();
        assert_eq(e[0], 4, "Error: e[0] should be 4");
        assert_eq(e[1], 3, "Error: e[1] should be 3");
        assert_eq(e[2], 2, "Error: e[2] should be 2");
        assert_eq(e[3], 1, "Error: e[3] should be 1");
        let f: [Felt; 4] = Contract::get_f();
        assert_eq(f[0], 8, "Error: f[0] should be 8");
        assert_eq(f[1], 7, "Error: f[1] should be 7");
        assert_eq(f[2], 6, "Error: f[2] should be 6");
        assert_eq(f[3], 5, "Error: f[3] should be 5");
        Contract::set_f_at(0, 5);
        Contract::set_f_at(1, 6);
        Contract::set_f_at(2, 7);
        Contract::set_f_at(3, 8);
        assert_eq(Contract::get_f_at(0), 5, "Error: f[0] should be 5");
        assert_eq(Contract::get_f_at(1), 6, "Error: f[1] should be 6");
        assert_eq(Contract::get_f_at(2), 7, "Error: f[2] should be 7");
        assert_eq(Contract::get_f_at(3), 8, "Error: f[3] should be 8");
        assert_eq(<[Felt; 2]>::size(), 2, "Error: [Felt; 2]::size() should be 2");
        return a;
    }
