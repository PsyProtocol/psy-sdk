#[derive(StorageRef, Storage)]
pub struct Person {
    pub age: Felt,
    pub height: Felt,
    pub year_of_birth: Felt,
}

#[contract]
#[derive(StorageRef, Storage)]
pub struct SimpleContract {
    pub a: Felt,
    #[ref]
    pub b: Person,
    pub c: Felt,
    pub d: [Felt; 4],
}

// input:
// output:
fn main() -> Felt {
    let c = <Contract<[Felt; 4]>>::current();
    c.storage.set([1, 2, 3, 4]);
    // c.storage => receiver
    // get => callee
    assert_eq(c.storage.get()[0], 1, "c[0] == 1");
    return c.get_user_id();
}
