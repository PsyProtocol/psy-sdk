// Constants defined in network_constants.rs 
// MAX_TOTAL_USERS, GUTA_REWARDS_TREE_MAX_HEIGHT_MINUS_ONE, 
// CONTRACT_DEPLOYMENT_AGGREGATION_REWARDS_MAX_HEIGHT_MINUS_ONE,
// USER_REGISTRATION_AGGREGATION_REWARDS_MAX_HEIGHT_MINUS_ONE,
// CLAIM_REWARDS_COOLDOWN, etc.

#[derive(Storage, StorageRef)]
struct WeirdMerkleProofSiblingLevel {
    pub sibling_branch: [Felt; 4],
    pub sibling_reward_leaf: [Felt; 4],
}

#[derive(Storage, StorageRef)]
struct VariableHeightRewardMerkleProof {
    pub top_siblings: [WeirdMerkleProofSiblingLevel; 31], // GUTA_REWARDS_TREE_MAX_HEIGHT_MINUS_ONE
    pub left_branch: [Felt; 4],
    pub right_branch: [Felt; 4],
    pub reward_leaf: [Felt; 4],
    pub proof_height: Felt,
    pub index: Felt,
}

#[derive(Storage, StorageRef)]
struct PMRewardCommitmentPreimage {
    pub guta_rewards_tree_root: [Felt; 4],
    pub registered_users_rewards_tree_root: [Felt; 4],
    pub deploy_contracts_rewards_tree_root: [Felt; 4],
}

#[derive(Storage, StorageRef)]
struct PsyPOWMiningRewardsClaimContractPersistantState {
    pub min_allowed_claimed_checkpoint: Felt,
    pub last_claimed_ups_checkpoint_id: Felt,
    pub claimed_rewards: Felt,
    pub sealed_for_ups_checkpoint_id: Felt,
}

#[contract]
#[derive(Storage, StorageRef)]
struct Contract {
    pub persistant_state: PsyPOWMiningRewardsClaimContractPersistantState,
    pub claimed_guta_nullifier_tree: [Felt; 1073741824], // MAX_TOTAL_USERS
    pub claimed_contract_aggregation_nullifier_tree: [Felt; 65536], // MAX_CONTRACTS_DEPLOYED_PER_BLOCK
    pub claimed_user_registration_aggregation_nullifier_tree: [Felt; 65536], // MAX_USERS_REGISTERED_PER_BLOCK
}

impl ContractRef {
    fn check_guta_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let user_transaction_inclusion_fee = 5000000000; // from network constants
        
        // The reward must be less than USER_TRANSACTION_INCLUSION_FEE
        if proposed_reward >= user_transaction_inclusion_fee {
            return false;
        };
        
        // Ensure that if every miner used the proposed reward, we wouldn't exceed total fees paid
        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        if total_reward_if_all_claim >= total_fees_paid {
            return false;
        };
        
        true
    }
    
    fn check_user_registration_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let register_user_fee = 0; // from network constants
        
        if proposed_reward >= register_user_fee {
            return false;
        };
        
        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        if total_reward_if_all_claim >= total_fees_paid {
            return false;
        };
        
        true
    }
    
    fn check_deploy_contract_reward(total_proofs_in_checkpoint: Felt, total_fees_paid: Felt, proposed_reward: Felt) -> bool {
        let deploy_contract_fee = 0; // from network constants
        
        if proposed_reward >= deploy_contract_fee {
            return false;
        };
        
        let total_reward_if_all_claim = proposed_reward * total_proofs_in_checkpoint;
        if total_reward_if_all_claim >= total_fees_paid {
            return false;
        };
        
        true
    }
    
    fn compute_combined_pm_commitment_hash(preimage: PMRewardCommitmentPreimage) -> [Felt; 4] {
        let intermediate_hash = hash_two_to_one(preimage.guta_rewards_tree_root, preimage.registered_users_rewards_tree_root);
        hash_two_to_one(intermediate_hash, preimage.deploy_contracts_rewards_tree_root)
    }
    
    fn compute_root_and_nullifier_index(proof: VariableHeightRewardMerkleProof) -> ([Felt; 4], Felt) {
        let proof_height = proof.proof_height;
        let index = proof.index;
        let max_height_minus_one = 31; // GUTA_REWARDS_TREE_MAX_HEIGHT_MINUS_ONE
        
        // Sanity check: ensure the proof height is valid
        assert(proof_height <= max_height_minus_one, "proof height too large");
        
        let mut nullifier_base = 0;
        let mut nullifier_level_start_index_multiplier = 1;
        
        let mut current_node_value = hash_two_to_one(hash_two_to_one(proof.left_branch, proof.right_branch), proof.reward_leaf);
        
        for i in 0u32..31u32 { // MAX_HEIGHT_MINUS_ONE iterations
            let idx = i as Felt;
            let sibling_node = proof.top_siblings[idx].sibling_branch;
            let reward_leaf = proof.top_siblings[idx].sibling_reward_leaf;
            
            if i < proof_height {
                // Get bit at position i of index
                let bit_mask = 1 << i;
                let index_bit = if (index & bit_mask) != 0 { 1 } else { 0 };
                
                let branch_path_hash = if index_bit == 0 {
                    hash_two_to_one(current_node_value, sibling_node)
                } else {
                    hash_two_to_one(sibling_node, current_node_value)
                };
                current_node_value = hash_two_to_one(branch_path_hash, reward_leaf);
                
                nullifier_base = nullifier_base + nullifier_level_start_index_multiplier;
                nullifier_level_start_index_multiplier = nullifier_level_start_index_multiplier * 2;
            } else {
                // If height is less than max height, ensure other sibling data is zero
                assert(reward_leaf[0] == 0 && reward_leaf[1] == 0 && reward_leaf[2] == 0 && reward_leaf[3] == 0, "reward leaf should be zero");
                assert(sibling_node[0] == 0 && sibling_node[1] == 0 && sibling_node[2] == 0 && sibling_node[3] == 0, "sibling node should be zero");
                
                let bit_mask = 1 << i;
                let index_bit = if (index & bit_mask) != 0 { 1 } else { 0 };
                assert(index_bit == 0, "index bit should be zero for unused height");
            };
        }
        
        let nullifier_final_index = nullifier_base + index;
        (current_node_value, nullifier_final_index)
    }
    
    pub fn clear_entire_tree() {
        __clear_entire_tree(16); // contract_state_height = 16 for user contracts
    }
    
    fn clear_tree_except_first_leaf_move_to_new_checkpoint(new_min_allowed_claimed_checkpoint: Felt, seal: bool) {
        let c = ContractRef::new(ContractMetadata::current());
        let first_leaf = c.persistant_state.get();
        let current_checkpoint = get_checkpoint_id();
        
        // Ensure we are moving forward to avoid double claims
        assert(new_min_allowed_claimed_checkpoint > first_leaf.min_allowed_claimed_checkpoint, "checkpoint must be greater");
        
        // Ensure the cooldown is respected 
        let claim_rewards_cooldown = 16; // CLAIM_REWARDS_COOLDOWN
        assert(new_min_allowed_claimed_checkpoint + claim_rewards_cooldown < current_checkpoint, "cooldown not satisfied");
        
        Self::clear_entire_tree();
        
        let new_claimed_rewards = if first_leaf.min_allowed_claimed_checkpoint == current_checkpoint {
            first_leaf.claimed_rewards
        } else {
            // Reset claimed rewards if we are on a new user proving session
            0
        };
        
        let new_sealed_checkpoint = if seal {
            current_checkpoint
        } else {
            first_leaf.sealed_for_ups_checkpoint_id
        };
        
        c.persistant_state.set(new PsyPOWMiningRewardsClaimContractPersistantState {
            min_allowed_claimed_checkpoint: new_min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: new_claimed_rewards,
            sealed_for_ups_checkpoint_id: new_sealed_checkpoint,
        });
    }
    
    pub fn advance_to_checkpoint(new_claim_checkpoint_id: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        assert(new_claim_checkpoint_id > persistant_state.min_allowed_claimed_checkpoint, "checkpoint must be greater");
        Self::clear_tree_except_first_leaf_move_to_new_checkpoint(new_claim_checkpoint_id, false);
    }
    
    pub fn advance_to_checkpoint_and_seal(new_claim_checkpoint_id: Felt) {
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        assert(new_claim_checkpoint_id > persistant_state.min_allowed_claimed_checkpoint, "checkpoint must be greater");
        Self::clear_tree_except_first_leaf_move_to_new_checkpoint(new_claim_checkpoint_id, true);
    }
    
    pub fn claim_guta_proof(
        claim_checkpoint_id: Felt, 
        reward_commitment_preimage: PMRewardCommitmentPreimage, 
        proof: VariableHeightRewardMerkleProof, 
        proposed_reward: Felt
    ) {
        let c = ContractRef::new(ContractMetadata::current());
        let current_checkpoint = get_checkpoint_id();
        let claim_rewards_cooldown = 16; // CLAIM_REWARDS_COOLDOWN
        
        // Sanity check + ensure that the cooldown is enforced
        assert(current_checkpoint > claim_checkpoint_id + claim_rewards_cooldown, "cooldown not satisfied");
        
        let persistant_state = c.persistant_state.get();
        
        // Ensure no rewards can be claimed once the checkpoint is sealed
        assert(current_checkpoint > persistant_state.sealed_for_ups_checkpoint_id, "checkpoint is sealed");
        
        // Ensure the user is not double-claiming rewards from past checkpoints
        assert(persistant_state.min_allowed_claimed_checkpoint == claim_checkpoint_id, "invalid claim checkpoint");
        
        // Ensure the commitment in the checkpoint leaf matches our preimage
        let expected_pm_commitment = Self::compute_combined_pm_commitment_hash(reward_commitment_preimage);
        let old_checkpoint_leaf = __get_checkpoint_leaf_with_stats_at_checkpoint(claim_checkpoint_id);
        assert(expected_pm_commitment[0] == old_checkpoint_leaf.pm_rewards_commitment[0] &&
               expected_pm_commitment[1] == old_checkpoint_leaf.pm_rewards_commitment[1] &&
               expected_pm_commitment[2] == old_checkpoint_leaf.pm_rewards_commitment[2] &&
               expected_pm_commitment[3] == old_checkpoint_leaf.pm_rewards_commitment[3], "pm commitment mismatch");
        
        // Compute the guta reward tree root from the proof and the nullifier index
        let (guta_reward_tree_root, nullifier_index) = Self::compute_root_and_nullifier_index(proof);
        
        // Ensure the computed guta reward tree root matches the root from checkpoint leaf
        assert(guta_reward_tree_root[0] == reward_commitment_preimage.guta_rewards_tree_root[0] &&
               guta_reward_tree_root[1] == reward_commitment_preimage.guta_rewards_tree_root[1] &&
               guta_reward_tree_root[2] == reward_commitment_preimage.guta_rewards_tree_root[2] &&
               guta_reward_tree_root[3] == reward_commitment_preimage.guta_rewards_tree_root[3], "guta root mismatch");
        
        // Ensure that the reward leaf is for the current user
        let current_user_id = get_user_id();
        assert(proof.reward_leaf[0] == current_user_id, "reward leaf not for current user");
        assert(proof.reward_leaf[1] == 0, "reward leaf element 1 should be zero");
        assert(proof.reward_leaf[2] == 0, "reward leaf element 2 should be zero");
        assert(proof.reward_leaf[3] == 0, "reward leaf element 3 should be zero");
        
        // Ensure that the nullifier index has not been claimed by the user
        assert(c.claimed_guta_nullifier_tree.index(nullifier_index).get() == 0, "nullifier already claimed");
        
        let old_claimed_rewards = if persistant_state.last_claimed_ups_checkpoint_id == current_checkpoint {
            persistant_state.claimed_rewards
        } else {
            0
        };
        
        // Validate the proposed reward
        let pm_jobs_completed = __get_register_users_completed(claim_checkpoint_id) + 
                               __get_gutas_completed(claim_checkpoint_id) + 
                               __get_deploy_contracts_completed(claim_checkpoint_id);
        let fees_collected = __get_fees_collected(claim_checkpoint_id);
        assert(Self::check_guta_reward(pm_jobs_completed, fees_collected, proposed_reward), "invalid reward amount");
        
        // Mark nullifier as claimed
        c.claimed_guta_nullifier_tree.index(nullifier_index).set(1);
        
        // Update the persistant state
        c.persistant_state.set(new PsyPOWMiningRewardsClaimContractPersistantState {
            min_allowed_claimed_checkpoint: persistant_state.min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: old_claimed_rewards + proposed_reward,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }
    
    pub fn advance_and_claim_guta_proof(
        claim_checkpoint_id: Felt, 
        reward_commitment_preimage: PMRewardCommitmentPreimage, 
        proof: VariableHeightRewardMerkleProof, 
        proposed_reward: Felt
    ) {
        let current_checkpoint = get_checkpoint_id();
        let claim_rewards_cooldown = 16; // CLAIM_REWARDS_COOLDOWN
        
        // Sanity check + ensure that the cooldown is enforced
        assert(current_checkpoint > claim_checkpoint_id + claim_rewards_cooldown, "cooldown not satisfied");
        
        Self::clear_tree_except_first_leaf_move_to_new_checkpoint(claim_checkpoint_id, false);
        
        let c = ContractRef::new(ContractMetadata::current());
        let persistant_state = c.persistant_state.get();
        
        // Ensure no rewards can be claimed once the checkpoint is sealed
        assert(current_checkpoint > persistant_state.sealed_for_ups_checkpoint_id, "checkpoint is sealed");
        
        // Ensure the user is not double-claiming rewards from past checkpoints
        assert(persistant_state.min_allowed_claimed_checkpoint == claim_checkpoint_id, "invalid claim checkpoint");
        
        // Ensure the commitment in the checkpoint leaf matches our preimage
        let expected_pm_commitment = Self::compute_combined_pm_commitment_hash(reward_commitment_preimage);
        let old_checkpoint_leaf = __get_checkpoint_leaf_with_stats_at_checkpoint(claim_checkpoint_id);
        assert(expected_pm_commitment[0] == old_checkpoint_leaf.pm_rewards_commitment[0] &&
               expected_pm_commitment[1] == old_checkpoint_leaf.pm_rewards_commitment[1] &&
               expected_pm_commitment[2] == old_checkpoint_leaf.pm_rewards_commitment[2] &&
               expected_pm_commitment[3] == old_checkpoint_leaf.pm_rewards_commitment[3], "pm commitment mismatch");
        
        // Compute the guta reward tree root from the proof and the nullifier index
        let (guta_reward_tree_root, nullifier_index) = Self::compute_root_and_nullifier_index(proof);
        
        // Ensure the computed guta reward tree root matches the root from checkpoint leaf
        assert(guta_reward_tree_root[0] == reward_commitment_preimage.guta_rewards_tree_root[0] &&
               guta_reward_tree_root[1] == reward_commitment_preimage.guta_rewards_tree_root[1] &&
               guta_reward_tree_root[2] == reward_commitment_preimage.guta_rewards_tree_root[2] &&
               guta_reward_tree_root[3] == reward_commitment_preimage.guta_rewards_tree_root[3], "guta root mismatch");
        
        // Ensure that the reward leaf is for the current user
        let current_user_id = get_user_id();
        assert(proof.reward_leaf[0] == current_user_id, "reward leaf not for current user");
        assert(proof.reward_leaf[1] == 0, "reward leaf element 1 should be zero");
        assert(proof.reward_leaf[2] == 0, "reward leaf element 2 should be zero");
        assert(proof.reward_leaf[3] == 0, "reward leaf element 3 should be zero");
        
        // Ensure that the nullifier index has not been claimed by the user
        assert(c.claimed_guta_nullifier_tree.index(nullifier_index).get() == 0, "nullifier already claimed");
        
        let old_claimed_rewards = if persistant_state.last_claimed_ups_checkpoint_id == current_checkpoint {
            persistant_state.claimed_rewards
        } else {
            0
        };
        
        // Validate the proposed reward
        let pm_jobs_completed = __get_register_users_completed(claim_checkpoint_id) + 
                               __get_gutas_completed(claim_checkpoint_id) + 
                               __get_deploy_contracts_completed(claim_checkpoint_id);
        let fees_collected = __get_fees_collected(claim_checkpoint_id);
        assert(Self::check_guta_reward(pm_jobs_completed, fees_collected, proposed_reward), "invalid reward amount");
        
        // Mark nullifier as claimed
        c.claimed_guta_nullifier_tree.index(nullifier_index).set(1);
        
        // Update the persistant state
        c.persistant_state.set(new PsyPOWMiningRewardsClaimContractPersistantState {
            min_allowed_claimed_checkpoint: persistant_state.min_allowed_claimed_checkpoint,
            last_claimed_ups_checkpoint_id: current_checkpoint,
            claimed_rewards: old_claimed_rewards + proposed_reward,
            sealed_for_ups_checkpoint_id: persistant_state.sealed_for_ups_checkpoint_id,
        });
    }
}

fn main() {
    // Test initialization
    let c = PsyPOWMiningRewardsClaimContractRef::new(ContractMetadata::current());
    let initial_state = new PsyPOWMiningRewardsClaimContractPersistantState {
        min_allowed_claimed_checkpoint: 0,
        last_claimed_ups_checkpoint_id: 0,
        claimed_rewards: 0,
        sealed_for_ups_checkpoint_id: 0,
    };
    c.persistant_state.set(initial_state);
}