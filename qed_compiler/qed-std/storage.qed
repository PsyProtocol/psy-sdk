mod primitive;
mod mem;

use primitive::*;

pub trait Storage {
    pub fn size() -> Felt;
    pub fn read(offset: Felt) -> Self;
    pub fn write(offset: Felt, value: Self);
}

pub trait StorageAt<T: Storage, N: u32> {
    pub fn read_at(offset: Felt, index: Felt) -> T;
    pub fn write_at(offset: Felt, index: Felt, value: T);
}

impl Storage for Felt {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset)
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value);
    }
}

impl Storage for bool {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset) as bool
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl Storage for u32 {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset) as u32
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl<T: Storage, N: u32> Storage for [T; N] {
    pub fn size() -> Felt {
        return T::size() * (N as Felt);
    }

    pub fn read(offset: Felt) -> Self {
        mem::transmute#<Self>(__storage_read_range(offset * 4, Self::size()))
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write_range(offset * 4, value);
    }
}

impl<T: Storage, N: u32> StorageAt<T, N> for [T; N] {
    pub fn read_at(offset: Felt, index: Felt) -> T {
        let offset = offset * 4 + (index * T::size());
        mem::transmute#<T>(__storage_read_range(offset, T::size()))
    }

    pub fn write_at(offset: Felt, index: Felt, value: T) {
        let offset = offset * 4 + (index * T::size());
        __storage_write_range(offset, value);
    }
}
