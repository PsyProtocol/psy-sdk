mod primitive;
mod mem;
mod context;

use primitive::*;

pub trait Storage {
    pub fn size() -> Felt;
    pub fn read(offset: Felt) -> Self;
    pub fn write(offset: Felt, value: Self);
}

pub trait StorageAt<T: Storage, N: u32> {
    pub fn read_at(offset: Felt, index: Felt) -> Self;
    pub fn write_at(offset: Felt, index: Felt, value: T);
}

impl Storage for Felt {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset)
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value);
    }
}

impl Storage for bool {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset) as bool
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl Storage for u32 {
    pub fn size() -> Felt {
        return 1;
    }

    pub fn read(offset: Felt) -> Self {
        __storage_read(offset) as u32
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write(offset, value as Felt);
    }
}

impl<T: Storage, N: u32> Storage for [T; N] {
    pub fn size() -> Felt {
        return T::size() * (N as Felt);
    }

    pub fn read(offset: Felt) -> Self {
        mem::transmute#<Self>(__storage_read_range(offset * 4, Self::size()))
    }

    pub fn write(offset: Felt, value: Self) {
        __storage_write_range(offset * 4, value);
    }
}

impl<T: Storage, N: u32> StorageAt<T, N> for [T; N] {
    pub fn write_at(offset: Felt, index: Felt, value: T) {
        let offset = offset * 4 + (index * T::size());
        T::write(offset, value)
    }

    pub fn read_at(offset: Felt, index: Felt) -> T {
        let offset = offset * 4 + (index * T::size());
        T::read(offset)
    }
}

// case 1:
//     memory <- storage
//     storage <- memory
//     storage <- storage
//
// case 2:
//      storage_ref.a
//      storage_ref[0]
//
// case 3:
//      storage_ref += 1
//      storage_ref[1] /= 1
//      storage_ref.a *= 1

pub struct StorageRef<T: Storage, N: u32> {
    pub offset: Felt,
    pub metadata: ContractMetadata,
}

impl<T: Storage, N: u32> StorageRef<T, N> {
    pub fn new(offset: Felt, metadata: ContractMetadata) -> Self {
        return new StorageRef#<T, N> {
            offset,
            metadata
        };
    }

    pub fn get(self) -> T {
        return T::read(self.offset);
    }

    pub fn set(self, value: T) {
        T::write(self.offset, value);
    }

    pub fn index(self, index: Felt) -> StorageRef<T, 1u32> {
        assert(index < (N as Felt), "Index out of bounds");
        return new StorageRef#<T, 1u32> {
            offset: self.offset + index * T::size(),
            metadata: self.metadata
        };
    }
}

pub struct ContractMetadata {
    pub contract_id: Felt,
    pub user_id: Felt,
}

impl ContractMetadata {
    pub fn new(contract_id: Felt, user_id: Felt) -> Self {
        return new ContractMetadata {
            contract_id,
            user_id
        };
    }

    pub fn current() -> Self {
        return new ContractMetadata {
            contract_id: context::get_contract_id(),
            user_id: context::get_user_id(),
        };
    }

    pub fn get_contract_id(self) -> Felt {
        self.contract_id
    }

    pub fn get_user_id(self) -> Felt {
        self.user_id
    }
}
