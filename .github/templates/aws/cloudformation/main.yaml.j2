{# Global template variables for ScyllaDB detection #}
{%- set uses_scylla_global = false -%}
{%- set scylla_config_global = None -%}
{%- if config.nodes.coordinator.backend.type == "scylla" -%}
  {%- set uses_scylla_global = true -%}
  {%- set scylla_config_global = config.nodes.coordinator.backend.scylla -%}
{%- endif -%}
{%- for realm in config.nodes.realms -%}
  {%- if realm.backend.type == "scylla" and not scylla_config_global -%}
    {%- set uses_scylla_global = true -%}
    {%- set scylla_config_global = realm.backend.scylla -%}
  {%- endif -%}
{%- endfor -%}
AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol Infrastructure - Generated from config.json'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}
    Description: Project name for resource naming
  
  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev, staging, prod]
    Description: Environment name
  

Resources:
  # VPC Configuration
  VPC:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: {{ config.nodes.deployment.aws.vpc.cidr }}
      EnableDnsHostnames: true
      EnableDnsSupport: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-vpc'

  # Internet Gateway
  InternetGateway:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-igw'

  AttachGateway:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      VpcId: !Ref VPC
      InternetGatewayId: !Ref InternetGateway

  # Service-specific Public Subnets
  # Coordinator Subnet
  CoordinatorSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [0, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [0, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  # Realm Subnets
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [{{ loop.index }}, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [{{ loop.index0 % config.nodes.deployment.aws.vpc.availability_zones }}, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}

  # Route Tables
  PublicRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-public-rt'

  PublicRoute:
    Type: AWS::EC2::Route
    DependsOn: AttachGateway
    Properties:
      RouteTableId: !Ref PublicRouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway

  # Route Table Associations
  CoordinatorSubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref CoordinatorSubnet
      RouteTableId: !Ref PublicRouteTable

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref Realm{{ realm.id }}Subnet
      RouteTableId: !Ref PublicRouteTable
  {% endfor %}

  # Main ECS Cluster for all services
  MainECSCluster:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: !Sub '${ProjectName}-${Environment}-main-ecs'
      ClusterSettings:
        - Name: containerInsights
          Value: enabled

  # Service Discovery Namespace
  ServiceDiscoveryNamespace:
    Type: AWS::ServiceDiscovery::PrivateDnsNamespace
    Properties:
      Name: qed.local
      Vpc: !Ref VPC
      Description: Private namespace for QED services

  # CloudWatch Log Group
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: {{ config.nodes.deployment.aws.ecs.log_group }}
      RetentionInDays: 7

  # ECR Repository - commented out as it may already exist
  # ECRRepository:
  #   Type: AWS::ECR::Repository
  #   Properties:
  #     RepositoryName: {{ config.nodes.deployment.aws.ecr.repository_name }}
  #     ImageScanningConfiguration:
  #       ScanOnPush: true

  # S3 Bucket for artifacts
  ArtifactsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '{{ config.nodes.deployment.aws.s3.bucket_prefix }}-${AWS::AccountId}-${AWS::Region}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # Security Groups
  ALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Application Load Balancer
      VpcId: !Ref VPC
      SecurityGroupIngress:
        {% for realm in config.nodes.realms %}
        - IpProtocol: tcp
          FromPort: {{ realm.edge.aws.load_balancer.port }}
          ToPort: {{ realm.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Realm {{ realm.id }} Edge RPC
        {% endfor %}
        - IpProtocol: tcp
          FromPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          ToPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Coordinator Edge RPC
        {% if config.nodes.prover and config.nodes.prover.enabled %}
        - IpProtocol: tcp
          FromPort: {{ config.nodes.prover.aws.load_balancer.port }}
          ToPort: {{ config.nodes.prover.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Prover RPC
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb-sg'

  ECSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for ECS tasks
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 0
          ToPort: 65535
          SourceSecurityGroupId: !Ref ALBSecurityGroup
          Description: Allow traffic from ALB
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: Allow Redis access within VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-sg'

  # Application Load Balancer
  ApplicationLoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-alb'
      Type: application
      Scheme: internet-facing
      SecurityGroups:
        - !Ref ALBSecurityGroup
      Subnets:
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb'

  # ALB Target Groups
  ALBTargetGroupCoordinator:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-coord-tg'
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-realm{{ realm.id }}-tg'
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"
  {% endfor %}

  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ALBTargetGroupProver:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-prover-tg'
      Port: {{ config.nodes.prover.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: {{ config.nodes.prover.aws.load_balancer.health_check_path }}
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"
  {% endif %}

  # ALB Listeners
  ALBListenerCoordinator:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupCoordinator
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP

  {% for realm in config.nodes.realms %}
  ALBListenerRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
  {% endfor %}

  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ALBListenerProver:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupProver
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.nodes.prover.aws.load_balancer.port }}
      Protocol: HTTP
  {% endif %}

  {% if uses_scylla_global %}
  # ScyllaDB EC2 Instances and Configuration
  ScyllaDBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for ScyllaDB instances
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # CQL port from ECS tasks
        - IpProtocol: tcp
          FromPort: 9042
          ToPort: 9042
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: CQL port
        # JMX port
        - IpProtocol: tcp
          FromPort: 7199
          ToPort: 7199
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: JMX port
        # REST API
        - IpProtocol: tcp
          FromPort: 10000
          ToPort: 10000
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: REST API
        # Prometheus metrics
        - IpProtocol: tcp
          FromPort: 9180
          ToPort: 9180
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: Prometheus metrics
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-scylla-sg'

  # Self-referencing ingress rule for ScyllaDB inter-node communication
  ScyllaDBInterNodeIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref ScyllaDBSecurityGroup
      IpProtocol: tcp
      FromPort: 7000
      ToPort: 7001
      SourceSecurityGroupId: !Ref ScyllaDBSecurityGroup
      Description: Inter-node communication

  # ScyllaDB Instance Profile
  ScyllaDBInstanceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      Policies:
        - PolicyName: ScyllaDBPolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - autoscaling:DescribeAutoScalingGroups
                  - ec2:DescribeInstances
                  - ssm:PutParameter
                  - ssm:GetParameter
                Resource: '*'

  ScyllaDBInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles:
        - !Ref ScyllaDBInstanceRole

  # ScyllaDB Launch Template
  ScyllaDBLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-scylla-lt'
      LaunchTemplateData:
        ImageId: !Sub '{%raw%}{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}{%endraw%}'
        InstanceType: {{ ('i3.large' if scylla_config_global.aws and scylla_config_global.aws.cpu >= 2048 and scylla_config_global.aws.cpu < 4096 else 'i3.xlarge' if scylla_config_global.aws and scylla_config_global.aws.cpu >= 4096 else 'i3.large') }}
        IamInstanceProfile:
          Name: !Ref ScyllaDBInstanceProfile
        SecurityGroupIds:
          - !Ref ScyllaDBSecurityGroup
        BlockDeviceMappings:
          # Root volume
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          # Data volume
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ scylla_config_global.aws.data_volume_size if scylla_config_global.aws else 500 }}
              VolumeType: gp3
              Iops: 16000
              Throughput: 1000
              DeleteOnTermination: true
              Encrypted: true
          # Commit log volume
          - DeviceName: /dev/xvdc
            Ebs:
              VolumeSize: {{ scylla_config_global.aws.commitlog_volume_size if scylla_config_global.aws else 100 }}
              VolumeType: gp3
              Iops: 16000
              Throughput: 1000
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-scylla'
              - Key: Component
                Value: scylladb
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1
            
            # Install dependencies
            apt-get update -y
            apt-get install -y docker.io awscli jq xfsprogs python3-pip
            pip3 install cassandra-driver cqlsh
            
            # Configure system settings
            sysctl -w fs.aio-max-nr=5029568
            echo "fs.aio-max-nr=5029568" >> /etc/sysctl.conf
            swapoff -a
            sed -i '/ swap / s/^/#/' /etc/fstab
            
            # Setup storage - Auto-detect device names for Nitro instances
            # Find data and commitlog devices
            DATA_DEVICE=""
            COMMITLOG_DEVICE=""
            
            # Check for NVMe devices first (Nitro instances)
            if [ -b /dev/nvme1n1 ]; then
                DATA_DEVICE="/dev/nvme1n1"
            elif [ -b /dev/xvdb ]; then
                DATA_DEVICE="/dev/xvdb"
            fi
            
            if [ -b /dev/nvme2n1 ]; then
                COMMITLOG_DEVICE="/dev/nvme2n1"
            elif [ -b /dev/xvdc ]; then
                COMMITLOG_DEVICE="/dev/xvdc"
            fi
            
            # Format and mount devices
            if [ -n "$DATA_DEVICE" ] && [ -n "$COMMITLOG_DEVICE" ]; then
                mkfs.xfs -f $DATA_DEVICE
                mkfs.xfs -f $COMMITLOG_DEVICE
                mkdir -p /var/lib/scylla/data /var/lib/scylla/commitlog
                mount $DATA_DEVICE /var/lib/scylla/data
                mount $COMMITLOG_DEVICE /var/lib/scylla/commitlog
                echo "$DATA_DEVICE /var/lib/scylla/data xfs defaults,noatime 0 0" >> /etc/fstab
                echo "$COMMITLOG_DEVICE /var/lib/scylla/commitlog xfs defaults,noatime 0 0" >> /etc/fstab
            else
                echo "Error: Could not find data or commitlog devices"
                exit 1
            fi
            
            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)
            AZ=$(curl -s http://169.254.169.254/latest/meta-data/placement/availability-zone)
            
            # Start Docker
            systemctl enable docker
            systemctl start docker
            
            # Get all IPs in the Auto Scaling Group for cluster setup
            ASG_NAME="{{ '${ProjectName}-${Environment}-scylla-asg' }}"
            INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names $ASG_NAME \
              --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
              --output text \
              --region ${AWS::Region})
            
            ALL_IPS=""
            for id in $INSTANCE_IDS; do
              IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region ${AWS::Region})
              if [ -n "$IP" ]; then
                if [ -z "$ALL_IPS" ]; then
                  ALL_IPS="$IP"
                else
                  ALL_IPS="$ALL_IPS,$IP"
                fi
              fi
            done
            
            # Use the first IP as seed node
            SEED_IP=$(echo $ALL_IPS | cut -d',' -f1)
            echo "Seed IP: $SEED_IP"
            echo "All IPs: $ALL_IPS"
            
            # Pull and run ScyllaDB
            docker pull scylladb/scylla:5.2
            docker run --name scylladb -d \
              --restart always \
              -p 9042:9042 \
              -p 9180:9180 \
              -p 7000:7000 \
              -p 7001:7001 \
              -p 7199:7199 \
              -p 10000:10000 \
              -v /var/lib/scylla/data:/var/lib/scylla \
              -v /var/lib/scylla/commitlog:/var/lib/scylla/commitlog \
              scylladb/scylla:5.2 \
              --overprovisioned 1 \
              --smp {{ scylla_config_global.aws.cpu // 1024 if scylla_config_global.aws else 2 }} \
              --seeds "$SEED_IP" \
              --listen-address "$INSTANCE_IP" \
              --rpc-address "$INSTANCE_IP" \
              --broadcast-address "$INSTANCE_IP" \
              --broadcast-rpc-address "$INSTANCE_IP" \
              --endpoint-snitch Ec2Snitch
            
            # Wait for ScyllaDB to start
            echo "Waiting for ScyllaDB to start..."
            while ! cqlsh -e "DESC KEYSPACES" $INSTANCE_IP 9042 > /dev/null 2>&1; do
              sleep 5
            done
            
            # Create keyspaces
            cqlsh $INSTANCE_IP 9042 <<EOF
            CREATE KEYSPACE IF NOT EXISTS qed_coordinator WITH replication = {
              'class': 'SimpleStrategy',
              'replication_factor': {{ scylla_config_global.replication_factor | default(3) }}
            };
            CREATE KEYSPACE IF NOT EXISTS qed_realm0 WITH replication = {
              'class': 'SimpleStrategy',
              'replication_factor': {{ scylla_config_global.replication_factor | default(3) }}
            };
            CREATE KEYSPACE IF NOT EXISTS qed_realm1 WITH replication = {
              'class': 'SimpleStrategy',
              'replication_factor': {{ scylla_config_global.replication_factor | default(3) }}
            };
            EOF
            
            # Store endpoint in SSM
            aws ssm put-parameter \
              --name "/${ProjectName}/scylladb/node-$INSTANCE_ID/endpoint" \
              --value "$INSTANCE_IP:9042" \
              --type String \
              --overwrite \
              --region ${AWS::Region}
            
            echo "ScyllaDB setup completed successfully"

  # ScyllaDB Auto Scaling Group
  ScyllaDBAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-scylla-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref ScyllaDBLaunchTemplate
        Version: !GetAtt ScyllaDBLaunchTemplate.LatestVersionNumber
      MinSize: {{ scylla_config_global.aws.ec2.min_instances if scylla_config_global.aws and scylla_config_global.aws.ec2 else 3 }}
      MaxSize: {{ scylla_config_global.aws.ec2.max_instances if scylla_config_global.aws and scylla_config_global.aws.ec2 else 3 }}
      DesiredCapacity: {{ scylla_config_global.aws.ec2.desired_instances if scylla_config_global.aws and scylla_config_global.aws.ec2 else 3 }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 600
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-scylla'
          PropagateAtLaunch: true
        - Key: Component
          Value: scylladb
          PropagateAtLaunch: true
  {% endif %}

  # Service-specific Infrastructure
  # Each service has its own ASG and infrastructure
  
  # Service-specific Security Groups
  # Coordinator Security Group
  CoordinatorSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for coordinator services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # SSH access
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        # Allow traffic from ALB
        - IpProtocol: tcp
          FromPort: 8545
          ToPort: 8545
          SourceSecurityGroupId: !Ref ALBSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-sg'

  # Self-referencing ingress rule for Coordinator internal communication
  CoordinatorInternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref CoordinatorSecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Description: Internal communication

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for realm {{ realm.id }} services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # SSH access
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        # Allow traffic from ALB
        - IpProtocol: tcp
          FromPort: {{ 8546 + loop.index0 }}
          ToPort: {{ 8546 + loop.index0 }}
          SourceSecurityGroupId: !Ref ALBSecurityGroup
        # Allow communication from coordinator
        - IpProtocol: -1
          SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-sg'

  # Self-referencing ingress rule for Realm {{ realm.id }} internal communication
  Realm{{ realm.id }}InternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
      Description: Internal communication
  {% endfor %}

  # IAM Role for EC2 Instances
  EC2InstanceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      Policies:
        - PolicyName: ECSInstancePolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecs:RegisterContainerInstance
                  - ecs:DeregisterContainerInstance
                  - ecs:DiscoverPollEndpoint
                  - ecs:Submit*
                  - ecs:Poll
                  - ecs:StartTelemetrySession
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                  - elasticloadbalancing:DescribeLoadBalancers
                Resource: '*'

  EC2InstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles:
        - !Ref EC2InstanceRole

  # ============================================================================
  # NEW 12 ASG ARCHITECTURE
  # ============================================================================
  # Processor Services (EC2 Deployment) - 3 ASGs
  # Edge Services (ECS Deployment) - 3 ASGs  
  # Worker Services (ECS Deployment) - 3 ASGs
  # Redis Services (EC2 Deployment) - 3 ASGs
  # Total: 12 ASGs

  # ============================================================================
  # PROCESSOR SERVICES (EC2 DEPLOYMENT)
  # ============================================================================

  # Coordinator Processor ASG
  CoordinatorProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-processor-lt'
      LaunchTemplateData:
        ImageId: !Sub '{%raw%}{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}{%endraw%}'
        InstanceType: c6i.xlarge  # 4 vCPU, 8GB RAM for processor
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        BlockDeviceMappings:
          # Root volume
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          # Data volume for LMDBX
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ config.nodes.coordinator.backend.lmdbx.aws.volume_size | default(200) }}
              VolumeType: gp3
              Iops: 3000
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
              - Key: Service
                Value: coordinator-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1
            echo "Starting coordinator processor setup at $(date)"
            
            # Update system
            apt-get update -y
            apt-get install -y docker.io awscli jq
            
            # Enable and start Docker
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu
            
            # Install ECS agent
            curl -O https://s3.${AWS::Region}.amazonaws.com/amazon-ecs-agent-${AWS::Region}/amazon-ecs-init-latest.amd64.deb
            dpkg -i amazon-ecs-init-latest.amd64.deb || apt-get install -f -y
            
            # Configure ECS
            mkdir -p /etc/ecs
            echo ECS_CLUSTER=${ProjectName}-${Environment}-main-ecs >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo ECS_INSTANCE_ATTRIBUTES='{"service":"coordinator-processor"}' >> /etc/ecs/ecs.config
            
            # Start ECS agent
            systemctl enable ecs
            systemctl start ecs
            
            # Setup data volume for LMDBX
            DATA_DEVICE="/dev/nvme1n1"
            [ -b /dev/xvdb ] && DATA_DEVICE="/dev/xvdb"
            
            if [ -n "$DATA_DEVICE" ]; then
                mkfs.ext4 $DATA_DEVICE
                mkdir -p /data/coordinator
                mount $DATA_DEVICE /data/coordinator
                echo "$DATA_DEVICE /data/coordinator ext4 defaults,noatime 0 0" >> /etc/fstab
                chmod 755 /data/coordinator
                chown -R 1000:1000 /data/coordinator
            fi
            
            # Login to ECR
            echo "Logging into ECR..."
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com || {
              echo "ERROR: Failed to login to ECR"
              exit 1
            }
            
            # Get Redis endpoint from NLB
            echo "Getting Redis endpoint..."
            MAX_RETRIES=10
            RETRY_COUNT=0
            
            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              REDIS_ENDPOINT=$(aws elbv2 describe-load-balancers \
                --names "${ProjectName}-${Environment}-redis-c-nlb" \
                --query 'LoadBalancers[0].DNSName' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")
              
              if [ -n "$REDIS_ENDPOINT" ] && [ "$REDIS_ENDPOINT" != "None" ]; then
                echo "Got Redis NLB endpoint: $REDIS_ENDPOINT"
                break
              else
                echo "Waiting for Redis NLB... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
                RETRY_COUNT=$((RETRY_COUNT + 1))
                sleep 30
              fi
            done
            
            if [ -z "$REDIS_ENDPOINT" ] || [ "$REDIS_ENDPOINT" == "None" ]; then
              echo "ERROR: Failed to get Redis NLB endpoint after $MAX_RETRIES attempts"
              echo "Please check:"
              echo "1. IAM permissions for elasticloadbalancing:DescribeLoadBalancers"
              echo "2. Redis NLB deployment status"
              echo "3. NLB name: ${ProjectName}-${Environment}-redis-c-nlb"
              exit 1
            fi
            
            # Pull the image first
            echo "Pulling processor image..."
            docker pull ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest || {
              echo "ERROR: Failed to pull processor image"
              exit 1
            }
            
            # Run coordinator processor with retry logic
            echo "Starting coordinator processor..."
            MAX_RETRIES=3
            RETRY_COUNT=0
            
            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              docker run -d --name coordinator-processor \
                --restart=unless-stopped \
                -v /data/coordinator:/data \
                -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
                ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
                coordinator-processor \
                --database lmdbx \
                --lmdbx-path /data \
                --redis-uri redis://$REDIS_ENDPOINT:6379
              
              # Check if container started successfully
              sleep 5
              if docker ps | grep -q coordinator-processor; then
                echo "Coordinator processor started successfully"
                break
              else
                echo "Processor failed to start, attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
                docker logs coordinator-processor 2>&1 || true
                docker rm coordinator-processor 2>/dev/null || true
                RETRY_COUNT=$((RETRY_COUNT + 1))
                sleep 10
              fi
            done
            
            # Ensure LMDBX files are created and have correct permissions
            echo "Waiting for LMDBX initialization..."
            for i in {1..30}; do
              if [ -f /data/coordinator/mdbx.dat ]; then
                echo "LMDBX files created"
                break
              fi
              echo "Waiting for LMDBX files... ($i/30)"
              sleep 2
            done
            
            # Fix permissions
            echo "Fixing file permissions..."
            chown -R 1000:1000 /data/coordinator/ || {
              echo "WARNING: Failed to change ownership, trying with sudo"
              sudo chown -R 1000:1000 /data/coordinator/ || true
            }
            
            echo "Coordinator processor setup completed at $(date)"

