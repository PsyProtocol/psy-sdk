---  
{# Global template variables for TiKV detection #}
{%- set uses_tikv_global = false -%}
{%- set tikv_config_global = None -%}
{%- if config.nodes.coordinator.backend.type == "tikv" -%}
  {%- set uses_tikv_global = true -%}
  {%- set tikv_config_global = config.nodes.coordinator.backend.tikv -%}
{%- endif -%}
{%- for realm in config.nodes.realms -%}
  {%- if realm.backend.type == "tikv" and not tikv_config_global -%}
    {%- set uses_tikv_global = true -%}
    {%- set tikv_config_global = realm.backend.tikv -%}
  {%- endif -%}
{%- endfor -%}

{# Check if global services exist #}
{%- set has_api_service = config.global_services and config.global_services.api_service and config.global_services.api_service.enabled -%}

{# Check if TimescaleDB is enabled #}
{%- set has_timescaledb = config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled -%}

AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol Infrastructure - TiKV Unified Storage with Independent Workers, Watchers, and API Service'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}
    Description: Project name for resource naming

  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev, staging, prod]
    Description: Environment name

  LatestAmiId:
    Type: AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>
    Default: /aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id
    Description: Latest Ubuntu 22.04 LTS AMI

Resources:
  # VPC Configuration
  VPC:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: {{ config.nodes.deployment.aws.vpc.cidr }}
      EnableDnsHostnames: true
      EnableDnsSupport: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-vpc'

  # Internet Gateway
  InternetGateway:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-igw'

  AttachGateway:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      VpcId: !Ref VPC
      InternetGatewayId: !Ref InternetGateway

  # Subnets
  CoordinatorSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [0, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [0, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [{{ loop.index }}, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]

      AvailabilityZone: !Select [{{ (loop.index) % config.nodes.deployment.aws.vpc.availability_zones }}, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}

  # Route Tables
  PublicRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-public-rt'

  PublicRoute:
    Type: AWS::EC2::Route
    DependsOn: AttachGateway
    Properties:
      RouteTableId: !Ref PublicRouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway

  # Route Table Associations
  CoordinatorSubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref CoordinatorSubnet
      RouteTableId: !Ref PublicRouteTable

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref Realm{{ realm.id }}Subnet
      RouteTableId: !Ref PublicRouteTable
  {% endfor %}

  # Main ECS Cluster
  MainECSCluster:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: !Sub '${ProjectName}-${Environment}-main-ecs'
      ClusterSettings:
        - Name: containerInsights
          Value: enabled
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-main-ecs'

  # Service Discovery Namespace
  ServiceDiscoveryNamespace:
    Type: AWS::ServiceDiscovery::PrivateDnsNamespace
    Properties:
      Name: qed.local
      Vpc: !Ref VPC
      Description: Private namespace for QED services

  # CloudWatch Log Group
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: {{ config.nodes.deployment.aws.ecs.log_group }}
      RetentionInDays: 7

  # S3 Bucket for artifacts
  ArtifactsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '{{ config.nodes.deployment.aws.s3.bucket_prefix }}-${AWS::AccountId}-${AWS::Region}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  ConfigBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '${ProjectName}-${Environment}-config'
      VersioningConfiguration:
        Status: Enabled
      PublicAccessBlockConfiguration:
        BlockPublicAcls: false
        BlockPublicPolicy: false
        IgnorePublicAcls: false
        RestrictPublicBuckets: false
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      LifecycleConfiguration:
        Rules:
          - Id: DeleteOldVersions
            Status: Enabled
            NoncurrentVersionExpirationInDays: 30
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-config'

  ConfigBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref ConfigBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: AllowPublicRead
            Effect: Allow
            Principal: '*'
            Action: 
              - s3:GetObject
              - s3:ListBucket
            Resource:
              - !Sub '${ConfigBucket.Arn}/*'
              - !GetAtt ConfigBucket.Arn
          - Sid: AllowServiceWrite
            Effect: Allow
            Principal:
              AWS: !Sub 'arn:aws:iam::${AWS::AccountId}:root'
            Action:
              - s3:PutObject
              - s3:PutObjectAcl
            Resource: !Sub '${ConfigBucket.Arn}/*'

  # Security Groups
  ALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Application Load Balancer
      VpcId: !Ref VPC
      SecurityGroupIngress:
        {% for realm in config.nodes.realms %}
        - IpProtocol: tcp
          FromPort: {{ realm.edge.aws.load_balancer.port }}
          ToPort: {{ realm.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Realm {{ realm.id }} Edge RPC
        {% endfor %}
        - IpProtocol: tcp
          FromPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          ToPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Coordinator Edge RPC
        {# {% if has_api_service %}
        - IpProtocol: tcp
          FromPort: {{ config.global_services.api_service.port | default(3000) }}
          ToPort: {{ config.global_services.api_service.port | default(3000) }}
          CidrIp: 0.0.0.0/0
          Description: API Service
        {% endif %} #}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb-sg'

  ECSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for ECS tasks
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 8545
          ToPort: 8545
          SourceSecurityGroupId: !Ref ALBSecurityGroup
          Description: Allow traffic from ALB for Coordinator Edge
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          CidrIp: !GetAtt VPC.CidrBlock
          Description: Allow Redis access within VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-sg'

  # Application Load Balancer
  ApplicationLoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-alb'
      Type: application
      Scheme: internet-facing
      SecurityGroups:
        - !Ref ALBSecurityGroup
      Subnets:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb'

  # ALB Target Groups
  ALBTargetGroupCoordinator:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-coord-tg'
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-realm{{ realm.id }}-tg'
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"
  {% endfor %}

  {% if has_api_service %}
  ALBTargetGroupAPI:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-api-tg'
      Port: 3000
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200"
      # Support WebSocket connections
      TargetGroupAttributes:
        - Key: deregistration_delay.timeout_seconds
          Value: '30'
        - Key: stickiness.enabled
          Value: 'true'
        - Key: stickiness.type
          Value: 'lb_cookie'

  # Register TimescaleDB instance with API target group
  TimescaleDBInstanceTargetGroupAttachment:
    Type: AWS::ElasticLoadBalancingV2::TargetGroupAttachment
    Properties:
      TargetGroupArn: !Ref ALBTargetGroupAPI
      TargetId: !Ref TimescaleDBInstance
      Port: 3000

  {% endif %}

  # ALB Listeners
  ALBListenerCoordinator:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupCoordinator
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP

  {% for realm in config.nodes.realms %}
  ALBListenerRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
  {% endfor %}

  {% if has_api_service %}
  ALBListenerAPI:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupAPI
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.global_services.api_service.port | default(3000) }}
      Protocol: HTTP
  # Allow API traffic from ALB to Database instance
  DatabaseAPIIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref DatabaseSecurityGroup
      IpProtocol: tcp
      FromPort: 3000
      ToPort: 3000
      SourceSecurityGroupId: !Ref ALBSecurityGroup
      Description: API Service from ALB

  # Allow API port in ALB security group
  ALBAPIIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref ALBSecurityGroup
      IpProtocol: tcp
      FromPort: 3000
      ToPort: 3000
      CidrIp: 0.0.0.0/0
      Description: Public API access
  {% endif %}


  # ============================================================================
  # TIKV CLUSTER INFRASTRUCTURE
  # ============================================================================
  {% if uses_tikv_global %}
  # TiKV Security Group
  TiKVSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TiKV cluster
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # PD client port
        - IpProtocol: tcp
          FromPort: 2379
          ToPort: 2379
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: PD client port
        - IpProtocol: tcp
          FromPort: 2379
          ToPort: 2379
          SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
          Description: PD client port from Coordinator
        # PD peer port
        - IpProtocol: tcp
          FromPort: 2380
          ToPort: 2380
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: PD peer communication
        # TiKV server port
        - IpProtocol: tcp
          FromPort: 20160
          ToPort: 20160
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV server port
        # Status port
        - IpProtocol: tcp
          FromPort: 20180
          ToPort: 20180
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV status port

      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-sg'

  # Self-referencing ingress rule for TiKV inter-node communication
  TiKVInterNodeIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref TiKVSecurityGroup
      IpProtocol: tcp
      FromPort: 2379
      ToPort: 20180
      SourceSecurityGroupId: !Ref TiKVSecurityGroup
      Description: TiKV cluster inter-node communication

  # TiKV PD Launch Template
  TiKVPDLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-pd-lt'
      LaunchTemplateData:
        ImageId: !Ref LatestAmiId  
        InstanceType: t3.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/sdf # Data device (will be /dev/nvme1n1 or /dev/nvme0n1 , not sure)
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.pd_volume_size | default(50) }}
              VolumeType: gp3
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
              - Key: Component
                Value: tikv-pd
        UserData:
          Fn::Base64: !Sub | 
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            echo "Starting TiKV PD setup with Docker at $(date)"

            # Install Docker and AWS CLI
            apt-get update -y
            apt-get install -y docker.io docker-compose awscli jq netcat net-tools nvme-cli
            systemctl enable docker
            systemctl start docker

            # Configure AWS region
            export AWS_DEFAULT_REGION=${AWS::Region}

            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

            # Setup data volume - FIXED for NVMe
            echo "Setting up data volume for PD..."

            #Get root volume size to exclude it
            ROOT_DEVICE=$(findmnt -n -o SOURCE / | sed 's/\[.*\]//' | sed 's/p[0-9]*$//')
            ROOT_SIZE=$(lsblk -bdn -o SIZE "$ROOT_DEVICE") 

            echo "Root device: $ROOT_DEVICE (size: $ROOT_SIZE bytes)"
            echo "All block devices:"
            lsblk -o NAME,SIZE,TYPE,MOUNTPOINT

            # Find the non-root volume (data volume)
            root_name=$(echo "$ROOT_DEVICE" | sed 's|/dev/||')
            DATA_DEVICE=$(lsblk -ndo NAME,SIZE,TYPE -b | \
              awk -v root="$root_name" -v root_size="$ROOT_SIZE" \
              '$3 == "disk" && $1 != root && $2 != root_size && $2 > 10737418240 {print "/dev/"$1; exit}')

            if [ -z "$DATA_DEVICE" ]; then
                echo "ERROR: Could not find data volume"
                echo "Root device: $ROOT_DEVICE (size: $ROOT_SIZE bytes)"
                lsblk -o NAME,SIZE,TYPE,MOUNTPOINT
                exit 1
            fi

            echo "Root device: $ROOT_DEVICE"
            echo "Data device: $DATA_DEVICE"

            # Check if already mounted (from previous launch)
            if mountpoint -q /data; then
                echo "/data already mounted, skipping format"
            else
                # Format only if not already formatted
                if ! blkid "$DATA_DEVICE" | grep -q "TYPE="; then
                    echo "Formatting $DATA_DEVICE ..."
                    mkfs.ext4 -F -L tikv_pd_data "$DATA_DEVICE"
                else
                    echo "Device already formatted"
                fi

                # Mount
                mkdir -p /data
                if ! grep -q "$DATA_DEVICE" /etc/fstab; then
                    echo "$DATA_DEVICE /data ext4 defaults,nofail 0 2" >> /etc/fstab
                fi
                mount -a
            fi

            # Create pd directory
            mkdir -p /data/pd
            chmod 777 /data/pd

            echo "Data volume mounted successfully at /data"
            df -h /data 
    
            # Get all PD instance IPs
            ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"

            # Wait for all PD instances to be launched
            echo "Waiting for all PD instances in ASG..."
            for i in {1..60}; do
                INSTANCE_COUNT=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`] | length(@)' \
                  --output text 2>/dev/null || echo 0)
              
                if [ "$INSTANCE_COUNT" -ge "3" ]; then
                    echo "All PD instances are ready"
                    break
                fi
                echo "Waiting for PD instances... ($INSTANCE_COUNT/3)"
                sleep 10
            done

            # Get all PD instance IPs with retry logic
            ALL_IPS=""
            for attempt in {1..10}; do
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[*].[InstanceId,PrivateIpAddress]' \
                  --output text 2>/dev/null || true)
                
                if [ -n "$PD_INSTANCES" ]; then
                    # Create IP list
                    ALL_IPS=""
                    while IFS=$'\t' read -r instance_id ip_address; do
                        if [ -z "$ip_address" ] || [ "$ip_address" = "None" ]; then
                            # Fetch IP if not in ASG response
                            ip_address=$(aws ec2 describe-instances \
                              --instance-ids $instance_id \
                              --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                              --output text 2>/dev/null || echo "")
                        fi
                        
                        if [ -n "$ip_address" ] && [ "$ip_address" != "None" ]; then
                            if [ -z "$ALL_IPS" ]; then
                                ALL_IPS="$ip_address"
                            else
                                ALL_IPS="$ALL_IPS,$ip_address"
                            fi
                        fi
                    done <<< "$PD_INSTANCES"
                    
                    IP_COUNT=$(echo "$ALL_IPS" | tr ',' '\n' | wc -l)
                    if [ "$IP_COUNT" -ge "3" ]; then
                        echo "Got $IP_COUNT PD IPs: $ALL_IPS"
                        break
                    fi
                fi
                
                echo "Attempt $attempt: Waiting for all PD IPs..."
                sleep 10
            done

            # Sort IPs using a simpler method to avoid array syntax issues
            SORTED_IPS=$(echo "$ALL_IPS" | tr ',' '\n' | sort -V | paste -sd ',')
            echo "Sorted PD IPs: $SORTED_IPS"

            # Determine which PD node this is (pd0, pd1, or pd2)
            PD_INDEX=-1
            NODE_NUM=0
            for IP in $(echo "$SORTED_IPS" | tr ',' ' '); do
                if [ "$IP" = "$INSTANCE_IP" ]; then
                    PD_INDEX=$NODE_NUM
                    break
                fi
                NODE_NUM=$((NODE_NUM + 1))
            done

            if [ "$PD_INDEX" -eq -1 ]; then
                echo "ERROR: Could not find instance IP in sorted list"
                exit 1
            fi

            echo "This node is pd$PD_INDEX with IP $INSTANCE_IP"

            # Build initial cluster string
            INITIAL_CLUSTER=""
            NODE_NUM=0
            for IP in $(echo "$SORTED_IPS" | tr ',' ' '); do
                if [ -n "$INITIAL_CLUSTER" ]; then
                    INITIAL_CLUSTER="$INITIAL_CLUSTER,"
                fi
                    INITIAL_CLUSTER="$INITIAL_CLUSTER"pd$NODE_NUM=http://$IP:2380
                NODE_NUM=$((NODE_NUM + 1))
            done
            
            echo "Initial cluster: $INITIAL_CLUSTER"

            # Create docker-compose for PD node
            cat > /opt/docker-compose.yml <<COMPOSE_EOF
            version: '3.8'
            services:
              pd:
                image: pingcap/pd:latest
                container_name: pdPD_INDEX_PLACEHOLDER
                network_mode: host
                command:
                  - --name=pdPD_INDEX_PLACEHOLDER
                  - --client-urls=http://0.0.0.0:2379
                  - --peer-urls=http://0.0.0.0:2380
                  - --advertise-client-urls=http://INSTANCE_IP_PLACEHOLDER:2379
                  - --advertise-peer-urls=http://INSTANCE_IP_PLACEHOLDER:2380
                  - --initial-cluster=INITIAL_CLUSTER_PLACEHOLDER
                  - --data-dir=/var/lib/pd
                  - --log-file=/var/log/pd.log
                volumes:
                  - /data/pd:/var/lib/pd
                  - /var/log:/var/log
                restart: unless-stopped
            COMPOSE_EOF

            replace_placeholder() {
                local placeholder="$1"
                local value="$2"
                local file="$3"

                local escaped_value
                escaped_value=$(printf '%s\n' "$value" | sed 's/[&/\]/\\&/g')

                echo "[INFO] Replacing $placeholder with '$value' in $file ..."
                if ! sed -i "s|$placeholder|$escaped_value|g" "$file"; then
                    echo "[ERROR] sed replacement failed for $placeholder"
                    echo "[DEBUG] Original replacement value: '$value'"
                    echo "[DEBUG] File content around placeholder ($placeholder):"
                    grep -n "$placeholder" -C 3 "$file" || echo "  (placeholder not found)"
                    exit 1
                fi
            }
            
            replace_placeholder "INSTANCE_IP_PLACEHOLDER" "$INSTANCE_IP" /opt/docker-compose.yml
            replace_placeholder "PD_INDEX_PLACEHOLDER" "$PD_INDEX" /opt/docker-compose.yml
            replace_placeholder "INITIAL_CLUSTER_PLACEHOLDER" "$INITIAL_CLUSTER" /opt/docker-compose.yml

            echo "[INFO] Final /opt/docker-compose.yml after replacements:"
            echo "-----------------------------------------"
            cat /opt/docker-compose.yml
            echo "-----------------------------------------"

            # Start PD container
            cd /opt
            docker-compose up -d

            # Wait for PD to be ready
            echo "Waiting for PD to be healthy..."
            for i in {1..120}; do
                if curl -sf http://localhost:2379/pd/api/v1/health >/dev/null 2>&1; then
                    echo "PD is healthy!"
                    
                    # Verify cluster formation
                    MEMBER_COUNT=$(curl -s http://localhost:2379/pd/api/v1/members | jq '.members | length' 2>/dev/null || echo 0)
                    echo "PD cluster has $MEMBER_COUNT members"
                    
                    if [ "$MEMBER_COUNT" -ge "3" ]; then
                        echo "PD cluster formation successful"
                        break
                    fi
                fi
                echo "Health check attempt $i/120..."
                sleep 5
            done

            echo "PD setup completed at $$(date)"
     

  # TiKV PD Auto Scaling Group
  TiKVPDAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-pd-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVPDLaunchTemplate
        Version: !GetAtt TiKVPDLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.pd_count | default(3) }}
      MaxSize: {{ tikv_config_global.aws.pd_count | default(3) }}
      DesiredCapacity: {{ tikv_config_global.aws.pd_count | default(3) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 900
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv-pd
          PropagateAtLaunch: true

  # TiKV Storage Node Launch Template
  TiKVStorageNodeLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-node-lt'
      LaunchTemplateData:
        ImageId: !Ref LatestAmiId  
        InstanceType: {{ tikv_config_global.aws.instance_type | default('c6i.xlarge') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/sdf 
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.data_volume_size | default(200) }}
              VolumeType: gp3
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-node'
              - Key: Component
                Value: tikv
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            echo "Starting TiKV storage node with Docker at $(date)"

            # Install Docker
            apt-get update -y
            apt-get install -y docker.io docker-compose awscli jq netcat net-tools ec2-instance-connect nvme-cli
            systemctl enable docker
            systemctl start docker

            export AWS_DEFAULT_REGION=${AWS::Region}

            # Get instance metadata
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            
            echo "TiKV storage node setup completed at $(date)"

             
            # Setup data volume - /dev/sdf becomes /dev/nvme1n1 on Nitro instances
            echo "Setting up data volume for TiKV..."
            # Get the ACTUAL root device (resolve /dev/root symlink)

            ROOT_DEVICE=$(findmnt -n -o SOURCE / | sed 's/\[.*\]//' | sed 's/p[0-9]*$//')
            ROOT_SIZE=$(lsblk -bdn -o SIZE "$ROOT_DEVICE")

            echo "Root device: $ROOT_DEVICE (size: $ROOT_SIZE bytes)"
            echo "All block devices:"
            lsblk -o NAME,SIZE,TYPE,MOUNTPOINT
            
            # Find data volume: non-root, no partitions, larger than 10GB
            root_name=$(echo "$ROOT_DEVICE" | sed 's|/dev/||')
            DATA_DEVICE=$(lsblk -ndo NAME,SIZE,TYPE -b | \
              awk -v root="$root_name" -v root_size="$ROOT_SIZE" \
              '$3 == "disk" && $1 != root && $2 != root_size && $2 > 10737418240 {print "/dev/"$1; exit}')

            if [ -z "$DATA_DEVICE" ]; then
                echo "ERROR: Could not find data volume"
                echo "Root: $ROOT_DEVICE ($ROOT_SIZE bytes)"
                lsblk -o NAME,SIZE,TYPE,MOUNTPOINT
                exit 1
            fi

            echo "Data device identified: $DATA_DEVICE"
            
            # Check if already mounted (from previous launch)
            if mountpoint -q /data; then
                echo "/data already mounted, skipping format"
            else
                # Format only if not already formatted
                if ! blkid "$DATA_DEVICE" | grep -q "TYPE="; then
                    echo "Formatting $DATA_DEVICE..."
                    mkfs.ext4 -F -L tikv_node_data "$DATA_DEVICE"
                else
                    echo "Device already formatted"
                fi

                # Mount
                mkdir -p /data
                if ! grep -q "$DATA_DEVICE" /etc/fstab; then
                    echo "$DATA_DEVICE /data ext4 defaults,nofail 0 2" >> /etc/fstab
                fi
                mount -a
            fi 
            
            # Verify
            if ! mountpoint -q /data; then
                echo "ERROR: /data not mounted"
                exit 1
            fi

            # Create tikv directory
            mkdir -p /data/tikv
            chmod 777 /data/tikv

            echo "Data volume mounted successfully at /data"
            df -h /data

            echo "Data volume mounted successfully"
                    
            # Get PD endpoints
            PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
            PD_ENDPOINTS=""

            # Wait for PD nodes to be ready
            echo "Waiting for PD nodes to be ready..."

            PD_READY=false
            for retry in {1..30}; do
                PD_ENDPOINTS=""
                # Get all PD instances
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $PD_ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                  --output text 2>/dev/null || echo "")

                if [ -n "$PD_INSTANCES" ]; then
                    PD_ENDPOINTS=""
                    for pd_id in $PD_INSTANCES; do
                        PD_IP=$(aws ec2 describe-instances \
                          --instance-ids $pd_id \
                          --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                          --output text 2>/dev/null || echo "")
                        
                        if [ -n "$PD_IP" ] && [ "$PD_IP" != "None" ]; then
                            if [ -z "$PD_ENDPOINTS" ]; then
                                PD_ENDPOINTS="$PD_IP:2379"
                            else
                                PD_ENDPOINTS="$PD_ENDPOINTS,$PD_IP:2379"
                            fi
                        fi
                    done
                fi
                  
                # Test PD endpoints
                if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Testing PD endpoints: $PD_ENDPOINTS"
                    for endpoint in $(echo $PD_ENDPOINTS | tr ',' ' '); do
                        if curl -sf -m 5 http://$endpoint/pd/api/v1/health >/dev/null 2>&1; then
                            MEMBER_COUNT=$(curl -s http://$endpoint/pd/api/v1/members | jq '.members | length' 2>/dev/null || echo 0)
                            if [ "$MEMBER_COUNT" -ge "3" ]; then
                                echo "PD cluster is ready with $MEMBER_COUNT members"
                                PD_READY=true
                                break 2
                            fi
                        fi
                    done

                fi
                echo "Attempt $retry: Waiting for PD cluster to be ready..."
                sleep 10

            done           

            if [ "$PD_READY" != true ]; then
                echo "ERROR: Failed to get PD endpoints"
                exit 1
            fi

            echo "Using PD endpoints: $PD_ENDPOINTS"


            # Create docker-compose for TiKV
            cat > /opt/docker-compose.yml <<COMPOSE_EOF
            version: '3.8'
            services:
              tikv:
                image: pingcap/tikv:latest
                container_name: tikv-server
                network_mode: host
                command:
                  - --addr=0.0.0.0:20160
                  - --advertise-addr=INSTANCE_IP_PLACEHOLDER:20160
                  - --status-addr=0.0.0.0:20180
                  - --advertise-status-addr=INSTANCE_IP_PLACEHOLDER:20180
                  - --data-dir=/var/lib/tikv
                  - --pd-endpoints=PD_ENDPOINTS_PLACEHOLDER
                  - --log-file=/var/log/tikv.log
                volumes:
                  - /data/tikv:/var/lib/tikv
                  - /var/log:/var/log
                restart: unless-stopped
                environment:
                  - TZ=UTC
            COMPOSE_EOF
          
            # Function to safely run sed with logging
            replace_placeholder() {
                local placeholder="$1"
                local value="$2"
                local file="$3"

                # Escape sed special chars in the replacement string
                local escaped_value
                escaped_value=$(printf '%s\n' "$value" | sed 's/[&/\]/\\&/g')

                echo "[INFO] Replacing $placeholder with '$value' in $file ..."
                if ! sed -i "s|$placeholder|$escaped_value|g" "$file"; then
                    echo "[ERROR] sed replacement failed for $placeholder"
                    echo "[DEBUG] Original placeholder value: '$value'"
                    echo "[DEBUG] File content around placeholder:"
                    grep -n "$placeholder" -C 3 "$file" || echo "  (placeholder not found)"
                    exit 1
                fi
            }

            # Replace placeholders with actual values, with logging
            replace_placeholder "INSTANCE_IP_PLACEHOLDER" "$INSTANCE_IP" /opt/docker-compose.yml
            replace_placeholder "PD_ENDPOINTS_PLACEHOLDER" "$PD_ENDPOINTS" /opt/docker-compose.yml

            echo "[INFO] Final docker-compose.yml:"
            cat /opt/docker-compose.yml


            # Start TiKV
            cd /opt
            docker-compose up -d
            
            # Verify TiKV started successfully
            sleep 20
            if docker ps | grep -q tikv-server; then
                echo "TiKV storage node started successfully"
                
                # Check if TiKV registered with PD
                for endpoint in $(echo $PD_ENDPOINTS | tr ',' ' '); do
                    STORE_COUNT=$(curl -s http://$endpoint/pd/api/v1/stores | jq '.count' 2>/dev/null || echo 0)
                    echo "PD reports $STORE_COUNT TiKV stores"
                    break
                done
            else
                echo "ERROR: TiKV failed to start"
                docker logs tikv-server || true
                exit 1
            fi            

  # TiKV Storage Node Auto Scaling Group
  TiKVNodeAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    DependsOn: TiKVPDAutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-node-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVStorageNodeLaunchTemplate
        Version: !GetAtt TiKVStorageNodeLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.tikv_count | default(3) }}
      MaxSize: {{ tikv_config_global.aws.max_instances | default(6) }}
      DesiredCapacity: {{ tikv_config_global.aws.tikv_count | default(3) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 600
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-node'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv
          PropagateAtLaunch: true
  {% endif %}

  # Redis Configuration (simplified - keeping existing Redis for caching)
  {% if config.nodes.coordinator.redis and config.nodes.coordinator.redis.aws %}
  {% set coord_redis_type = config.nodes.coordinator.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set coord_redis_type = 'elasticache' %}
  {% endif %}

  {% set uses_elasticache = false %}
  {% if coord_redis_type == 'elasticache' %}
    {% set uses_elasticache = true %}
  {% endif %}
  {% for realm in config.nodes.realms %}
    {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
      {% set uses_elasticache = true %}
    {% endif %}
  {% endfor %}

  {% if uses_elasticache %}
  RedisSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: Subnet group for Redis clusters
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
  {% endif %}

  # Coordinator Redis
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinator:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ config.nodes.coordinator.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ config.nodes.coordinator.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator'
  {% endif %}

  # Realm Redis instances
  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set realm_redis_type = 'elasticache' %}
  {% endif %}

  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ realm.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ realm.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}'
  {% endif %}
  {% endfor %}

  # IAM Roles
  EC2InstanceRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-${Environment}-ec2-instance-role'  
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
        - arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy  # Added for CloudWatch
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-ec2-instance-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecs:RegisterContainerInstance
                  - ecs:DeregisterContainerInstance
                  - ecs:DiscoverPollEndpoint
                  - ecs:Submit*
                  - ecs:Poll
                  - ecs:StartTelemetrySession
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                  - logs:CreateLogGroup
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                  - logs:DescribeLogGroups
                  - logs:DescribeLogStreams
                  - elasticloadbalancing:DescribeLoadBalancers
                  - autoscaling:DescribeAutoScalingGroups
                  - ec2:DescribeInstances
                  - elasticache:DescribeCacheClusters
                Resource: '*'
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ec2-instance-role'

  EC2InstanceProfile:
    Type: AWS::IAM::InstanceProfile
    DependsOn: EC2InstanceRole  
    Properties:
      InstanceProfileName: !Sub '${ProjectName}-${Environment}-ec2-instance-profile'  
      Roles:
        - !Ref EC2InstanceRole

  ECSTaskExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-${Environment}-ecs-task-execution-role'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-ecr-access-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                Resource: '*'
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-task-execution-role'

  ECSTaskRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-${Environment}-ecs-task-role'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-s3-access-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:ListBucket
                Resource:
                  - !Sub '${ArtifactsBucket.Arn}/*'
                  - !GetAtt ArtifactsBucket.Arn
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-task-role'
  # ============================================================================
  # PROCESSOR SERVICES (EC2 DEPLOYMENT) - ASGs for Processors only
  # ============================================================================

  # Service-specific Security Groups
  CoordinatorSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for coordinator services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8545
          ToPort: 8545
          SourceSecurityGroupId: !Ref ALBSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-sg'

  CoordinatorInternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref CoordinatorSecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Description: Internal communication

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for realm {{ realm.id }} services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: {{ 8546 + loop.index0 }}
          ToPort: {{ 8546 + loop.index0 }}
          SourceSecurityGroupId: !Ref ALBSecurityGroup
        - IpProtocol: -1
          SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-sg'

  Realm{{ realm.id }}InternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
      Description: Internal communication
  {% endfor %}
  # Coordinator Processor ASG
  CoordinatorProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-processor-lt'
      LaunchTemplateData:
        ImageId: !Ref LatestAmiId  
        InstanceType: c6i.2xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
              - Key: Service
                Value: coordinator-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq 
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Install CloudWatch agent for Docker logging
            cd /tmp
            wget https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
            dpkg -i -E ./amazon-cloudwatch-agent.deb || true
            
            # Configure awslogs for Docker
            cat > /etc/docker/daemon.json <<EOF
            {
              "log-driver": "json-file",
              "log-opts": {
                "max-size": "100m",
                "max-file": "5"
              }
            }
            EOF
            
            # Restart Docker to apply logging configuration
            systemctl restart docker
            
            # Create CloudWatch Logs configuration for Docker
            cat > /opt/aws/amazon-cloudwatch-agent/etc/docker-logs.json <<EOF
            {
              "logs": {
                "logs_collected": {
                  "files": {
                    "collect_list": [
                      {
                        "file_path": "/var/lib/docker/containers/*/*.log",
                        "log_group_name": "{{ config.nodes.deployment.aws.ecs.log_group }}",
                        "log_stream_name": "coordinator-processor-{instance_id}",
                        "timezone": "UTC"
                      }
                    ]
                  }
                }
              }
            }
            EOF
            
            # Start CloudWatch agent
            /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
              -a fetch-config \
              -m ec2 \
              -s \
              -c file:/opt/aws/amazon-cloudwatch-agent/etc/docker-logs.json

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Pull the Docker image first
            docker pull ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest

            # Get TiKV PD endpoints
            MAX_RETRIES=30
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 10
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            # Get Redis endpoint
            REDIS_ENDPOINT="${RedisCoordinator.RedisEndpoint.Address}"
            echo "Redis endpoint: $REDIS_ENDPOINT"

            # Test Redis connectivity
            for i in {1..30}; do
              if nc -zv $REDIS_ENDPOINT 6379 2>/dev/null; then
                echo "Redis is reachable"
                break
              fi
              echo "Waiting for Redis... attempt $i of 30"
              sleep 5
            done

            # Run coordinator processor with json-file logging
            # CloudWatch agent will collect these logs automatically
            docker run -d --name coordinator-processor \
              --restart=unless-stopped \
              --log-driver=json-file \
              --log-opt max-size=100m \
              --log-opt max-file=5 \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints "$PD_ENDPOINTS" \
              --tikv-namespace {{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator \
              --redis-uri "redis://$REDIS_ENDPOINT:6379" \
              {% for key, value in (config.nodes.coordinator.processor.args | default({}) | dictsort) %}
              --{{ key | replace('_','-') }} '{{ value | string }}' \
              {% endfor %}

            # Verify container started
            sleep 5
            if docker ps | grep -q coordinator-processor; then
              echo "SUCCESS: Coordinator processor is running"
              docker logs coordinator-processor --tail 50
            else
              echo "ERROR: Coordinator processor failed to start"
              docker logs coordinator-processor 2>&1 || true
            fi

            # Create a systemd service to ensure coordinator starts on reboot
            cat > /etc/systemd/system/coordinator-processor.service <<EOF
            [Unit]
            Description=QED Coordinator Processor
            After=docker.service
            Requires=docker.service

            [Service]
            Type=simple
            Restart=always
            RestartSec=10
            ExecStartPre=/usr/bin/docker pull ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest
            ExecStart=/usr/bin/docker run --rm --name coordinator-processor \
              --log-driver=json-file \
              --log-opt max-size=100m \
              --log-opt max-file=5 \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints "$PD_ENDPOINTS" \
              --tikv-namespace {{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator \
              --redis-uri "redis://$REDIS_ENDPOINT:6379"
            ExecStop=/usr/bin/docker stop coordinator-processor

            [Install]
            WantedBy=multi-user.target
            EOF

            systemctl daemon-reload
            systemctl enable coordinator-processor

            echo "Setup completed at $(date)"

  CoordinatorProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorProcessorLaunchTemplate
