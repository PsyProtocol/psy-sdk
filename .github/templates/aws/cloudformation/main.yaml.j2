        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-worker-ecs'
          PropagateAtLaunch: true
        - Key: Type
          Value: worker
          PropagateAtLaunch: true

  ProverInstanceLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-prover-lt'
      LaunchTemplateData:
      {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id}}'
      {% endraw %}
        InstanceType: c6a.2xlarge  
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 200
              VolumeType: gp3
              DeleteOnTermination: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-prover'
              - Key: Service
                Value: prover
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            echo ECS_CLUSTER=${MainECSCluster} >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo 'ECS_INSTANCE_ATTRIBUTES={"workload":"prover"}' >> /etc/ecs/ecs.config


  ProverInstanceASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-prover-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref ProverInstanceLaunchTemplate
        Version: !GetAtt ProverInstanceLaunchTemplate.LatestVersionNumber
      MinSize: 1
      MaxSize: 2
      DesiredCapacity: 1  # Single prover instance
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-prover'
          PropagateAtLaunch: true  

  {% if has_timescaledb %}
  # ============================================================================
  # TIMESCALEDB
  # ============================================================================

  # Database Security Group for TimescaleDB
  DatabaseSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TimescaleDB RDS instance
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: Allow PostgreSQL access from ECS
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-database-sg'

  # TimescaleDB Subnet Group
  TimescaleDBSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    Properties:
      DBSubnetGroupDescription: Subnet group for TimescaleDB
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% if config.nodes.realms|length > 0 %}
        - !Ref Realm{{ config.nodes.realms[0].id }}Subnet
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb-subnet-group'

  # Database Password Secret
  DBPasswordSecret:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-db-password'
      Description: Password for TimescaleDB instance
      GenerateSecretString:
        SecretStringTemplate: '{"username": "postgres"}'
        GenerateStringKey: 'password'
        PasswordLength: 32
        ExcludeCharacters: '"@/\'

  # TimescaleDB RDS Instance
  TimescaleDB:
    Type: AWS::RDS::DBInstance
    Properties:
      DBInstanceIdentifier: !Sub '${ProjectName}-${Environment}-timescaledb'
      DBInstanceClass: {{ config.global_services.timescaledb.aws.instance_class }}
      Engine: postgres
      EngineVersion: '15.4'
      AllocatedStorage: {{ config.global_services.timescaledb.aws.allocated_storage }}
      DBSubnetGroupName: !Ref TimescaleDBSubnetGroup
      VPCSecurityGroups:
        - !Ref DatabaseSecurityGroup
      DBName: qed
      MasterUsername: postgres
      {% raw %}
      MasterUserPassword: !Sub '{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}'
      {% endraw %}
      BackupRetentionPeriod: 7
      MultiAZ: {{ config.global_services.timescaledb.aws.multi_az|lower }}
      StorageType: gp3
      DeletionProtection: false
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb'
  {% endif %}

Outputs:
  VPCId:
    Value: !Ref VPC
    Export:
      Name: !Sub '${ProjectName}-${Environment}-vpc-id'

  MainECSClusterName:
