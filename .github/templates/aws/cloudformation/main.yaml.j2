      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-ecr-access-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                Resource: '*'
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-task-execution-role'

  ECSTaskRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-${Environment}-ecs-task-role'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-s3-access-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:ListBucket
                Resource:
                  - !Sub '${ArtifactsBucket.Arn}/*'
                  - !GetAtt ArtifactsBucket.Arn
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-task-role'
  # ============================================================================
  # PROCESSOR SERVICES (EC2 DEPLOYMENT) - ASGs for Processors only
  # ============================================================================

  # Service-specific Security Groups
  CoordinatorSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for coordinator services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8545
          ToPort: 8545
          SourceSecurityGroupId: !Ref ALBSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-sg'

  CoordinatorInternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref CoordinatorSecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Description: Internal communication

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for realm {{ realm.id }} services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: {{ 8546 + loop.index0 }}
          ToPort: {{ 8546 + loop.index0 }}
          SourceSecurityGroupId: !Ref ALBSecurityGroup
        - IpProtocol: -1
          SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-sg'

  Realm{{ realm.id }}InternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
      Description: Internal communication
  {% endfor %}

  # Coordinator Processor ASG
  CoordinatorProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-processor-lt'
      LaunchTemplateData:
      {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
      {% endraw %}
        InstanceType: c6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
              - Key: Service
                Value: coordinator-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=30
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 10
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            # Get Redis endpoint
            REDIS_ENDPOINT="${RedisCoordinator.RedisEndpoint.Address}"

            # Run coordinator processor
            docker run -d --name coordinator-processor \
              --restart=unless-stopped \
              --log-driver=awslogs \
              --log-opt awslogs-group={{ config.nodes.deployment.aws.ecs.log_group }} \
              --log-opt awslogs-region=${AWS::Region} \
              --log-opt awslogs-stream-prefix=coordinator-processor \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace {{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator \
              --redis-uri redis://$REDIS_ENDPOINT:6379 \
              {% for key, value in (config.nodes.coordinator.processor.args | default({}) | dictsort) %}
              --{{ key | replace('_','-') }} '{{ value | string }}' \
              {% endfor %}

  CoordinatorProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorProcessorLaunchTemplate
        Version: !GetAtt CoordinatorProcessorLaunchTemplate.LatestVersionNumber
      MinSize: {{ config.nodes.coordinator.processor.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ config.nodes.coordinator.processor.aws.ec2.max_instances | default(3) }}
      DesiredCapacity: {{ config.nodes.coordinator.processor.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
          PropagateAtLaunch: true
        - Key: Service
          Value: coordinator-processor
          PropagateAtLaunch: true

  # Realm Processor ASGs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}ProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor-lt'
      LaunchTemplateData:
        {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        {% endraw %}
        InstanceType: c6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref Realm{{ realm.id }}SecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
              - Key: Service
                Value: realm-{{ realm.id }}-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=10
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 30
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            # Get Redis endpoint
            REDIS_ENDPOINT="${RedisRealm{{ realm.id }}.RedisEndpoint.Address}"

            # Run realm processor
            docker run -d --name realm-{{ realm.id }}-processor \
              --restart=unless-stopped \
              -e RUST_LOG='{{ realm.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              realm-processor \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace realm{{ realm.id }} \
              --redis-uri redis://$REDIS_ENDPOINT:6379 \
              --realm-id {{ realm.id }} \
              {% if realm.processor.args['queue-biz-key'] %}
              --queue-biz-key {{ realm.processor.args['queue-biz-key'] }}
              {% endif %}

  Realm{{ realm.id }}ProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref Realm{{ realm.id }}ProcessorLaunchTemplate
        Version: !GetAtt Realm{{ realm.id }}ProcessorLaunchTemplate.LatestVersionNumber
      MinSize: {{ realm.processor.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ realm.processor.aws.ec2.max_instances | default(3) }}
      DesiredCapacity: {{ realm.processor.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref Realm{{ realm.id }}Subnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
          PropagateAtLaunch: true
        - Key: Service
          Value: realm-{{ realm.id }}-processor
          PropagateAtLaunch: true
  {% endfor %}
# ECS Container Instances for Edge, Worker, and API services
  GeneralECSInstancesLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-ecs-container-lt'
      LaunchTemplateData:
      {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id}}'
      {% endraw %}
        InstanceType: t3.large 
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-ecs-container'
              - Key: Service
                Value: ecs-container
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            echo ECS_CLUSTER=${MainECSCluster} >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo 'ECS_INSTANCE_ATTRIBUTES={"service":"ecs-container"}' >> /etc/ecs/ecs.config

