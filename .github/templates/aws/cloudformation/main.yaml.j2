    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-pd-asg-name'
  {% endif %}

  {% if has_timescaledb %}
  TimescaleDBInstanceId:
    Value: !Ref TimescaleDBInstance
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-instance'
    Description: TimescaleDB EC2 Instance ID
  
