---  
{# Global template variables for TiKV detection #}
{%- set uses_tikv_global = false -%}
{%- set tikv_config_global = None -%}
{%- if config.nodes.coordinator.backend.type == "tikv" -%}
  {%- set uses_tikv_global = true -%}
  {%- set tikv_config_global = config.nodes.coordinator.backend.tikv -%}
{%- endif -%}
{%- for realm in config.nodes.realms -%}
  {%- if realm.backend.type == "tikv" and not tikv_config_global -%}
    {%- set uses_tikv_global = true -%}
    {%- set tikv_config_global = realm.backend.tikv -%}
  {%- endif -%}
{%- endfor -%}

{# Check if global services exist #}
{%- set has_global_workers = config.global_services and config.global_services.workers and config.global_services.workers.enabled -%}
{%- set has_global_watchers = config.global_services and config.global_services.watchers -%}
{%- set has_api_service = config.global_services and config.global_services.api_service and config.global_services.api_service.enabled -%}
{%- set has_timescaledb = config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled -%}

AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol Infrastructure - TiKV Unified Storage with Independent Workers, Watchers, and API Service'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}
    Description: Project name for resource naming

  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev, staging, prod]
    Description: Environment name

Resources:
  # VPC Configuration
  VPC:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: {{ config.nodes.deployment.aws.vpc.cidr }}
      EnableDnsHostnames: true
      EnableDnsSupport: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-vpc'

  # Internet Gateway
  InternetGateway:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-igw'

  AttachGateway:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      VpcId: !Ref VPC
      InternetGatewayId: !Ref InternetGateway

  # Subnets
  CoordinatorSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [0, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [0, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [{{ loop.index }}, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]

      AvailabilityZone: !Select [{{ (loop.index) % config.nodes.deployment.aws.vpc.availability_zones }}, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}

  # Route Tables
  PublicRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-public-rt'

  PublicRoute:
    Type: AWS::EC2::Route
    DependsOn: AttachGateway
    Properties:
      RouteTableId: !Ref PublicRouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway

  # Route Table Associations
  CoordinatorSubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref CoordinatorSubnet
      RouteTableId: !Ref PublicRouteTable

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref Realm{{ realm.id }}Subnet
      RouteTableId: !Ref PublicRouteTable
  {% endfor %}

  # Main ECS Cluster
  MainECSCluster:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: !Sub '${ProjectName}-${Environment}-main-ecs'
      ClusterSettings:
        - Name: containerInsights
          Value: enabled
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-main-ecs'

  # Service Discovery Namespace
  ServiceDiscoveryNamespace:
    Type: AWS::ServiceDiscovery::PrivateDnsNamespace
    Properties:
      Name: qed.local
      Vpc: !Ref VPC
      Description: Private namespace for QED services

  # CloudWatch Log Group
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: {{ config.nodes.deployment.aws.ecs.log_group }}
      RetentionInDays: 7

  # S3 Bucket for artifacts
  ArtifactsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '{{ config.nodes.deployment.aws.s3.bucket_prefix }}-${AWS::AccountId}-${AWS::Region}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # Security Groups
  ALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Application Load Balancer
      VpcId: !Ref VPC
      SecurityGroupIngress:
        {% for realm in config.nodes.realms %}
        - IpProtocol: tcp
          FromPort: {{ realm.edge.aws.load_balancer.port }}
          ToPort: {{ realm.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Realm {{ realm.id }} Edge RPC
        {% endfor %}
        - IpProtocol: tcp
          FromPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          ToPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Coordinator Edge RPC
        {% if has_api_service %}
        - IpProtocol: tcp
          FromPort: {{ config.global_services.api_service.port | default(3000) }}
          ToPort: {{ config.global_services.api_service.port | default(3000) }}
          CidrIp: 0.0.0.0/0
          Description: API Service
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb-sg'

  ECSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for ECS tasks
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 0
          ToPort: 65535
          SourceSecurityGroupId: !Ref ALBSecurityGroup
          Description: Allow traffic from ALB
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: Allow Redis access within VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-sg'

  # Application Load Balancer
  ApplicationLoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-alb'
      Type: application
      Scheme: internet-facing
      SecurityGroups:
        - !Ref ALBSecurityGroup
      Subnets:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb'

  # ALB Target Groups
  ALBTargetGroupCoordinator:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-coord-tg'
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-realm{{ realm.id }}-tg'
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"
  {% endfor %}

  {% if has_api_service %}
  ALBTargetGroupAPI:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-api-tg'
      Port: {{ config.global_services.api_service.port | default(3000) }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: ip
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: {{ config.global_services.api_service.aws.load_balancer.health_check_path | default('/health') }}
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200"
  {% endif %}

  # ALB Listeners
  ALBListenerCoordinator:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupCoordinator
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP

  {% for realm in config.nodes.realms %}
  ALBListenerRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
  {% endfor %}

  {% if has_api_service %}
  ALBListenerAPI:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupAPI
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.global_services.api_service.port | default(3000) }}
      Protocol: HTTP
  {% endif %}

  {% if uses_tikv_global %}
  # ============================================================================
  # TIKV CLUSTER INFRASTRUCTURE
  # ============================================================================

  # TiKV Security Group
  TiKVSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TiKV cluster
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # PD client port
        - IpProtocol: tcp
          FromPort: 2379
          ToPort: 2379
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: PD client port
        # PD peer port
        - IpProtocol: tcp
          FromPort: 2380
          ToPort: 2380
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: PD peer communication
        # TiKV server port
        - IpProtocol: tcp
          FromPort: 20160
          ToPort: 20160
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV server port
        # Status port
        - IpProtocol: tcp
          FromPort: 20180
          ToPort: 20180
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV status port
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-sg'

  # Self-referencing ingress rule for TiKV inter-node communication
  TiKVInterNodeIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref TiKVSecurityGroup
      IpProtocol: tcp
      FromPort: 2379
      ToPort: 20180
      SourceSecurityGroupId: !Ref TiKVSecurityGroup
      Description: Inter-node communication

  # TiKV PD Launch Template
  TiKVClusterLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-pd-lt'
      LaunchTemplateData:
        {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        {% endraw %}
        InstanceType: t3.medium  # Changed from i3.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.pd_volume_size | default(50) }}
              VolumeType: gp3
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
              - Key: Component
                Value: tikv-pd
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system
            apt-get update -y
            apt-get install -y wget curl jq

            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

            # Setup data volume
            DATA_DEVICE="/dev/nvme1n1"
            [ -b /dev/xvdb ] && DATA_DEVICE="/dev/xvdb"

            if [ -n "$DATA_DEVICE" ]; then
                mkfs.ext4 $DATA_DEVICE
                mkdir -p /data/pd
                mount $DATA_DEVICE /data/pd
                echo "$DATA_DEVICE /data/pd ext4 defaults,noatime 0 0" >> /etc/fstab
            fi

            # Download TiKV
            cd /opt
            wget https://download.pingcap.org/tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz
            tar -xzf tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz

            # Get cluster IPs for initial cluster
            ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
            INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names $ASG_NAME \
              --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
              --output text \
              --region ${AWS::Region})

            INITIAL_CLUSTER=""
            for id in $INSTANCE_IDS; do
              IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region ${AWS::Region})
              if [ -n "$IP" ]; then
                if [ -z "$INITIAL_CLUSTER" ]; then
                  INITIAL_CLUSTER="pd-$IP=http://$IP:2380"
                else
                  INITIAL_CLUSTER="$INITIAL_CLUSTER,pd-$IP=http://$IP:2380"
                fi
              fi
            done

            # Start PD
            /opt/tidb-community-toolkit-v7.5.1-linux-amd64/bin/pd-server \
              --name=pd-$INSTANCE_IP \
              --data-dir=/data/pd \
              --client-urls=http://0.0.0.0:2379 \
              --peer-urls=http://0.0.0.0:2380 \
              --advertise-client-urls=http://$INSTANCE_IP:2379 \
              --advertise-peer-urls=http://$INSTANCE_IP:2380 \
              --initial-cluster="$INITIAL_CLUSTER" \
              --log-file=/var/log/pd.log &

            echo "PD server started successfully"

  # TiKV PD Auto Scaling Group
  TiKVPDAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-pd-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVClusterLaunchTemplate
        Version: !GetAtt TiKVClusterLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.pd_count | default(1) }}
      MaxSize: {{ tikv_config_global.aws.pd_count | default(1) }}
      DesiredCapacity: {{ tikv_config_global.aws.pd_count | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 900
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv-pd
          PropagateAtLaunch: true

  # TiKV Storage Node Launch Template
  TiKVNodeLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-node-lt'
      LaunchTemplateData:
        {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        {% endraw %}
        InstanceType: {{ tikv_config_global.aws.instance_type | default('c6i.xlarge') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.data_volume_size | default(500) }}
              VolumeType: gp3
              Iops: 16000
              Throughput: 1000
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-node'
              - Key: Component
                Value: tikv
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system
            apt-get update -y
            apt-get install -y wget curl jq

            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

            # Setup data volume
            DATA_DEVICE="/dev/nvme1n1"
            [ -b /dev/xvdb ] && DATA_DEVICE="/dev/xvdb"

            if [ -n "$DATA_DEVICE" ]; then
                mkfs.ext4 $DATA_DEVICE
                mkdir -p /data/tikv
                mount $DATA_DEVICE /data/tikv
                echo "$DATA_DEVICE /data/tikv ext4 defaults,noatime 0 0" >> /etc/fstab
            fi

            # Download TiKV
            cd /opt
            wget https://download.pingcap.org/tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz
            tar -xzf tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz

            # Get PD endpoints
            PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
            PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names $PD_ASG_NAME \
              --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
              --output text \
              --region ${AWS::Region})

            PD_ENDPOINTS=""
            for id in $PD_INSTANCE_IDS; do
              IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region ${AWS::Region})
              if [ -n "$IP" ]; then
                if [ -z "$PD_ENDPOINTS" ]; then
                  PD_ENDPOINTS="http://$IP:2379"
                else
                  PD_ENDPOINTS="$PD_ENDPOINTS,http://$IP:2379"
                fi
              fi
            done

            # Wait for PD to be ready
            for i in {1..30}; do
              if curl -f $PD_ENDPOINTS/pd/api/v1/version >/dev/null 2>&1; then
                echo "PD cluster is ready"
                break
              fi
              echo "Waiting for PD cluster... ($i/30)"
              sleep 10
            done

            # Start TiKV
            /opt/tidb-community-toolkit-v7.5.1-linux-amd64/bin/tikv-server \
              --pd-endpoints="$PD_ENDPOINTS" \
              --addr="0.0.0.0:20160" \
              --status-addr="0.0.0.0:20180" \
              --data-dir="/data/tikv" \
              --log-file="/var/log/tikv.log" &

            echo "TiKV server started successfully"

  # TiKV Storage Node Auto Scaling Group
  TiKVNodeAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    DependsOn: TiKVPDAutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-node-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVNodeLaunchTemplate
        Version: !GetAtt TiKVNodeLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.tikv_count | default(3) }}
      MaxSize: {{ tikv_config_global.aws.max_instances | default(6) }}
      DesiredCapacity: {{ tikv_config_global.aws.tikv_count | default(3) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 600
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-node'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv
          PropagateAtLaunch: true
  {% endif %}

      # Redis Configuration (simplified - keeping existing Redis for caching)
  {% if config.nodes.coordinator.redis and config.nodes.coordinator.redis.aws %}
  {% set coord_redis_type = config.nodes.coordinator.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set coord_redis_type = 'elasticache' %}
  {% endif %}

  {% set uses_elasticache = false %}
  {% if coord_redis_type == 'elasticache' %}
    {% set uses_elasticache = true %}
  {% endif %}
  {% for realm in config.nodes.realms %}
    {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
      {% set uses_elasticache = true %}
    {% endif %}
  {% endfor %}

  {% if uses_elasticache %}
  RedisSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: Subnet group for Redis clusters
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
  {% endif %}

  # Coordinator Redis
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinator:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ config.nodes.coordinator.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ config.nodes.coordinator.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator'
  {% endif %}

  # Realm Redis instances
  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set realm_redis_type = 'elasticache' %}
  {% endif %}

  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ realm.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ realm.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}'
  {% endif %}
  {% endfor %}

  # IAM Roles
  EC2InstanceRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-${Environment}-ec2-instance-role'  
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      Policies:
        - PolicyName: !Sub '${ProjectName}-${Environment}-ec2-instance-policy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecs:RegisterContainerInstance
                  - ecs:DeregisterContainerInstance
                  - ecs:DiscoverPollEndpoint
                  - ecs:Submit*
                  - ecs:Poll
                  - ecs:StartTelemetrySession
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                  - elasticloadbalancing:DescribeLoadBalancers
                  - autoscaling:DescribeAutoScalingGroups
                  - ec2:DescribeInstances
                Resource: '*'
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ec2-instance-role'

  EC2InstanceProfile:
    Type: AWS::IAM::InstanceProfile
    DependsOn: EC2InstanceRole  
    Properties:
      InstanceProfileName: !Sub '${ProjectName}-${Environment}-ec2-instance-profile'  # Add unique naming
