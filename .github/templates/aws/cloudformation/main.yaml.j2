            echo ECS_CLUSTER=${ProjectName}-${Environment}-main-ecs >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo ECS_INSTANCE_ATTRIBUTES='{"service":"realm-{{ realm.id }}-worker"}' >> /etc/ecs/ecs.config
            
            systemctl enable ecs
            systemctl start ecs

  Realm{{ realm.id }}WorkerASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref Realm{{ realm.id }}WorkerLaunchTemplate
        Version: !GetAtt Realm{{ realm.id }}WorkerLaunchTemplate.LatestVersionNumber
      MinSize: 1
      MaxSize: 5
      DesiredCapacity: 2
      VPCZoneIdentifier:
        - !Ref Realm{{ realm.id }}Subnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker'
          PropagateAtLaunch: true
        - Key: Service
          Value: realm-{{ realm.id }}-worker
          PropagateAtLaunch: true
  {% endfor %}

  # Redis Configuration
  {% if config.nodes.coordinator.redis and config.nodes.coordinator.redis.aws %}
  {% set coord_redis_type = config.nodes.coordinator.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set coord_redis_type = 'elasticache' %}
  {% endif %}

  # ElastiCache Subnet Group (if any Redis uses ElastiCache)
  {% set uses_elasticache = false %}
  {% if coord_redis_type == 'elasticache' %}
    {% set uses_elasticache = true %}
  {% endif %}
  {% for realm in config.nodes.realms %}
    {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
      {% set uses_elasticache = true %}
    {% endif %}
  {% endfor %}

  {% if uses_elasticache %}
  RedisSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: Subnet group for Redis clusters
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
  {% endif %}

  # Coordinator Redis
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinator:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ config.nodes.coordinator.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ config.nodes.coordinator.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator'
  {% elif coord_redis_type == 'ec2' %}
  # Network Load Balancer for Coordinator Redis
  RedisCoordinatorNLB:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-redis-c-nlb'
      Type: network
      Scheme: internal
      Subnets:
        - !Ref CoordinatorSubnet
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator-nlb'

  RedisCoordinatorNLBTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-redis-coord-tg'
      Port: 6379
      Protocol: TCP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckProtocol: TCP
      HealthCheckPort: 6379
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 3
      UnhealthyThresholdCount: 3

  RedisCoordinatorNLBListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn: !Ref RedisCoordinatorNLB
      Port: 6379
      Protocol: TCP
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref RedisCoordinatorNLBTargetGroup

  # EC2 Launch Template for Coordinator Redis
  RedisCoordinatorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-redis-coordinator-lt'
      LaunchTemplateData:
        ImageId: !Sub '{%raw%}{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}{%endraw%}'
        InstanceType: {{ recommendations | selectattr('service_name', 'equalto', 'Redis') | map(attribute='instance_type') | first | default('r6i.large') }}
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: {{ config.nodes.coordinator.redis.aws.ec2.volume_size | default(200) }}
              VolumeType: gp3
              DeleteOnTermination: true
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1
            
            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            
            # Enable and start Docker
            systemctl enable docker
            systemctl start docker
            
            # Run Redis in Docker container
            docker run -d --name redis-coordinator \
              --restart=unless-stopped \
              -p 6379:6379 \
              redis:7-alpine \
              redis-server \
              --save "" \
              --maxmemory 2gb \
              --maxmemory-policy allkeys-lru
            
            echo "Redis configuration completed"
            
  RedisCoordinatorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-redis-coordinator-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref RedisCoordinatorLaunchTemplate
        Version: !GetAtt RedisCoordinatorLaunchTemplate.LatestVersionNumber
      MinSize: {{ config.nodes.coordinator.redis.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ config.nodes.coordinator.redis.aws.ec2.max_instances | default(1) }}
      DesiredCapacity: {{ config.nodes.coordinator.redis.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      TargetGroupARNs:
        - !Ref RedisCoordinatorNLBTargetGroup
  {% endif %}

  # Realm Redis instances
  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set realm_redis_type = 'elasticache' %}
  {% endif %}
  
  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ realm.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ realm.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}'
  {% elif realm_redis_type == 'ec2' %}
  # Network Load Balancer for Realm {{ realm.id }} Redis
  RedisRealm{{ realm.id }}NLB:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-redis-r{{ realm.id }}-nlb'
      Type: network
      Scheme: internal
      Subnets:
        - !Ref Realm{{ realm.id }}Subnet
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-nlb'

  RedisRealm{{ realm.id }}NLBTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm{{ realm.id }}-tg'
      Port: 6379
      Protocol: TCP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckProtocol: TCP
      HealthCheckPort: 6379
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 3
      UnhealthyThresholdCount: 3

  RedisRealm{{ realm.id }}NLBListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn: !Ref RedisRealm{{ realm.id }}NLB
      Port: 6379
      Protocol: TCP
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref RedisRealm{{ realm.id }}NLBTargetGroup

  # EC2 Launch Template for Realm {{ realm.id }} Redis
  RedisRealm{{ realm.id }}LaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-lt'
      LaunchTemplateData:
        ImageId: !Sub '{%raw%}{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}{%endraw%}'
        InstanceType: {{ recommendations | selectattr('service_name', 'equalto', 'Redis') | map(attribute='instance_type') | first | default('r6i.large') }}
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: {{ realm.redis.aws.ec2.volume_size | default(200) }}
              VolumeType: gp3
              DeleteOnTermination: true
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1
            
            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            
            # Enable and start Docker
            systemctl enable docker
            systemctl start docker
            
            # Run Redis in Docker container
            docker run -d --name redis-realm-{{ realm.id }} \
              --restart=unless-stopped \
              -p 6379:6379 \
              redis:7-alpine \
              redis-server \
              --save "" \
              --maxmemory 2gb \
              --maxmemory-policy allkeys-lru
            
            echo "Redis configuration completed for Realm {{ realm.id }}"
            
  RedisRealm{{ realm.id }}ASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref RedisRealm{{ realm.id }}LaunchTemplate
        Version: !GetAtt RedisRealm{{ realm.id }}LaunchTemplate.LatestVersionNumber
      MinSize: {{ realm.redis.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ realm.redis.aws.ec2.max_instances | default(1) }}
      DesiredCapacity: {{ realm.redis.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref Realm{{ realm.id }}Subnet
      TargetGroupARNs:
        - !Ref RedisRealm{{ realm.id }}NLBTargetGroup
  {% endif %}
  {% endfor %}

  # IAM Roles
  ECSTaskExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
      Policies:
        - PolicyName: ECRAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                Resource: '*'

  ECSTaskRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: S3Access
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:ListBucket
                Resource:
                  - !Sub '${ArtifactsBucket.Arn}/*'
                  - !GetAtt ArtifactsBucket.Arn

Outputs:
  VPCId:
    Value: !Ref VPC
    Export:
      Name: !Sub '${ProjectName}-${Environment}-vpc-id'
  
  MainECSClusterName:
    Value: !Ref MainECSCluster
    Export:
      Name: !Sub '${ProjectName}-${Environment}-main-ecs-cluster'
  
  ALBDNSName:
    Value: !GetAtt ApplicationLoadBalancer.DNSName
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-dns'
  
  ECRRepositoryURI:
    Value: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-ecr-uri'
  
  ServiceDiscoveryNamespaceId:
    Value: !Ref ServiceDiscoveryNamespace
    Export:
      Name: !Sub '${ProjectName}-${Environment}-sd-namespace-id'
  
  ALBTargetGroupCoordinatorArn:
    Value: !Ref ALBTargetGroupCoordinator
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tg-coordinator-arn'
  
  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Value: !Ref ALBTargetGroupRealm{{ realm.id }}
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tg-realm{{ realm.id }}-arn'
  {% endfor %}
  
  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ALBTargetGroupProverArn:
    Value: !Ref ALBTargetGroupProver
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tg-prover-arn'
  {% endif %}
  
  TaskExecutionRoleArn:
    Value: !GetAtt ECSTaskExecutionRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-execution-role-arn'
  
  TaskRoleArn:
    Value: !GetAtt ECSTaskRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-role-arn'
  
  ECSSecurityGroupId:
    Value: !Ref ECSSecurityGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-ecs-sg-id'
  
  PublicSubnetIds:
    Value: !Join
      - ','
      - - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
    Export:
      Name: !Sub '${ProjectName}-${Environment}-public-subnet-ids'
  

  # Redis Endpoints
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinatorEndpoint:
    Value: !GetAtt RedisCoordinator.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-coordinator-endpoint'
    Description: Redis Coordinator endpoint
  {% elif coord_redis_type == 'ec2' %}
  RedisCoordinatorEndpoint:
    Value: !GetAtt RedisCoordinatorNLB.DNSName
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-coordinator-endpoint'
    Description: Redis Coordinator NLB endpoint
  {% endif %}
  
  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set realm_redis_type = 'elasticache' %}
  {% endif %}
  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}Endpoint:
    Value: !GetAtt RedisRealm{{ realm.id }}.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-endpoint'
    Description: Redis Realm {{ realm.id }} endpoint
  {% elif realm_redis_type == 'ec2' %}
  RedisRealm{{ realm.id }}Endpoint:
    Value: !GetAtt RedisRealm{{ realm.id }}NLB.DNSName
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-endpoint'
    Description: Redis Realm {{ realm.id }} NLB endpoint
  {% endif %}
  {% endfor %}

  {% if uses_scylla_global %}
  ScyllaDBAutoScalingGroupName:
    Value: !Ref ScyllaDBAutoScalingGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-scylla-asg'
    Description: ScyllaDB Auto Scaling Group name
  
  ScyllaDBSecurityGroupId:
    Value: !Ref ScyllaDBSecurityGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-scylla-sg'
    Description: ScyllaDB Security Group ID
  {% endif %}