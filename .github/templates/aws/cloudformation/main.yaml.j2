  ServiceDiscoveryNamespaceId:
    Value: !Ref ServiceDiscoveryNamespace
    Export:
      Name: !Sub '${ProjectName}-${Environment}-sd-namespace-id'

  TaskExecutionRoleArn:
    Value: !GetAtt ECSTaskExecutionRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-execution-role'

  TaskRoleArn:
    Value: !GetAtt ECSTaskRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-role'

  # ALB Target Group ARNs
  ALBTargetGroupCoordinatorArn:
    Value: !Ref ALBTargetGroupCoordinator
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-tg-coordinator'

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Value: !Ref ALBTargetGroupRealm{{ realm.id }}
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-tg-realm-{{ realm.id }}'
  {% endfor %}

  # Redis Endpoints
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinatorEndpoint:
    Value: !GetAtt RedisCoordinator.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-coordinator-endpoint'
    Description: Redis Coordinator endpoint
  {% endif %}

  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}Endpoint:
    Value: !GetAtt RedisRealm{{ realm.id }}.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-endpoint'
    Description: Redis Realm {{ realm.id }} endpoint
  {% endif %}
  {% endif %}
  {% endfor %}

  # This belongs in main.yaml, not ecs-services.yaml
  {% if uses_tikv_global %}
  TiKVPDAutoScalingGroupName:
    Description: TiKV PD Auto Scaling Group name
    Value: !Ref TiKVPDAutoScalingGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-pd-asg-name'
  {% endif %}

  {% if has_timescaledb %}
  TimescaleDBEndpoint:
    Description: TimescaleDB RDS endpoint
    Value: !GetAtt TimescaleDB.Endpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-endpoint'

  TimescaleDBPort:
    Description: TimescaleDB RDS port
    Value: !GetAtt TimescaleDB.Endpoint.Port
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-port'

  DBPasswordSecretArn:
    Description: ARN of the secret containing the database password
    Value: !Ref DBPasswordSecret
    Export:
      Name: !Sub '${ProjectName}-${Environment}-db-password-secret'
  {% endif %}

  {% if has_api_service %}
  APIServiceLoadBalancerEndpoint:
    Description: API Service endpoint URL via ALB
    Value: !Sub 'http://${ApplicationLoadBalancer.DNSName}:{{ config.global_services.api_service.port | default(3000) }}'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service-endpoint'
  {% endif %}

  # Security Groups
  ECSSecurityGroupId:
    Value: !Ref ECSSecurityGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-ecs-sg'

  {% if uses_tikv_global %}
  TiKVSecurityGroupId:
    Value: !Ref TiKVSecurityGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-sg'
  {% endif %}

  # Subnet IDs
  CoordinatorSubnetId:
    Value: !Ref CoordinatorSubnet
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetId:
    Value: !Ref Realm{{ realm.id }}Subnet
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}