{# Global template variables for TiKV detection #}
{%- set uses_tikv_global = false -%}
{%- set tikv_config_global = None -%}
{%- if config.nodes.coordinator.backend.type == "tikv" -%}
  {%- set uses_tikv_global = true -%}
  {%- set tikv_config_global = config.nodes.coordinator.backend.tikv -%}
{%- endif -%}
{%- for realm in config.nodes.realms -%}
  {%- if realm.backend.type == "tikv" and not tikv_config_global -%}
    {%- set uses_tikv_global = true -%}
    {%- set tikv_config_global = realm.backend.tikv -%}
  {%- endif -%}
{%- endfor -%}

{# Check if global services exist #}
{%- set has_global_workers = config.global_services and config.global_services.workers and config.global_services.workers.enabled -%}
{%- set has_global_watchers = config.global_services and config.global_services.watchers -%}
{%- set has_api_service = config.global_services and config.global_services.api_service and config.global_services.api_service.enabled -%}
{%- set has_timescaledb = config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled -%}

AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol Infrastructure - TiKV Unified Storage with Independent Workers, Watchers, and API Service'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}
    Description: Project name for resource naming

  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev, staging, prod]
    Description: Environment name

Resources:
  # VPC Configuration
  VPC:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: {{ config.nodes.deployment.aws.vpc.cidr }}
      EnableDnsHostnames: true
      EnableDnsSupport: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-vpc'

  # Internet Gateway
  InternetGateway:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-igw'

  AttachGateway:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      VpcId: !Ref VPC
      InternetGatewayId: !Ref InternetGateway

  # Subnets
  CoordinatorSubnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [0, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [0, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: !Ref VPC
      CidrBlock: !Select [{{ loop.index }}, !Cidr [!GetAtt VPC.CidrBlock, 8, 8]]
      AvailabilityZone: !Select [{{ loop.index0 % config.nodes.deployment.aws.vpc.availability_zones }}, !GetAZs '']
      MapPublicIpOnLaunch: true
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}

  # Route Tables
  PublicRouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-public-rt'

  PublicRoute:
    Type: AWS::EC2::Route
    DependsOn: AttachGateway
    Properties:
      RouteTableId: !Ref PublicRouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref InternetGateway

  # Route Table Associations
  CoordinatorSubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref CoordinatorSubnet
      RouteTableId: !Ref PublicRouteTable

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetRouteTableAssociation:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref Realm{{ realm.id }}Subnet
      RouteTableId: !Ref PublicRouteTable
  {% endfor %}

  # Main ECS Cluster
  MainECSCluster:
    Type: AWS::ECS::Cluster
    Properties:
      ClusterName: !Sub '${ProjectName}-${Environment}-main-ecs'
      ClusterSettings:
        - Name: containerInsights
          Value: enabled

  # Service Discovery Namespace
  ServiceDiscoveryNamespace:
    Type: AWS::ServiceDiscovery::PrivateDnsNamespace
    Properties:
      Name: qed.local
      Vpc: !Ref VPC
      Description: Private namespace for QED services

  # CloudWatch Log Group
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: {{ config.nodes.deployment.aws.ecs.log_group }}
      RetentionInDays: 7

  # S3 Bucket for artifacts
  ArtifactsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '{{ config.nodes.deployment.aws.s3.bucket_prefix }}-${AWS::AccountId}-${AWS::Region}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # Security Groups
  ALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Application Load Balancer
      VpcId: !Ref VPC
      SecurityGroupIngress:
        {% for realm in config.nodes.realms %}
        - IpProtocol: tcp
          FromPort: {{ realm.edge.aws.load_balancer.port }}
          ToPort: {{ realm.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Realm {{ realm.id }} Edge RPC
        {% endfor %}
        - IpProtocol: tcp
          FromPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          ToPort: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
          CidrIp: 0.0.0.0/0
          Description: Coordinator Edge RPC
        {% if has_api_service %}
        - IpProtocol: tcp
          FromPort: {{ config.global_services.api_service.port | default(3000) }}
          ToPort: {{ config.global_services.api_service.port | default(3000) }}
          CidrIp: 0.0.0.0/0
          Description: API Service
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb-sg'

  ECSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for ECS tasks
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 0
          ToPort: 65535
          SourceSecurityGroupId: !Ref ALBSecurityGroup
          Description: Allow traffic from ALB
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: Allow Redis access within VPC
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-ecs-sg'

  # Application Load Balancer
  ApplicationLoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-alb'
      Type: application
      Scheme: internet-facing
      SecurityGroups:
        - !Ref ALBSecurityGroup
      Subnets:
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-alb'

  # ALB Target Groups
  ALBTargetGroupCoordinator:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-coord-tg'
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-realm{{ realm.id }}-tg'
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: instance
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: /health
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200,404"
  {% endfor %}

  {% if has_api_service %}
  ALBTargetGroupAPI:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-api-tg'
      Port: {{ config.global_services.api_service.port | default(3000) }}
      Protocol: HTTP
      VpcId: !Ref VPC
      TargetType: ip
      HealthCheckEnabled: true
      HealthCheckProtocol: HTTP
      HealthCheckPath: {{ config.global_services.api_service.aws.load_balancer.health_check_path | default('/health') }}
      HealthCheckIntervalSeconds: 30
      HealthCheckTimeoutSeconds: 10
      HealthyThresholdCount: 2
      UnhealthyThresholdCount: 3
      Matcher:
        HttpCode: "200"
  {% endif %}

  # ALB Listeners
  ALBListenerCoordinator:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupCoordinator
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.nodes.coordinator.edge.aws.load_balancer.port }}
      Protocol: HTTP

  {% for realm in config.nodes.realms %}
  ALBListenerRealm{{ realm.id }}:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ realm.edge.aws.load_balancer.port }}
      Protocol: HTTP
  {% endfor %}

  {% if has_api_service %}
  ALBListenerAPI:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: forward
          TargetGroupArn: !Ref ALBTargetGroupAPI
      LoadBalancerArn: !Ref ApplicationLoadBalancer
      Port: {{ config.global_services.api_service.port | default(3000) }}
      Protocol: HTTP
  {% endif %}

  {% if uses_tikv_global %}
  # ============================================================================
  # TIKV CLUSTER INFRASTRUCTURE
  # ============================================================================

  # TiKV Security Group
  TiKVSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TiKV cluster
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # PD client port
        - IpProtocol: tcp
          FromPort: 2379
          ToPort: 2379
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: PD client port
        # PD peer port
        - IpProtocol: tcp
          FromPort: 2380
          ToPort: 2380
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: PD peer communication
        # TiKV server port
        - IpProtocol: tcp
          FromPort: 20160
          ToPort: 20160
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV server port
        # Status port
        - IpProtocol: tcp
          FromPort: 20180
          ToPort: 20180
          CidrIp: {{ config.nodes.deployment.aws.vpc.cidr }}
          Description: TiKV status port
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-sg'

  # Self-referencing ingress rule for TiKV inter-node communication
  TiKVInterNodeIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref TiKVSecurityGroup
      IpProtocol: tcp
      FromPort: 2379
      ToPort: 20180
      SourceSecurityGroupId: !Ref TiKVSecurityGroup
      Description: Inter-node communication

  # TiKV PD Launch Template
  TiKVPDLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-pd-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: {{ tikv_config_global.aws.pd_instance_type | default('c6i.large') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.pd_volume_size | default(50) }}
              VolumeType: gp3
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
              - Key: Component
                Value: tikv-pd
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system
            apt-get update -y
            apt-get install -y wget curl jq

            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

            # Setup data volume
            DATA_DEVICE="/dev/nvme1n1"
            [ -b /dev/xvdb ] && DATA_DEVICE="/dev/xvdb"

            if [ -n "$DATA_DEVICE" ]; then
                mkfs.ext4 $DATA_DEVICE
                mkdir -p /data/pd
                mount $DATA_DEVICE /data/pd
                echo "$DATA_DEVICE /data/pd ext4 defaults,noatime 0 0" >> /etc/fstab
            fi

            # Download TiKV
            cd /opt
            wget https://download.pingcap.org/tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz
            tar -xzf tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz

            # Get cluster IPs for initial cluster
            ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
            INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names $ASG_NAME \
              --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
              --output text \
              --region ${AWS::Region})

            INITIAL_CLUSTER=""
            for id in $INSTANCE_IDS; do
              IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region ${AWS::Region})
              if [ -n "$IP" ]; then
                if [ -z "$INITIAL_CLUSTER" ]; then
                  INITIAL_CLUSTER="pd-$IP=http://$IP:2380"
                else
                  INITIAL_CLUSTER="$INITIAL_CLUSTER,pd-$IP=http://$IP:2380"
                fi
              fi
            done

            # Start PD
            /opt/tidb-community-toolkit-v7.5.1-linux-amd64/bin/pd-server \
              --name=pd-$INSTANCE_IP \
              --data-dir=/data/pd \
              --client-urls=http://0.0.0.0:2379 \
              --peer-urls=http://0.0.0.0:2380 \
              --advertise-client-urls=http://$INSTANCE_IP:2379 \
              --advertise-peer-urls=http://$INSTANCE_IP:2380 \
              --initial-cluster="$INITIAL_CLUSTER" \
              --log-file=/var/log/pd.log &

            echo "PD server started successfully"

  # TiKV PD Auto Scaling Group
  TiKVPDAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-pd-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVPDLaunchTemplate
        Version: !GetAtt TiKVPDLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.pd_count | default(3) }}
      MaxSize: {{ tikv_config_global.aws.pd_count | default(3) }}
      DesiredCapacity: {{ tikv_config_global.aws.pd_count | default(3) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 600
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-pd'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv-pd
          PropagateAtLaunch: true

  # TiKV Storage Node Launch Template
  TiKVNodeLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-tikv-node-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: {{ tikv_config_global.aws.instance_type | default('c6i.xlarge') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref TiKVSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
          - DeviceName: /dev/xvdb
            Ebs:
              VolumeSize: {{ tikv_config_global.aws.data_volume_size | default(500) }}
              VolumeType: gp3
              Iops: 16000
              Throughput: 1000
              DeleteOnTermination: true
              Encrypted: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-tikv-node'
              - Key: Component
                Value: tikv
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system
            apt-get update -y
            apt-get install -y wget curl jq

            # Get instance metadata
            INSTANCE_ID=$(curl -s http://169.254.169.254/latest/meta-data/instance-id)
            INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

            # Setup data volume
            DATA_DEVICE="/dev/nvme1n1"
            [ -b /dev/xvdb ] && DATA_DEVICE="/dev/xvdb"

            if [ -n "$DATA_DEVICE" ]; then
                mkfs.ext4 $DATA_DEVICE
                mkdir -p /data/tikv
                mount $DATA_DEVICE /data/tikv
                echo "$DATA_DEVICE /data/tikv ext4 defaults,noatime 0 0" >> /etc/fstab
            fi

            # Download TiKV
            cd /opt
            wget https://download.pingcap.org/tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz
            tar -xzf tidb-community-toolkit-v7.5.1-linux-amd64.tar.gz

            # Get PD endpoints
            PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
            PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
              --auto-scaling-group-names $PD_ASG_NAME \
              --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
              --output text \
              --region ${AWS::Region})

            PD_ENDPOINTS=""
            for id in $PD_INSTANCE_IDS; do
              IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region ${AWS::Region})
              if [ -n "$IP" ]; then
                if [ -z "$PD_ENDPOINTS" ]; then
                  PD_ENDPOINTS="http://$IP:2379"
                else
                  PD_ENDPOINTS="$PD_ENDPOINTS,http://$IP:2379"
                fi
              fi
            done

            # Wait for PD to be ready
            for i in {1..30}; do
              if curl -f $PD_ENDPOINTS/pd/api/v1/version >/dev/null 2>&1; then
                echo "PD cluster is ready"
                break
              fi
              echo "Waiting for PD cluster... ($i/30)"
              sleep 10
            done

            # Start TiKV
            /opt/tidb-community-toolkit-v7.5.1-linux-amd64/bin/tikv-server \
              --pd-endpoints="$PD_ENDPOINTS" \
              --addr="0.0.0.0:20160" \
              --status-addr="0.0.0.0:20180" \
              --data-dir="/data/tikv" \
              --log-file="/var/log/tikv.log" &

            echo "TiKV server started successfully"

  # TiKV Storage Node Auto Scaling Group
  TiKVNodeAutoScalingGroup:
    Type: AWS::AutoScaling::AutoScalingGroup
    DependsOn: TiKVPDAutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-tikv-node-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref TiKVNodeLaunchTemplate
        Version: !GetAtt TiKVNodeLaunchTemplate.LatestVersionNumber
      MinSize: {{ tikv_config_global.aws.tikv_count | default(3) }}
      MaxSize: {{ tikv_config_global.aws.max_instances | default(6) }}
      DesiredCapacity: {{ tikv_config_global.aws.tikv_count | default(3) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 600
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-node'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv
          PropagateAtLaunch: true
  {% endif %}

  # Redis Configuration (simplified - keeping existing Redis for caching)
  {% if config.nodes.coordinator.redis and config.nodes.coordinator.redis.aws %}
  {% set coord_redis_type = config.nodes.coordinator.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set coord_redis_type = 'elasticache' %}
  {% endif %}

  {% set uses_elasticache = false %}
  {% if coord_redis_type == 'elasticache' %}
    {% set uses_elasticache = true %}
  {% endif %}
  {% for realm in config.nodes.realms %}
    {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
      {% set uses_elasticache = true %}
    {% endif %}
  {% endfor %}

  {% if uses_elasticache %}
  RedisSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: Subnet group for Redis clusters
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% for realm in config.nodes.realms %}
        - !Ref Realm{{ realm.id }}Subnet
        {% endfor %}
  {% endif %}

  # Coordinator Redis
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinator:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ config.nodes.coordinator.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ config.nodes.coordinator.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator'
  {% endif %}

  # Realm Redis instances
  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% else %}
  {% set realm_redis_type = 'elasticache' %}
  {% endif %}

  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: {{ realm.redis.aws.elasticache.node_type | default('cache.t3.micro') }}
      Engine: redis
      NumCacheNodes: {{ realm.redis.aws.elasticache.num_cache_nodes | default(1) }}
      CacheSubnetGroupName: !Ref RedisSubnetGroup
      VpcSecurityGroupIds:
        - !Ref ECSSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}'
  {% endif %}
  {% endfor %}

  # IAM Roles
  EC2InstanceRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonEC2ContainerServiceforEC2Role
        - arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      Policies:
        - PolicyName: ECSInstancePolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecs:RegisterContainerInstance
                  - ecs:DeregisterContainerInstance
                  - ecs:DiscoverPollEndpoint
                  - ecs:Submit*
                  - ecs:Poll
                  - ecs:StartTelemetrySession
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                  - logs:CreateLogStream
                  - logs:PutLogEvents
                  - elasticloadbalancing:DescribeLoadBalancers
                  - autoscaling:DescribeAutoScalingGroups
                  - ec2:DescribeInstances
                Resource: '*'

  EC2InstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles:
        - !Ref EC2InstanceRole

  ECSTaskExecutionRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy
      Policies:
        - PolicyName: ECRAccess
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - ecr:GetAuthorizationToken
                  - ecr:BatchCheckLayerAvailability
                  - ecr:GetDownloadUrlForLayer
                  - ecr:BatchGetImage
                Resource: '*'

  ECSTaskRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ecs-tasks.amazonaws.com
            Action: sts:AssumeRole
      Policies:
        - PolicyName: S3Access
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:ListBucket
                Resource:
                  - !Sub '${ArtifactsBucket.Arn}/*'
                  - !GetAtt ArtifactsBucket.Arn

  # ============================================================================
  # PROCESSOR SERVICES (EC2 DEPLOYMENT) - 3 ASGs
  # ============================================================================

  # Service-specific Security Groups
  CoordinatorSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for coordinator services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: 8545
          ToPort: 8545
          SourceSecurityGroupId: !Ref ALBSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-sg'

  CoordinatorInternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref CoordinatorSecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Description: Internal communication

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for realm {{ realm.id }} services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: {{ 8546 + loop.index0 }}
          ToPort: {{ 8546 + loop.index0 }}
          SourceSecurityGroupId: !Ref ALBSecurityGroup
        - IpProtocol: -1
          SourceSecurityGroupId: !Ref CoordinatorSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-sg'

  Realm{{ realm.id }}InternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
      Description: Internal communication
  {% endfor %}

  # Coordinator Processor ASG
  CoordinatorProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-processor-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: c6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
              - Key: Service
                Value: coordinator-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=10
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 30
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            # Get Redis endpoint
            REDIS_ENDPOINT="${RedisRealm{{ realm.id }}.RedisEndpoint.Address}"

            # Run realm processor
            docker run -d --name realm-{{ realm.id }}-processor \
              --restart=unless-stopped \
              -e RUST_LOG='{{ realm.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              realm-processor \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace realm{{ realm.id }} \
              --redis-uri redis://$REDIS_ENDPOINT:6379 \
              --realm-id {{ realm.id }} \
              {% if realm.processor.args['queue-biz-key'] %}
              --queue-biz-key {{ realm.processor.args['queue-biz-key'] }}
              {% endif %}

  Realm{{ realm.id }}ProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref Realm{{ realm.id }}ProcessorLaunchTemplate
        Version: !GetAtt Realm{{ realm.id }}ProcessorLaunchTemplate.LatestVersionNumber
      MinSize: {{ realm.processor.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ realm.processor.aws.ec2.max_instances | default(3) }}
      DesiredCapacity: {{ realm.processor.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref Realm{{ realm.id }}Subnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
          PropagateAtLaunch: true
        - Key: Service
          Value: realm-{{ realm.id }}-processor
          PropagateAtLaunch: true
  {% endfor %}

  # ============================================================================
  # EDGE SERVICES (ECS DEPLOYMENT) - 3 ASGs for ECS instances
  # ============================================================================

  # Coordinator Edge ASG (for ECS instances)
  CoordinatorEdgeLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-edge-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: m6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-edge'
              - Key: Service
                Value: coordinator-edge
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e

            # Update system and install ECS
            apt-get update
            apt-get install -y curl docker.io jq awscli
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Install ECS agent
            curl -O https://s3.${AWS::Region}.amazonaws.com/amazon-ecs-agent-${AWS::Region}/amazon-ecs-init-latest.amd64.deb
            dpkg -i amazon-ecs-init-latest.amd64.deb || apt-get install -f -y

            # Configure ECS
            mkdir -p /etc/ecs
            echo ECS_CLUSTER=${ProjectName}-${Environment}-main-ecs >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo ECS_INSTANCE_ATTRIBUTES='{"service":"coordinator-edge"}' >> /etc/ecs/ecs.config

            systemctl enable ecs
            systemctl start ecs

  CoordinatorEdgeASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-edge-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorEdgeLaunchTemplate
        Version: !GetAtt CoordinatorEdgeLaunchTemplate.LatestVersionNumber
      MinSize: 1
      MaxSize: 3
      DesiredCapacity: 2
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      TargetGroupARNs:
        - !Ref ALBTargetGroupCoordinator
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-edge'
          PropagateAtLaunch: true
        - Key: Service
          Value: coordinator-edge
          PropagateAtLaunch: true

  # Realm Edge ASGs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: m6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref Realm{{ realm.id }}SecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
              - Key: Service
                Value: realm-{{ realm.id }}-edge
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e

            # Update system and install ECS
            apt-get update
            apt-get install -y curl docker.io jq awscli
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Install ECS agent
            curl -O https://s3.${AWS::Region}.amazonaws.com/amazon-ecs-agent-${AWS::Region}/amazon-ecs-init-latest.amd64.deb
            dpkg -i amazon-ecs-init-latest.amd64.deb || apt-get install -f -y

            # Configure ECS
            mkdir -p /etc/ecs
            echo ECS_CLUSTER=${ProjectName}-${Environment}-main-ecs >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            echo ECS_INSTANCE_ATTRIBUTES='{"service":"realm-{{ realm.id }}-edge"}' >> /etc/ecs/ecs.config

            systemctl enable ecs
            systemctl start ecs

  Realm{{ realm.id }}EdgeASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref Realm{{ realm.id }}EdgeLaunchTemplate
        Version: !GetAtt Realm{{ realm.id }}EdgeLaunchTemplate.LatestVersionNumber
      MinSize: 1
      MaxSize: 3
      DesiredCapacity: 2
      VPCZoneIdentifier:
        - !Ref Realm{{ realm.id }}Subnet
      TargetGroupARNs:
        - !Ref ALBTargetGroupRealm{{ realm.id }}
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
          PropagateAtLaunch: true
        - Key: Service
          Value: realm-{{ realm.id }}-edge
          PropagateAtLaunch: true
  {% endfor %}

  # ============================================================================
  # ECS TASK DEFINITIONS AND SERVICES
  # ============================================================================

  # Coordinator Edge Task Definition
  CoordinatorEdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref ECSTaskExecutionRole
      TaskRoleArn: !Ref ECSTaskRole
      ContainerDefinitions:
        - Name: coordinator-edge
          Image: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest'
          Command:
            - coordinator-edge
            - --database
            - tikv
            - --tikv-pd-endpoints
            - !Sub "${TiKVPDEndpoints}"
            - --tikv-namespace
            - coordinator
            - --redis-uri
            - !Sub "redis://${RedisCoordinator.RedisEndpoint.Address}:6379"
          Environment:
            - Name: RUST_LOG
              Value: '{{ config.nodes.coordinator.edge.env.RUST_LOG }}'
          PortMappings:
            - ContainerPort: 8545
              HostPort: 8545
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8545/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-edge

  CoordinatorEdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      Cluster: !Ref MainECSCluster
      TaskDefinition: !Ref CoordinatorEdgeTaskDefinition
      DesiredCount: 2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-edge'
      ServiceRegistries:
        - RegistryArn: !GetAtt CoordinatorEdgeServiceDiscovery.Arn

  CoordinatorEdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: coordinator-edge
      DnsConfig:
        DnsRecords:
          - Type: A
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespace
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Realm Edge Task Definitions and Services
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref ECSTaskExecutionRole
      TaskRoleArn: !Ref ECSTaskRole
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-edge
          Image: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest'
          Command:
            - realm-edge
            - --database
            - tikv
            - --tikv-pd-endpoints
            - !Sub "${TiKVPDEndpoints}"
            - --tikv-namespace
            - realm{{ realm.id }}
            - --redis-uri
            - !Sub "redis://${RedisRealm{{ realm.id }}.RedisEndpoint.Address}:6379"
            - --realm-id
            - "{{ realm.id }}"
            - --coordinator-addr
            - "http://coordinator-edge.qed.local:8545"
            {% if realm.edge.args['queue-biz-key'] %}
            - --queue-biz-key
            - "{{ realm.edge.args['queue-biz-key'] }}"
            {% endif %}
          Environment:
            - Name: RUST_LOG
              Value: '{{ realm.edge.env.RUST_LOG }}'
          PortMappings:
            - ContainerPort: {{ 8546 + loop.index0 }}
              HostPort: {{ 8546 + loop.index0 }}
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:{{ 8546 + loop.index0 }}/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge

  Realm{{ realm.id }}EdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      Cluster: !Ref MainECSCluster
      TaskDefinition: !Ref Realm{{ realm.id }}EdgeTaskDefinition
      DesiredCount: 2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-edge'
      ServiceRegistries:
        - RegistryArn: !GetAtt Realm{{ realm.id }}EdgeServiceDiscovery.Arn

  Realm{{ realm.id }}EdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: realm{{ realm.id }}-edge
      DnsConfig:
        DnsRecords:
          - Type: A
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespace
      HealthCheckCustomConfig:
        FailureThreshold: 1
  {% endfor %}

  # ============================================================================
  # WATCHER SERVICES (EC2 DEPLOYMENT) - 3 ASGs
  # ============================================================================

  {% if has_global_watchers %}
  # Coordinator Watcher
  {% for watcher in config.global_services.watchers %}
  {% if watcher.node_type == 'coordinator' %}
  CoordinatorWatcherLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-watcher-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: {{ watcher.aws.instance_type | default('t3.small') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
              - Key: Service
                Value: coordinator-watcher
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=10
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 30
            done

            # Run coordinator watcher
            docker run -d --name coordinator-watcher \
              --restart=unless-stopped \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              watcher \
              --node-id {{ watcher.node_id }} \
              --node-type coordinator \
              --redis-url redis://${RedisCoordinator.RedisEndpoint.Address}:6379 \
              --api-endpoint http://api-service.qed.local:{{ config.global_services.api_service.port | default(3000) }} \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace watcher-coordinator

  CoordinatorWatcherASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-watcher-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorWatcherLaunchTemplate
        Version: !GetAtt CoordinatorWatcherLaunchTemplate.LatestVersionNumber
      MinSize: {{ watcher.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ watcher.aws.ec2.max_instances | default(1) }}
      DesiredCapacity: {{ watcher.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
          PropagateAtLaunch: true
        - Key: Service
          Value: coordinator-watcher
          PropagateAtLaunch: true
  {% endif %}

  # Realm Watchers
  {% if watcher.node_type == 'realm' %}
  Realm{{ watcher.realm_id }}WatcherLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-realm-{{ watcher.realm_id }}-watcher-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: {{ watcher.aws.instance_type | default('t3.small') }}
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref Realm{{ watcher.realm_id }}SecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-realm-{{ watcher.realm_id }}-watcher'
              - Key: Service
                Value: realm-{{ watcher.realm_id }}-watcher
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=10
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 30
            done

            # Run realm watcher
            docker run -d --name realm{{ watcher.realm_id }}-watcher \
              --restart=unless-stopped \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              watcher \
              --node-id {{ watcher.node_id }} \
              --node-type realm \
              --realm-id {{ watcher.realm_id }} \
              --redis-url redis://${RedisRealm{{ watcher.realm_id }}.RedisEndpoint.Address}:6379 \
              --api-endpoint http://api-service.qed.local:{{ config.global_services.api_service.port | default(3000) }} \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace watcher-realm{{ watcher.realm_id }}

  Realm{{ watcher.realm_id }}WatcherASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-realm-{{ watcher.realm_id }}-watcher-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref Realm{{ watcher.realm_id }}WatcherLaunchTemplate
        Version: !GetAtt Realm{{ watcher.realm_id }}WatcherLaunchTemplate.LatestVersionNumber
      MinSize: {{ watcher.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ watcher.aws.ec2.max_instances | default(1) }}
      DesiredCapacity: {{ watcher.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref Realm{{ watcher.realm_id }}Subnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ watcher.realm_id }}-watcher'
          PropagateAtLaunch: true
        - Key: Service
          Value: realm-{{ watcher.realm_id }}-watcher
          PropagateAtLaunch: true
  {% endif %}
  {% endfor %}
  {% endif %}

  # ============================================================================
  # GLOBAL WORKER SERVICE (ECS DEPLOYMENT)
  # ============================================================================

  {% if has_global_workers %}
  GlobalWorkerTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-global-worker'
      NetworkMode: awsvpc
      RequiresCompatibilities:
        - FARGATE
      Cpu: '{{ config.global_services.workers.aws.cpu | default(2048) }}'
      Memory: '{{ config.global_services.workers.aws.memory | default(4096) }}'
      ExecutionRoleArn: !Ref ECSTaskExecutionRole
      TaskRoleArn: !Ref ECSTaskRole
      ContainerDefinitions:
        - Name: global-worker
          Image: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest'
          Command:
            - worker
            - --task-sources
            - >-
              coordinator:http://coordinator-edge.qed.local:8545{% for realm in config.nodes.realms %},realm{{ realm.id }}:http://realm{{ realm.id }}-edge.qed.local:{{ 8546 + loop.index0 }}{% endfor %}
            - --poll-interval
            - "{{ config.global_services.workers.poll_interval | default(1000) }}"
            - --max-concurrent-tasks
            - "{{ config.global_services.workers.max_concurrent_tasks | default(5) }}"
          Environment:
            - Name: RUST_LOG
              Value: 'qed_worker=info'
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: global-worker

  GlobalWorkerService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-global-worker'
      Cluster: !Ref MainECSCluster
      TaskDefinition: !Ref GlobalWorkerTaskDefinition
      DesiredCount: {{ config.global_services.workers.aws.ecs.task_count | default(5) }}
      LaunchType: FARGATE
      NetworkConfiguration:
        AwsvpcConfiguration:
          AssignPublicIp: ENABLED
          SecurityGroups:
            - !Ref ECSSecurityGroup
          Subnets:
            - !Ref CoordinatorSubnet
            {% for realm in config.nodes.realms %}
            - !Ref Realm{{ realm.id }}Subnet
            {% endfor %}
  {% endif %}

  # ============================================================================
  # API SERVICE AND TIMESCALEDB
  # ============================================================================

  {% if has_timescaledb %}
  # Database Security Group for TimescaleDB
  DatabaseSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TimescaleDB RDS instance
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: Allow PostgreSQL access from ECS
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-database-sg'

  # TimescaleDB Subnet Group
  TimescaleDBSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    Properties:
      DBSubnetGroupDescription: Subnet group for TimescaleDB
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% if config.nodes.realms|length > 0 %}
        - !Ref Realm{{ config.nodes.realms[0].id }}Subnet
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb-subnet-group'

  # Database Password Secret
  DBPasswordSecret:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-db-password'
      Description: Password for TimescaleDB instance
      GenerateSecretString:
        SecretStringTemplate: '{"username": "postgres"}'
        GenerateStringKey: 'password'
        PasswordLength: 32
        ExcludeCharacters: '"@/\'

  # TimescaleDB RDS Instance
  TimescaleDB:
    Type: AWS::RDS::DBInstance
    Properties:
      DBInstanceIdentifier: !Sub '${ProjectName}-${Environment}-timescaledb'
      DBInstanceClass: {{ config.global_services.timescaledb.aws.instance_class }}
      Engine: postgres
      EngineVersion: '15.4'
      AllocatedStorage: {{ config.global_services.timescaledb.aws.allocated_storage }}
      DBSubnetGroupName: !Ref TimescaleDBSubnetGroup
      VPCSecurityGroups:
        - !Ref DatabaseSecurityGroup
      DBName: qed
      MasterUsername: postgres
      MasterUserPassword: !Sub '{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}'
      BackupRetentionPeriod: 7
      MultiAZ: {{ config.global_services.timescaledb.aws.multi_az|lower }}
      StorageType: gp3
      DeletionProtection: false
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb'
  {% endif %}

  {% if has_api_service %}
  # API Service Task Definition
  APIServiceTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-api-service'
      NetworkMode: awsvpc
      RequiresCompatibilities:
        - FARGATE
      Cpu: '{{ config.global_services.api_service.aws.cpu | default(2048) }}'
      Memory: '{{ config.global_services.api_service.aws.memory | default(4096) }}'
      ExecutionRoleArn: !Ref ECSTaskExecutionRole
      TaskRoleArn: !Ref ECSTaskRole
      ContainerDefinitions:
        - Name: api-service
          Image: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest'
          Command:
            - qed_api_services
          Environment:
            {% if has_timescaledb %}
            - Name: DATABASE_URL
              Value: !Sub 'postgres://postgres:{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}@${TimescaleDB.Endpoint.Address}:5432/qed'
            {% else %}
            - Name: DATABASE_URL
              Value: "{{ config.global_services.api_service.database_url }}"
            {% endif %}
            - Name: RUST_LOG
              Value: 'qed_api_services=info'
          PortMappings:
            - ContainerPort: {{ config.global_services.api_service.port | default(3000) }}
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:{{ config.global_services.api_service.port | default(3000) }}/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: api-service

  APIService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-api-service'
      Cluster: !Ref MainECSCluster
      TaskDefinition: !Ref APIServiceTaskDefinition
      DesiredCount: {{ config.global_services.api_service.aws.ecs.task_count | default(2) }}
      LaunchType: FARGATE
      NetworkConfiguration:
        AwsvpcConfiguration:
          AssignPublicIp: ENABLED
          SecurityGroups:
            - !Ref ECSSecurityGroup
          Subnets:
            - !Ref CoordinatorSubnet
            {% for realm in config.nodes.realms %}
            - !Ref Realm{{ realm.id }}Subnet
            {% endfor %}
      LoadBalancers:
        - ContainerName: api-service
          ContainerPort: {{ config.global_services.api_service.port | default(3000) }}
          TargetGroupArn: !Ref ALBTargetGroupAPI
      HealthCheckGracePeriodSeconds: 120
      ServiceRegistries:
        - RegistryArn: !GetAtt APIServiceDiscovery.Arn

  APIServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: api-service
      DnsConfig:
        DnsRecords:
          - Type: A
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespace
      HealthCheckCustomConfig:
        FailureThreshold: 1
  {% endif %}

Outputs:
  VPCId:
    Value: !Ref VPC
    Export:
      Name: !Sub '${ProjectName}-${Environment}-vpc-id'

  MainECSClusterName:
    Value: !Ref MainECSCluster
    Export:
      Name: !Sub '${ProjectName}-${Environment}-main-ecs-cluster'

  ALBDNSName:
    Value: !GetAtt ApplicationLoadBalancer.DNSName
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-dns'

  ECRRepositoryURI:
    Value: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-ecr-uri'

  ServiceDiscoveryNamespaceId:
    Value: !Ref ServiceDiscoveryNamespace
    Export:
      Name: !Sub '${ProjectName}-${Environment}-sd-namespace-id'

  {% if uses_tikv_global %}
  TiKVPDEndpoints:
    Description: TiKV PD cluster endpoints
    Value: !Sub '${TiKVPDAutoScalingGroup}-endpoints'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-pd-endpoints'
  {% endif %}

  # Redis Endpoints
  {% if coord_redis_type == 'elasticache' %}
  RedisCoordinatorEndpoint:
    Value: !GetAtt RedisCoordinator.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-coordinator-endpoint'
    Description: Redis Coordinator endpoint
  {% endif %}

  {% for realm in config.nodes.realms %}
  {% if realm.redis and realm.redis.aws %}
  {% set realm_redis_type = realm.redis.aws.deployment_type | default('elasticache') %}
  {% if realm_redis_type == 'elasticache' %}
  RedisRealm{{ realm.id }}Endpoint:
    Value: !GetAtt RedisRealm{{ realm.id }}.RedisEndpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-endpoint'
    Description: Redis Realm {{ realm.id }} endpoint
  {% endif %}
  {% endif %}
  {% endfor %}

  {% if has_timescaledb %}
  TimescaleDBEndpoint:
    Description: TimescaleDB RDS endpoint
    Value: !GetAtt TimescaleDB.Endpoint.Address
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-endpoint'

  TimescaleDBPort:
    Description: TimescaleDB RDS port
    Value: !GetAtt TimescaleDB.Endpoint.Port
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-port'
  {% endif %}

  {% if has_api_service %}
  APIServiceEndpoint:
    Description: API Service endpoint
    Value: !Sub '${ApplicationLoadBalancer.DNSName}:{{ config.global_services.api_service.port | default(3000) }}'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service-endpoint'
  {% endif %}
            apt-get install -y docker.io awscli jq
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Get TiKV PD endpoints
            MAX_RETRIES=10
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 30
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            # Get Redis endpoint
            REDIS_ENDPOINT="${RedisCoordinator.RedisEndpoint.Address}"

            # Run coordinator processor
            docker run -d --name coordinator-processor \
              --restart=unless-stopped \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints $PD_ENDPOINTS \
              --tikv-namespace coordinator \
              --redis-uri redis://$REDIS_ENDPOINT:6379

  CoordinatorProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorProcessorLaunchTemplate
        Version: !GetAtt CoordinatorProcessorLaunchTemplate.LatestVersionNumber
      MinSize: {{ config.nodes.coordinator.processor.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ config.nodes.coordinator.processor.aws.ec2.max_instances | default(3) }}
      DesiredCapacity: {{ config.nodes.coordinator.processor.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
          PropagateAtLaunch: true
        - Key: Service
          Value: coordinator-processor
          PropagateAtLaunch: true

  # Realm Processor ASGs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}ProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor-lt'
      LaunchTemplateData:
        ImageId: !Sub '{{resolve:ssm:/aws/service/canonical/ubuntu/server/22.04/stable/current/amd64/hvm/ebs-gp2/ami-id}}'
        InstanceType: c6i.xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref Realm{{ realm.id }}SecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
              - Key: Service
                Value: realm-{{ realm.id }}-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y