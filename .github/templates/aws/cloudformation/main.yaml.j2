  WorkerInstancesLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-worker-ecs-lt'
      LaunchTemplateData:
      {% raw %}
        ImageId: !Sub '{{resolve:ssm:/aws/service/ecs/optimized-ami/amazon-linux-2023/recommended/image_id}}'
      {% endraw %}
        InstanceType: c6a.2xlarge  # AMD EPYC, 8 vCPUs, 16GB RAM
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-worker-ecs'
              - Key: Service
                Value: worker-ecs
              - Key: Type
                Value: worker
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            echo ECS_CLUSTER=${MainECSCluster} >> /etc/ecs/ecs.config
            echo ECS_ENABLE_TASK_IAM_ROLE=true >> /etc/ecs/ecs.config
            echo ECS_ENABLE_CONTAINER_METADATA=true >> /etc/ecs/ecs.config
            # Add worker-specific attribute
            echo 'ECS_INSTANCE_ATTRIBUTES={"workload":"worker","instance_type":"c6a.2xlarge"}' >> /etc/ecs/ecs.config
            # Optimize for compute workloads
            echo ECS_ENABLE_TASK_CPU_MEM_LIMIT=false >> /etc/ecs/ecs.config
            echo ECS_IMAGE_CLEANUP_INTERVAL=30m >> /etc/ecs/ecs.config
            echo ECS_IMAGE_MINIMUM_CLEANUP_AGE=30m >> /etc/ecs/ecs.config
            
  WorkerInstancesASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-worker-ecs-asg'
