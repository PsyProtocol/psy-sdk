  # ============================================================================
  # TIMESCALEDB
  # ============================================================================
  {% if has_timescaledb %}
  # Database Security Group for TimescaleDB
  DatabaseSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TimescaleDB RDS instance
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: Allow PostgreSQL access from ECS
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
          Description: SSH access
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-database-sg'

  TimescaleDBInstance:
    Type: AWS::EC2::Instance
    Properties:
      InstanceType: t3.xlarge  # 4 vCPU, 16GB RAM
      ImageId: !Ref LatestAmiId
      IamInstanceProfile: !Ref EC2InstanceProfile
      SecurityGroupIds:
        - !Ref DatabaseSecurityGroup
      SubnetId: !Ref CoordinatorSubnet
      BlockDeviceMappings:
        - DeviceName: /dev/sda1
          Ebs:
            VolumeSize: 30
            VolumeType: gp3
        - DeviceName: /dev/sdf  # Data volume
          Ebs:
            VolumeSize: 200  # Adjust based on your data needs
            VolumeType: gp3
            DeleteOnTermination: false  # Preserve data
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb'
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          set -e
          exec > /var/log/user-data.log 2>&1
          
          echo "Starting TimescaleDB + API Service setup at $(date)"
          
          # Install Docker and dependencies
          apt-get update -y
          apt-get install -y docker.io docker-compose awscli jq postgresql-client
          systemctl enable docker
          systemctl start docker
          
          # Setup data volume
          DATA_DEVICE=$(lsblk -ndo NAME,SIZE,TYPE -b | \
            awk '$3 == "disk" && $2 > 10737418240 {print "/dev/"$1; exit}')
          
          if [ -z "$DATA_DEVICE" ]; then
            echo "ERROR: Could not find data volume"
            exit 1
          fi
          
          # Format and mount if not already done
          if ! mountpoint -q /data; then
            if ! blkid "$DATA_DEVICE" | grep -q "TYPE="; then
              mkfs.ext4 -F "$DATA_DEVICE"
            fi
            mkdir -p /data
            echo "$DATA_DEVICE /data ext4 defaults,nofail 0 2" >> /etc/fstab
            mount -a
          fi
          # Create directories
          mkdir -p /data/timescaledb /data/api-service
          chmod 777 /data/timescaledb /data/api-service
          
          # Create docker-compose for TimescaleDB + API Service
          cat > /opt/docker-compose.yml <<'COMPOSE_EOF'
          version: '3.8'
          services:
            timescaledb:
              image: timescale/timescaledb:latest-pg17
              container_name: timescaledb
              restart: unless-stopped
              environment:
                POSTGRES_PASSWORD: ${DB_PASSWORD}
                POSTGRES_DB: qed
              ports:
                - "5432:5432"
              volumes:
                - /data/timescaledb:/var/lib/postgresql/data
              healthcheck:
                test: ["CMD-SHELL", "pg_isready -U postgres"]
                interval: 10s
                timeout: 5s
                retries: 5
          api-service:
            image: ${ECR_REPOSITORY_URI}:latest
            container_name: api-service
            restart: unless-stopped
            depends_on:
              timescaledb:
                condition: service_healthy
            ports:
              - "3000:3000"
            environment:
              RUST_LOG: ${RUST_LOG}
            command:
              - api-services
              - --database-url=postgresql://postgres:${DB_PASSWORD}@timescaledb:5432/qed
            logging:
              driver: json-file
              options:
                max-size: "100m"
                max-file: "5"
        COMPOSE_EOF

        # Create secrets file
        cat > /opt/.env <<ENV_EOF
        DB_PASSWORD=your_secure_password_here_change_me
        ECR_REPOSITORY_URI=${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}
        RUST_LOG={{ config.global_services.api_service.env.RUST_LOG | default('info') }}
        ENV_EOF
        
        # Login to ECR
        aws ecr get-login-password --region ${AWS::Region} | \
          docker login --username AWS --password-stdin \
          ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com
        
        # Start services
        cd /opt
        docker-compose --env-file .env up -d
        
        # Wait for TimescaleDB to be ready
        echo "Waiting for TimescaleDB..."
        for i in {1..60}; do
          if docker exec timescaledb pg_isready -U postgres > /dev/null 2>&1; then
            echo "TimescaleDB is ready"
            break
          fi
          echo "Attempt $i/60..."
          sleep 5
        done

        # Run migrations (assumes your image has migrations)
        echo "Running database migrations..."
        docker exec api-service /bin/bash -c "cd /qed-rollup && export DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@timescaledb:5432/qed && /usr/local/bin/sqlx database create || true && /usr/local/bin/sqlx migrate run" || true
        echo "Setup completed at $(date)"

  # TimescaleDB Subnet Group
  TimescaleDBSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    Properties:
      DBSubnetGroupDescription: Subnet group for TimescaleDB
      SubnetIds:
        - !Ref CoordinatorSubnet
        {% if config.nodes.realms|length > 0 %}
        - !Ref Realm{{ config.nodes.realms[0].id }}Subnet
        {% endif %}
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb-subnet-group'

  # Database Password Secret
  DBPasswordSecret:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub '${ProjectName}-${Environment}-db-password'
      Description: Password for TimescaleDB instance
      GenerateSecretString:
        SecretStringTemplate: '{"username": "postgres"}'
        GenerateStringKey: 'password'
        PasswordLength: 32
        ExcludeCharacters: '"@/\'

  # TimescaleDB RDS Instance
  TimescaleDB:
    Type: AWS::RDS::DBInstance
    Properties:
      DBInstanceIdentifier: !Sub '${ProjectName}-${Environment}-timescaledb'
      DBInstanceClass: {{ config.global_services.timescaledb.aws.instance_class }}
      Engine: postgres
      EngineVersion: '15.4'
      AllocatedStorage: {{ config.global_services.timescaledb.aws.allocated_storage }}
      DBSubnetGroupName: !Ref TimescaleDBSubnetGroup
      VPCSecurityGroups:
        - !Ref DatabaseSecurityGroup
      DBName: qed
      MasterUsername: postgres
      {% raw %}
      MasterUserPassword: !Sub '{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}'
      {% endraw %}
      BackupRetentionPeriod: 7
      MultiAZ: {{ config.global_services.timescaledb.aws.multi_az|lower }}
      StorageType: gp3
      DeletionProtection: false
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb'
  {% endif %}

