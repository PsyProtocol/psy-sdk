---
AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol ECS Services - Edge, Worker, Watcher, and API Services'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}

  Environment:
    Type: String
    Default: dev

  # ECS Cluster (from main stack)
  MainECSClusterName:
    Type: String
    Description: Main ECS Cluster name from main stack

  ECRRepositoryURI:
    Type: String
    Description: ECR Repository URI from main stack

  # ALB Target Groups
  ALBTargetGroupCoordinatorArn:
    Type: String
    Description: ALB Target Group ARN for Coordinator

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Type: String
    Description: ALB Target Group ARN for Realm {{ realm.id }}
  {% endfor %}

  TaskExecutionRoleArn:
    Type: String
    Description: ECS Task Execution Role ARN

  TaskRoleArn:
    Type: String
    Description: ECS Task Role ARN

  ServiceDiscoveryNamespaceId:
    Type: String
    Description: Service Discovery Namespace ID from main stack

  # Redis Endpoints
  RedisCoordinatorEndpoint:
    Type: String
    Description: Redis Coordinator endpoint

  {% for realm in config.nodes.realms %}
  RedisRealm{{ realm.id }}Endpoint:
    Type: String
    Description: Redis Realm {{ realm.id }} endpoint
  {% endfor %}

  ALBDNSName:
    Type: String
    Description: Application Load Balancer DNS name

  {# # TimescaleDB Endpoint (if enabled)
  {% if config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled %}
  TimescaleDBEndpoint:
    Type: String
    Description: TimescaleDB RDS endpoint
  {% endif %} #}

  TiKVPDEndpoints:
    Type: String
    Description: Comma-separated list of TiKV PD endpoints
    Default: "127.0.0.1:2379"

  ConfigBucketName:
    Type: String
    Description: Name of the config S3 bucket

Resources:
  # ============================================================================
  # COORDINATOR ECS SERVICES (Edge & Watcher)
  # ============================================================================

  # Coordinator Edge Service
  CoordinatorEdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: coordinator-data
          Host:
            SourcePath: /data/coordinator
      ContainerDefinitions:
        - Name: coordinator-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Download configuration from S3
              CONFIG_URL="https://${ConfigBucketName}.s3.${AWS::Region}.amazonaws.com/config.json"

              echo "Downloading config from: $CONFIG_URL"
              if ! curl -o /qed-rollup/config.json "$CONFIG_URL"; then
                echo "ERROR: Failed to download config from S3, trying base config..."
                CONFIG_URL="https://${ConfigBucketName}.s3.${AWS::Region}.amazonaws.com/config.json"
                if ! curl -o /qed-rollup/config.json "$CONFIG_URL"; then
                  echo "ERROR: Failed to download any config"
                  exit 1
                fi
              fi
              
              echo "Config downloaded successfully"
              # Show network section for debugging
              if command -v jq &> /dev/null; then
                echo "Network configuration:"
                jq '.network.coordinator_configs, .network.realm_configs[].rpc_url' /qed-rollup/config.json 2>/dev/null || true
              fi
            
              # Get TiKV PD endpoints dynamically
              PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
              PD_ENDPOINTS=""

              echo "Fetching TiKV PD endpoints..."
              for attempt in {seq 1 120}; do
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $PD_ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                  --output text \
                  --region ${AWS::Region} 2>/dev/null || echo "")
                
                if [ -n "$PD_INSTANCES" ]; then
                  for pd_id in $PD_INSTANCES; do
                    PD_IP=$(aws ec2 describe-instances \
                      --instance-ids $pd_id \
                      --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                      --output text \
                      --region ${AWS::Region} 2>/dev/null || echo "")
                    
                    if [ -n "$PD_IP" ] && [ "$PD_IP" != "None" ]; then
                      if [ -z "$PD_ENDPOINTS" ]; then
                        PD_ENDPOINTS="$PD_IP:2379"
                      else
                        PD_ENDPOINTS="$PD_ENDPOINTS,$PD_IP:2379"
                      fi
                    fi
                  done
                  if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Got PD endpoints: $PD_ENDPOINTS"
                    break
                  fi
                fi
                
                echo "Waiting for TiKV PD endpoints... attempt $attempt/120"
                sleep 5
              done

              if [ -z "$PD_ENDPOINTS" ]; then
                echo "ERROR: Could not get TiKV PD endpoints, using parameter default"
                PD_ENDPOINTS="${TiKVPDEndpoints}"
              fi

              # Start coordinator-edge
              exec /qed-rollup/qed_rollup_cli coordinator-edge \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator" \
                --redis-uri "redis://${RedisCoordinatorEndpoint}:6379" \
                {% if config.nodes.coordinator.edge.args is defined and 'listen_addr' in config.nodes.coordinator.edge.args %}
                --listen-addr "{{ config.nodes.coordinator.edge.args['listen_addr'] }}" \
                {% else %}
                --listen-addr "0.0.0.0:8545" \
                {% endif %}
                {% for key, value in (config.nodes.coordinator.edge.args | default({}) | dictsort) %}
                {% if key != 'listen_addr' %}
                --{{ key | replace('_','-') }} "{{ value | string }}" \
                {% endif %}
                {% endfor %}

          Environment:
            {% for key, value in (config.nodes.coordinator.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: RedisCoordinatorEndpoint
              Value: !Ref RedisCoordinatorEndpoint
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
          Memory: {{ config.nodes.coordinator.edge.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.edge.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: coordinator-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: 8545
              HostPort: 0
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8545/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120  # Increased to allow time for PD discovery
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-edge
          Essential: true

  CoordinatorEdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorEdgeTaskDefinition
      DesiredCount: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      LoadBalancers:
        - ContainerName: coordinator-edge
          ContainerPort: 8545
          TargetGroupArn: !Ref ALBTargetGroupCoordinatorArn
      HealthCheckGracePeriodSeconds: 120
      ServiceRegistries:
        - RegistryArn: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
          ContainerName: coordinator-edge
          ContainerPort: 8545


  CoordinatorEdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: coordinator-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Coordinator Edge
  CoordinatorEdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${CoordinatorEdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  CoordinatorEdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-coordinator-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref CoordinatorEdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0

  {# # Coordinator Watcher Service
  {% if config.nodes.coordinator.watcher and config.nodes.coordinator.watcher.enabled %}
  CoordinatorWatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: coordinator-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - watcher
            - --node-type
            - coordinator
            - --node-id
            - "0"
            - --database
            - tikv
            - --tikv-pd-endpoints
            - "{{ config.nodes.coordinator.backend.tikv.pd_endpoints | join(',') }}"
            - --tikv-namespace
            - "watcher-coordinator"
            - --redis-url
            - !Sub 'redis://${RedisCoordinatorEndpoint}:6379'
            - --api-endpoint
            - http://api-service:3000
            {% for key, value in (config.nodes.coordinator.watcher.args | default({}) | dictsort) %}
            {% if key not in ['redis-url'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value | string }}'
            {% endif %}
            {% endfor %}
          Environment:
            {% for key, value in (config.nodes.coordinator.watcher.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ config.nodes.coordinator.watcher.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.watcher.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.watcher.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-watcher
          Essential: true

  CoordinatorWatcherService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorWatcherTaskDefinition
      DesiredCount: 1  # Single watcher per partition
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
  {% endif %} #}

  # ============================================================================
  # REALM PROCESSOR ECS SERVICES
  # ============================================================================
    
  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Processor Service
  Realm{{ realm.id }}ProcessorTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'  
      Volumes:
        - Name: realm{{ realm.id }}-processor-data
          Host:
            SourcePath: /data/realm{{ realm.id }}-processor
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-processor
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - /bin/bash
            - -c
            - |
              # Get TiKV PD endpoints dynamically
              PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
              PD_ENDPOINTS=""

              echo "Fetching TiKV PD endpoints for Realm {{ realm.id }} Processor..."
              for attempt in $(seq 1 30); do
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $PD_ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                  --output text \
                  --region ${AWS::Region} 2>/dev/null || echo "")
                
                if [ -n "$PD_INSTANCES" ]; then
                  for pd_id in $PD_INSTANCES; do
                    PD_IP=$(aws ec2 describe-instances \
                      --instance-ids $pd_id \
                      --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                      --output text \
                      --region ${AWS::Region} 2>/dev/null || echo "")
                    
                    if [ -n "$PD_IP" ] && [ "$PD_IP" != "None" ]; then
                      if [ -z "$PD_ENDPOINTS" ]; then
                        PD_ENDPOINTS="$PD_IP:2379"
                      else
                        PD_ENDPOINTS="$PD_ENDPOINTS,$PD_IP:2379"
                      fi
                    fi
                  done
                  
                  if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Got PD endpoints: $PD_ENDPOINTS"
                    # Test connectivity to at least one endpoint
                    for endpoint in $(echo $PD_ENDPOINTS | tr ',' ' '); do
                      if nc -zv ${endpoint%:*} ${endpoint#*:} 2>/dev/null; then
                        echo "Successfully connected to PD endpoint: $endpoint"
                        break 2
                      fi
                    done
                  fi
                fi
                
                echo "Waiting for TiKV PD endpoints... attempt $attempt/30"
                sleep 10
              done

              if [ -z "$PD_ENDPOINTS" ]; then
                echo "ERROR: Could not get TiKV PD endpoints, using parameter default"
                PD_ENDPOINTS="${TiKVPDEndpoints}"
              fi

              # Get Redis endpoint for this realm
              {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"
              {% else %}
              # Use shared Redis if realm doesn't have dedicated one
              REDIS_ENDPOINT="${RedisCoordinatorEndpoint}"
              {% endif %}
              
              echo "Starting Realm {{ realm.id }} Processor with Redis: $REDIS_ENDPOINT and TiKV: $PD_ENDPOINTS"

              # Start realm processor
              exec /qed-rollup/qed_rollup_cli realm-processor \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ realm.backend.tikv.namespace }}" \
                --redis-uri "redis://$REDIS_ENDPOINT:6379" \
                --realm-id {{ realm.id }} \
                {% if realm.processor.args is defined and realm.processor.args['queue-biz-key'] %}
                --queue-biz-key "{{ realm.processor.args['queue-biz-key'] }}" \
                {% endif %}
                {% for key, value in (realm.processor.args | default({}) | dictsort) %}
                {% if key not in ['realm-id', 'queue-biz-key', 'database', 'tikv-pd-endpoints', 'tikv-namespace', 'redis-uri'] %}
                --{{ key | replace('_','-') }} "{{ value | string }}" \
                {% endif %}
                {% endfor %}

          Environment:
            {% for key, value in (realm.processor.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
            - Name: RedisRealm{{ realm.id }}Endpoint
              Value: !Ref RedisRealm{{ realm.id }}Endpoint
            {% else %}
            - Name: RedisCoordinatorEndpoint
              Value: !Ref RedisCoordinatorEndpoint
            {% endif %}
          Memory: {{ realm.processor.aws.memory }}
          MemoryReservation: {{ (realm.processor.aws.memory * 0.75) | int }}
          Cpu: {{ realm.processor.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-processor-data
              ContainerPath: /data
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'ps aux | grep -v grep | grep realm-processor || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-processor
          Essential: true 

  Realm{{ realm.id }}ProcessorService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}ProcessorTaskDefinition
      DesiredCount: 1  # Only one processor per realm
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      PlacementStrategies:
        - Type: spread
          Field: attribute:ecs.availability-zone
        - Type: spread
          Field: instanceId
      ServiceRegistries:
        - RegistryArn: !GetAtt Realm{{ realm.id }}ProcessorServiceDiscovery.Arn
          ContainerName: realm-{{ realm.id }}-processor

  Realm{{ realm.id }}ProcessorServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: realm-{{ realm.id }}-processor
      DnsConfig:
        DnsRecords:
          - Type: A
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # CloudWatch Alarm for Realm {{ realm.id }} Processor
  Realm{{ realm.id }}ProcessorHealthAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor-health'
      AlarmDescription: !Sub 'Alert when Realm {{ realm.id }} processor is unhealthy'
      MetricName: CPUUtilization
      Namespace: AWS/ECS
      Statistic: Average
      Period: 300
      EvaluationPeriods: 2
      Threshold: 90
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: ServiceName
          Value: !GetAtt Realm{{ realm.id }}ProcessorService.Name
        - Name: ClusterName
          Value: !Ref MainECSClusterName
      TreatMissingData: breaching 

  {% endfor %} 
  # ============================================================================
  # REALM ECS SERVICES (Edge & Watcher)
  # ============================================================================

  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Edge Service
  Realm{{ realm.id }}EdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: realm{{ realm.id }}-edge-data
          Host:
            SourcePath: /data/realm{{ realm.id }}-edge
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - /bin/bash
            - -c
            - |
              # Get TiKV PD endpoints dynamically
              PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
              PD_ENDPOINTS=""

              echo "Fetching TiKV PD endpoints for Realm {{ realm.id }} Edge..."
              for attempt in $(seq 1 30); do
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $PD_ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                  --output text \
                  --region ${AWS::Region} 2>/dev/null || echo "")
                
                if [ -n "$PD_INSTANCES" ]; then
                  for pd_id in $PD_INSTANCES; do
                    PD_IP=$(aws ec2 describe-instances \
                      --instance-ids $pd_id \
                      --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                      --output text \
                      --region ${AWS::Region} 2>/dev/null || echo "")
                    
                    if [ -n "$PD_IP" ] && [ "$PD_IP" != "None" ]; then
                      if [ -z "$PD_ENDPOINTS" ]; then
                        PD_ENDPOINTS="$PD_IP:2379"
                      else
                        PD_ENDPOINTS="$PD_ENDPOINTS,$PD_IP:2379"
                      fi
                    fi
                  done
                  
                  if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Got PD endpoints: $PD_ENDPOINTS"
                    break
                  fi
                fi
                
                echo "Waiting for TiKV PD endpoints... attempt $attempt/30"
                sleep 10
              done

              if [ -z "$PD_ENDPOINTS" ]; then
                echo "ERROR: Could not get TiKV PD endpoints, using parameter default"
                PD_ENDPOINTS="${TiKVPDEndpoints}"
              fi

              # Get Redis endpoint for this realm
              {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"
              {% else %}
              # Use shared Redis if realm doesn't have dedicated one
              REDIS_ENDPOINT="${RedisCoordinatorEndpoint}"
              {% endif %}

              echo "Starting Realm {{ realm.id }} Edge with Redis: $REDIS_ENDPOINT and TiKV: $PD_ENDPOINTS"

              # Start realm edge
              exec /qed-rollup/qed_rollup_cli realm-edge \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ realm.backend.tikv.namespace }}" \
                --redis-uri "redis://$REDIS_ENDPOINT:6379" \
                --realm-id {{ realm.id }} \
                --coordinator-addr "http://coordinator-edge.qed.local:8545" \
                {% if realm.edge.args is defined and 'listen_addr' in realm.edge.args %}
                --listen-addr "{{ realm.edge.args['listen_addr'] }}" \
                {% else %}
                --listen-addr "0.0.0.0:{{ 8546 + realm.id }}" \
                {% endif %}
                {% if realm.edge.args is defined and realm.edge.args['queue_biz_key'] %}
                --queue-biz-key "{{ realm.edge.args['queue_biz_key'] }}" \
                {% endif %}
                {% for key, value in (realm.edge.args | default({}) | dictsort) %}
                {% if key not in ['coordinator_addr', 'listen_addr', 'realm-id', 'queue_biz_key', 'database', 'tikv-pd-endpoints', 'tikv-namespace', 'redis-uri'] %}
                --{{ key | replace('_', '-') }} "{{ value }}" \
                {% endif %}
                {% endfor %}

          Environment:
            {% for key, value in (realm.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: MainECSClusterName
              Value: !Ref MainECSClusterName
            {% if realm.redis and realm.redis.aws and realm.redis.aws.deployment_type == 'elasticache' %}
            - Name: RedisRealm{{ realm.id }}Endpoint
              Value: !Ref RedisRealm{{ realm.id }}Endpoint
            {% else %}
            - Name: RedisCoordinatorEndpoint
              Value: !Ref RedisCoordinatorEndpoint
            {% endif %}
          Memory: {{ realm.edge.aws.memory }}
          MemoryReservation: {{ (realm.edge.aws.memory * 0.75) | int }}
          Cpu: {{ realm.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-edge-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: {{ 8546 + realm.id }}
              HostPort: 0  # Dynamic port mapping
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://127.0.0.1:{{ 8546 + realm.id }}/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge
          Essential: true
          DependsOn:
            - ContainerName: wait-for-processor
              Condition: SUCCESS
            - Name: wait-for-processor
              Image: amazon/aws-cli:latest  # Has AWS CLI and dig
              Command:
                - sh
                - -c
                - |
                  echo "Waiting for Realm {{ realm.id }} Processor task..."
                  for i in $(seq 1 60); do
                    RUNNING_TASKS=$(aws ecs list-tasks \
                      --cluster ${MainECSClusterName} \
                      --service-name ${ProjectName}-${Environment}-realm-{{ realm.id }}-processor \
                      --desired-status RUNNING \
                      --region ${AWS::Region} \
                      --query 'taskArns | length(@)' \
                      --output text 2>/dev/null || echo "0")
                    
                    if [ "$RUNNING_TASKS" -ge "1" ]; then
                      echo "Processor task is running!"
                      exit 0
                    fi
                    echo "Attempt $i/60: Waiting for processor task..."
                    sleep 3
                  done
                  echo "Timeout waiting for processor, continuing anyway..."
          Essential: false
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge-init

  Realm{{ realm.id }}EdgeService:
    Type: AWS::ECS::Service
    DependsOn: Realm{{ realm.id }}ProcessorService  # Ensure processor starts first
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}EdgeTaskDefinition
      DesiredCount: {{ realm.edge.aws.ecs.task_count | default(2) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      PlacementStrategies:
        - Type: spread
          Field: attribute:ecs.availability-zone
        - Type: spread
          Field: instanceId
      LoadBalancers:
        - ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ 8546 + realm.id }}
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}Arn
      HealthCheckGracePeriodSeconds: 180
      ServiceRegistries:
        - RegistryArn: !GetAtt Realm{{ realm.id }}EdgeServiceDiscovery.Arn
          ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ 8546 + realm.id }}

  Realm{{ realm.id }}EdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: realm-{{ realm.id }}-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Realm {{ realm.id }} Edge
  Realm{{ realm.id }}EdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ realm.edge.aws.ecs.task_count | default(2) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${Realm{{ realm.id }}EdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  Realm{{ realm.id }}EdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref Realm{{ realm.id }}EdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0  
  {% endfor %}
  {# #Realm {{ realm.id }} Watcher Service
  {% if realm.watcher and realm.watcher.enabled %}
  Realm{{ realm.id }}WatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - watcher
            - --node-type
            - realm
            - --node-id
            - "{{ realm.id }}"
            - --database
            - tikv
            - --tikv-pd-endpoints
            - "{{ realm.backend.tikv.pd_endpoints | join(',') }}"
            - --tikv-namespace
            - "watcher-realm{{ realm.id }}"
            - --redis-url
            - !Sub 'redis://${RedisRealm{{ realm.id }}Endpoint}:6379'
            - --api-endpoint
            - http://api-service:3000
            {% for key, value in (realm.watcher.args | default({}) | dictsort) %}
            {% if key not in ['redis-url'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endif %}
            {% endfor %}
          Environment:
            {% for key, value in (realm.watcher.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ realm.watcher.aws.memory }}
          MemoryReservation: {{ (realm.watcher.aws.memory * 0.75) | int }}
          Cpu: {{ realm.watcher.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-watcher
          Essential: true

  Realm{{ realm.id }}WatcherService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}WatcherTaskDefinition
      DesiredCount: 1  # Single watcher per partition
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-processor'
  {% endif %} 
  {% endfor %}  #}

  # ============================================================================
  # INDEPENDENT WORKER SERVICES
  # ============================================================================
  {% if config.nodes.workers and config.nodes.workers.enabled %}

  WorkerTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-worker'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.workers.aws.cpu }}'
      Memory: '{{ config.nodes.workers.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: worker
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Enable verbose debugging
              set -x

              # Create directory if it doesn't exist (shouldn't be needed since WORKDIR is set)
              mkdir -p /qed-rollup
              cd /qed-rollup

              # Install jq if not available (it should be in your Docker image)
              if ! command -v jq &> /dev/null; then
                apt-get update && apt-get install -y jq
              fi

              # Download latest config from S3
              CONFIG_URL="https://${ConfigBucketName}.s3.${AWS::Region}.amazonaws.com/config.json"
              echo "============================================"
              echo "WORKER CONFIG DOWNLOAD DEBUG"
              echo "============================================"
              echo "Downloading config from: $CONFIG_URL"

              # Download with verbose output
              curl -v -f -o /qed-rollup/config.json "$CONFIG_URL" 2>&1
              
              if [ $? -ne 0 ]; then
                echo "ERROR: Failed to download from primary URL"
                # Try alternative path
                CONFIG_URL="https://${ConfigBucketName}.s3.${AWS::Region}.amazonaws.com/config.json"
                echo "Trying alternative: $CONFIG_URL"
                curl -v -f -o /qed-rollup/config.json "$CONFIG_URL" 2>&1
                
                if [ $? -ne 0 ]; then
                  echo "ERROR: Failed to download config from any location"
                  exit 1
                fi
              fi
  
              # Verify config was downloaded
              if [ ! -f /qed-rollup/config.json ]; then
                echo "ERROR: Failed to download config"
                exit 1
              fi
              echo "============================================"
              echo "FULL CONFIG FILE CONTENT"
              echo "============================================"
              cat /qed-rollup/config.json
              
              echo "============================================"
              echo "WORKER CONFIGURATION SECTION"
              echo "============================================"
              jq '.nodes.workers' /qed-rollup/config.json
              
              echo "============================================"
              echo "EXTRACTING PRIVATE KEY"
              echo "============================================"
              
              echo "Config downloaded successfully:"
              cat /qed-rollup/config.json | jq '.network'

              # Start worker with downloaded config
              exec /qed-rollup/qed_rollup_cli worker \
                --config /qed-rollup/config.json \
                {% for key, value in (config.nodes.workers.args | default({}) | dictsort) %}
                {% if key != 'config' %}
                --{{ key | replace('_', '-') }} '{{ value }}' \
                {% endif %}
                {% endfor %}
              

          Environment:
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            {% for key, value in (config.nodes.workers.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ config.nodes.workers.aws.memory }}
          MemoryReservation: {{ (config.nodes.workers.aws.memory * 0.875) | int }}
          Cpu: {{ config.nodes.workers.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: worker

  WorkerService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-worker'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref WorkerTaskDefinition
      DesiredCount: {{ config.nodes.workers.aws.ecs.task_count }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == worker'
      PlacementStrategies:
        - Type: spread
          Field: instanceId  
      DeploymentConfiguration:
        MaximumPercent: 100      # Don't over-provision
        MinimumHealthyPercent: 66  # Allow rolling updates 

  # Auto Scaling for Worker
  WorkerScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 12  # Max 12 tasks 
      MinCapacity: {{ config.nodes.workers.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${WorkerService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  WorkerScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-worker-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref WorkerScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endif %}


  # ============================================================================
  # GLOBAL API SERVICE
  # ============================================================================
  {# {% if config.global_services and config.global_services.api_service and config.global_services.api_service.enabled %}
  ApiServiceTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-api-service'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      {% if config.global_services.api_service.aws %}
      Cpu: '{{ config.global_services.api_service.aws.cpu }}'
      Memory: '{{ config.global_services.api_service.aws.memory }}'
      {% endif %}
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: api-service
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - qed_api_services
            {% for key, value in (config.global_services.api_service.args | default({}) | dictsort) %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endfor %}
          Environment:
            {% if config.global_services.timescaledb and config.global_services.timescaledb.enabled %}
            - Name: DATABASE_URL
            {% raw %}
              Value: !Sub 'postgresql://postgres:{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}@${TimescaleDBEndpoint}:5432/qed'
            {% endraw %}

            {% endif %}
            {% for key, value in (config.global_services.api_service.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          {% if config.global_services.api_service.aws %}
          Memory: {{ config.global_services.api_service.aws.memory }}
          MemoryReservation: {{ (config.global_services.api_service.aws.memory * 0.75) | int }}
          Cpu: {{ config.global_services.api_service.aws.cpu }}
          {% endif %}
          LinuxParameters:
            InitProcessEnabled: true
          PortMappings:
            - ContainerPort: 3000
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:3000/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: api-service
          Essential: true

  ApiService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-api-service'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ApiServiceTaskDefinition
      {% if config.global_services.api_service.aws and config.global_services.api_service.aws.ecs %}
      DesiredCount: {{ config.global_services.api_service.aws.ecs.task_count | default(1) }}
      {% else %}
      DesiredCount: 1
      {% endif %}
      LaunchType: EC2
      ServiceRegistries:
        - RegistryArn: !GetAtt ApiServiceDiscovery.Arn
          ContainerName: api-service
          ContainerPort: 3000

  ApiServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: api-service
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for API Service
  ApiServiceScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 5
      MinCapacity: 1
      ResourceId: !Sub 'service/${MainECSClusterName}/${ApiService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ApiServiceScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-api-service-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ApiServiceScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0
  {% endif %}

  # ============================================================================
  # PROVER SERVICE (if enabled)
  # ============================================================================
  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-prover'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.prover.aws.cpu }}'
      Memory: '{{ config.nodes.prover.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: prover
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - |
              # Generate config.json dynamically for prover
              cat > /qed-rollup/config.json << 'EOF'
              {
                "network": {
                  "users_per_realm": {{ config.network.users_per_realm }},
                  "global_user_tree_height": {{ config.network.global_user_tree_height }},
                  "realm_user_tree_height": {{ config.network.realm_user_tree_height }},
                  "realm_configs": [
                    {% for realm in config.nodes.realms %}
                    {
                      "id": {{ realm.id }},
                      "rpc_url": ["http://realm-{{ realm.id }}-edge.qed.local:{{ 8546 + realm.id }}"]
                    }{{ "," if not loop.last }}
                    {% endfor %}
                  ],
                  "coordinator_configs": [
                    {
                      "id": 0,
                      "rpc_url": ["http://coordinator-edge.qed.local:8545"]
                    }
                  ],
                  "prove_proxy_url": "http://prover.qed.local:9999"
                }
              }
              EOF
              # Start the prover service
              cd /qed-rollup && ./qed_user_cli local-prover {% for key, value in config.nodes.prover.args | dictsort %}--{{ key | replace('_', '-') }} '{{ value }}' {% endfor %}
          Environment:
            {% for key, value in (config.nodes.prover.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          PortMappings:
            - ContainerPort: 9999
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:9999/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: prover

  # Prover Service with dedicated placement
  ProverService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-prover'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ProverTaskDefinition
      DesiredCount: {{ config.nodes.prover.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-edge'  # Run on coordinator edge instances
      ServiceRegistries:
        - RegistryArn: !GetAtt ProverServiceDiscovery.Arn
          ContainerName: prover
          ContainerPort: 9999

  ProverServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: prover
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Prover
  ProverScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: 1
      ResourceId: !Sub 'service/${MainECSClusterName}/${ProverService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ProverScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-prover-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ProverScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endif %} #}

Outputs:
  # Coordinator Service Outputs
  CoordinatorEdgeServiceName:
    Value: !Ref CoordinatorEdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-service'

  {# {% if config.nodes.coordinator.watcher and config.nodes.coordinator.watcher.enabled %}
  CoordinatorWatcherServiceName:
    Value: !Ref CoordinatorWatcherService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-watcher-service'
  {% endif %} #}

  # Realm Service Outputs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeServiceName:
    Value: !Ref Realm{{ realm.id }}EdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-service'

  {# {% if realm.watcher and realm.watcher.enabled %}
  Realm{{ realm.id }}WatcherServiceName:
    Value: !Ref Realm{{ realm.id }}WatcherService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher-service'
  {% endif %} #}
  {% endfor %}

  # Independent Worker Outputs
  {% if config.nodes.workers and config.nodes.workers.enabled %}
  WorkerServiceName:
    Value: !Ref WorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-worker-service'
    Description: Worker Service Name

  WorkerServiceArn:
    Value: !Ref WorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-worker-service-arn'
    Description: Worker Service ARN
  {% endif %}

  # Global Service Outputs
  {# {% if config.global_services and config.global_services.api_service and config.global_services.api_service.enabled %}
  ApiServiceName:
    Value: !Ref ApiService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service'

  ApiServiceDiscoveryArn:
    Value: !GetAtt ApiServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service-sd'
  {% endif %} #}

  # Service Discovery
  CoordinatorEdgeServiceDiscoveryArn:
    Value: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-sd'

  {# {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverServiceName:
    Value: !Ref ProverService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-service'

  ProverServiceDiscoveryArn:
    Value: !GetAtt ProverServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-sd'
  {% endif %} #}


  