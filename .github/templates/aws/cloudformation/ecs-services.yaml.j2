AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol ECS Services - Edge, Worker, Watcher, and API Services'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}

  Environment:
    Type: String
    Default: dev

  # ECS Cluster (from main stack)
  MainECSClusterName:
    Type: String
    Description: Main ECS Cluster name from main stack

  ECRRepositoryURI:
    Type: String
    Description: ECR Repository URI from main stack

  # ALB Target Groups
  ALBTargetGroupCoordinatorArn:
    Type: String
    Description: ALB Target Group ARN for Coordinator

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Type: String
    Description: ALB Target Group ARN for Realm {{ realm.id }}
  {% endfor %}

  TaskExecutionRoleArn:
    Type: String
    Description: ECS Task Execution Role ARN

  TaskRoleArn:
    Type: String
    Description: ECS Task Role ARN

  ServiceDiscoveryNamespaceId:
    Type: String
    Description: Service Discovery Namespace ID from main stack

  # Redis Endpoints
  RedisCoordinatorEndpoint:
    Type: String
    Description: Redis Coordinator endpoint

  {% for realm in config.nodes.realms %}
  RedisRealm{{ realm.id }}Endpoint:
    Type: String
    Description: Redis Realm {{ realm.id }} endpoint
  {% endfor %}

  ALBDNSName:
    Type: String
    Description: Application Load Balancer DNS name

  # TimescaleDB Endpoint (if enabled)
  {% if config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled %}
  TimescaleDBEndpoint:
    Type: String
    Description: TimescaleDB RDS endpoint
  {% endif %}

Resources:
  # ============================================================================
  # COORDINATOR ECS SERVICES (Edge & Watcher)
  # ============================================================================

  # Coordinator Edge Service
  CoordinatorEdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: coordinator-data
          Host:
            SourcePath: /data/coordinator
      ContainerDefinitions:
        - Name: coordinator-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - |
              # Get TiKV PD endpoints dynamically
              MAX_RETRIES=10
              RETRY_COUNT=0

              while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
                PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                  --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                  --output text \
                  --region ${AWS::Region} 2>/dev/null || echo "")

                if [ -n "$PD_INSTANCE_IDS" ]; then
                  PD_ENDPOINTS=""
                  for id in $PD_INSTANCE_IDS; do
                    IP=$(aws ec2 describe-instances \
                      --instance-ids $id \
                      --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                      --output text \
                      --region ${AWS::Region})
                    if [ -n "$IP" ]; then
                      if [ -z "$PD_ENDPOINTS" ]; then
                        PD_ENDPOINTS="$IP:2379"
                      else
                        PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                      fi
                    fi
                  done

                  if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                    break
                  fi
                fi

                echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
                RETRY_COUNT=$((RETRY_COUNT + 1))
                sleep 30
              done

              if [ -z "$PD_ENDPOINTS" ]; then
                echo "ERROR: Failed to get TiKV PD endpoints"
                exit 1
              fi

              # Start coordinator-edge with dynamic endpoints
              exec /qed-rollup/target/release/qed_rollup_cli coordinator-edge \
                --database tikv \
                --tikv-pd-endpoints $PD_ENDPOINTS \
                --tikv-namespace "{{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator" \
                --redis-uri redis://${RedisCoordinatorEndpoint}:6379 \
                {% if config.nodes.coordinator.edge.args is defined and 'listen_addr' in config.nodes.coordinator.edge.args %}
                --listen-addr '{{ config.nodes.coordinator.edge.args["listen_addr"] }}' \
                {% else %}
                --listen-addr 0.0.0.0:8545 \
                {% endif %}
                {% for key, value in (config.nodes.coordinator.edge.args | default({}) | dictsort) %}
                {% if key != 'listen_addr' %}
                --{{ key | replace('_','-') }} '{{ value | string }}' \
                {% endif %}
                {% endfor %}

          Environment:
            {% for key, value in (config.nodes.coordinator.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
          Memory: {{ config.nodes.coordinator.edge.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.edge.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: coordinator-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: 8545
              HostPort: 0
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8545/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120  # Increased to allow time for PD discovery
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-edge
          Essential: true

  CoordinatorEdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorEdgeTaskDefinition
      DesiredCount: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-edge'
      LoadBalancers:
        - ContainerName: coordinator-edge
          ContainerPort: 8545
          TargetGroupArn: !Ref ALBTargetGroupCoordinatorArn
      HealthCheckGracePeriodSeconds: 120
      ServiceRegistries:
        - RegistryArn: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
          ContainerName: coordinator-edge
          ContainerPort: 8545

  CoordinatorEdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: coordinator-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Coordinator Edge
  CoordinatorEdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${CoordinatorEdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  CoordinatorEdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-coordinator-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref CoordinatorEdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0
  # Coordinator Watcher Service
  {% if config.nodes.coordinator.watcher and config.nodes.coordinator.watcher.enabled %}
  CoordinatorWatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: coordinator-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - watcher
            - --node-type
            - coordinator
            - --node-id
            - "0"
            - --database
            - tikv
            - --tikv-pd-endpoints
            - "{{ config.nodes.coordinator.backend.tikv.pd_endpoints | join(',') }}"
            - --tikv-namespace
            - "watcher-coordinator"
            - --redis-url
            - !Sub 'redis://${RedisCoordinatorEndpoint}:6379'
            - --api-endpoint
            - http://api-service:3000
            {% for key, value in (config.nodes.coordinator.watcher.args | default({}) | dictsort) %}
            {% if key not in ['redis-url'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value | string }}'
            {% endif %}
            {% endfor %}
          Environment:
            {% for key, value in (config.nodes.coordinator.watcher.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ config.nodes.coordinator.watcher.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.watcher.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.watcher.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-watcher
          Essential: true

  CoordinatorWatcherService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorWatcherTaskDefinition
      DesiredCount: 1  # Single watcher per partition
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-processor'
  {% endif %}

  # ============================================================================
  # REALM ECS SERVICES (Edge & Watcher)
  # ============================================================================

  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Edge Service
  Realm{{ realm.id }}EdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ realm.edge.aws.cpu }}'
      Memory: '{{ realm.edge.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: realm{{ realm.id }}-data
          Host:
            SourcePath: /data/realm{{ realm.id }}
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - realm-edge
            - --database
            - tikv
            - --tikv-pd-endpoints
            - "{{ realm.backend.tikv.pd_endpoints | join(',') }}"
            - --tikv-namespace
            - "{{ realm.backend.tikv.namespace }}-realm{{ realm.id }}"
            - --redis-uri
            - !Sub 'redis://${RedisRealm{{ realm.id }}Endpoint}:6379'
            - --realm-id
            - '{{ realm.id }}'
            - --coordinator-addr
            - 'http://coordinator-edge.qed.local:8545'
            {% if realm.edge.args is defined and 'listen_addr' in realm.edge.args %}
            - --listen-addr
            - '{{ realm.edge.args["listen_addr"] }}'
            {% else %}
            - --listen-addr
            - '0.0.0.0:{{ 8546 + realm.id }}'
            {% endif %}
            {% for key, value in (realm.edge.args | default({}) | dictsort) %}
            {% if key not in ['coordinator_addr', 'listen_addr'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endif %}
            {% endfor %}
          Environment:
            {% for key, value in (realm.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: {{ 8546 + realm.id }}
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:{{ 8546 + realm.id }}/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge

  Realm{{ realm.id }}EdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}EdgeTaskDefinition
      DesiredCount: {{ realm.edge.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-processor'
      LoadBalancers:
        - ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ 8546 + realm.id }}
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}Arn
      HealthCheckGracePeriodSeconds: 120

  # Auto Scaling for Realm {{ realm.id }} Edge
  Realm{{ realm.id }}EdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ realm.edge.aws.ecs.task_count | default(1) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${Realm{{ realm.id }}EdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  Realm{{ realm.id }}EdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref Realm{{ realm.id }}EdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0

  # Realm {{ realm.id }} Watcher Service
  {% if realm.watcher and realm.watcher.enabled %}
  Realm{{ realm.id }}WatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - watcher
            - --node-type
            - realm
            - --node-id
            - "{{ realm.id }}"
            - --database
            - tikv
            - --tikv-pd-endpoints
            - "{{ realm.backend.tikv.pd_endpoints | join(',') }}"
            - --tikv-namespace
            - "watcher-realm{{ realm.id }}"
            - --redis-url
            - !Sub 'redis://${RedisRealm{{ realm.id }}Endpoint}:6379'
            - --api-endpoint
            - http://api-service:3000
            {% for key, value in (realm.watcher.args | default({}) | dictsort) %}
            {% if key not in ['redis-url'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endif %}
            {% endfor %}
          Environment:
            {% for key, value in (realm.watcher.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ realm.watcher.aws.memory }}
          MemoryReservation: {{ (realm.watcher.aws.memory * 0.75) | int }}
          Cpu: {{ realm.watcher.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-watcher
          Essential: true

  Realm{{ realm.id }}WatcherService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}WatcherTaskDefinition
      DesiredCount: 1  # Single watcher per partition
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-processor'
  {% endif %}
  {% endfor %}

  # ============================================================================
  # INDEPENDENT WORKER SERVICES
  # ============================================================================
  {% if config.nodes.workers and config.nodes.workers.enabled %}
  {% for pool in config.nodes.workers.worker_pools %}
  # Independent Worker Pool {{ loop.index }}
  WorkerPool{{ loop.index }}TaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-worker-pool-{{ loop.index }}'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
     {% if pool.aws %}
      Cpu: '{{ pool.aws.cpu }}'
      Memory: '{{ pool.aws.memory }}'
      {% endif %}
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: config
          Host:
            SourcePath: /etc/qed
      ContainerDefinitions:
        - Name: worker-pool-{{ loop.index }}
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/sh
            - -c
          Command:
            - |
              # Generate config.json dynamically with service discovery URLs
              cat > /app/config.json << 'EOF'
              {
                "network": {
                  "coordinator_configs": [
                    {
                      "id": 0,
                      "rpc_url": ["http://coordinator-edge.qed.local:8545"]
                    }
                  ],
                  "realm_configs": [
                   {% for realm in config.nodes.realms %}
                    {
                      "id": {{ realm.id }},
                      "rpc_url": ["http://realm-{{ realm.id }}-edge.qed.local:{{ 8546 + realm.id }}"]
                    }{% if not loop.last %},{% endif %}
                   {% endfor %}
                  ]
                }
              }
              EOF

              # Start worker with generated config
              exec /qed-rollup/target/release/qed_rollup_cli worker \
                --config /app/config.json \
                {% for key, value in (pool.args | default({}) | dictsort) %}
                --{{ key | replace('_', '-') }} '{{ value }}' \
                {% endfor %}

          Environment:
           {% for key, value in (pool.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
           {% endfor %}
            # Add API service endpoint for worker reporting
            - Name: API_SERVICE_URL
              Value: 'http://api-service.qed.local:3000'
          MountPoints:
            - SourceVolume: config
              ContainerPath: /app
              ReadOnly: false
         {% if pool.aws %}
          Memory: {{ pool.aws.memory }}
          MemoryReservation: {{ (pool.aws.memory * 0.75) | int }}
          Cpu: {{ pool.aws.cpu }}
         {% endif %}
          LinuxParameters:
            InitProcessEnabled: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: worker-pool-{{ loop.index }}
          Essential: true

  WorkerPool{{ loop.index }}Service:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-worker-pool-{{ loop.index }}'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref WorkerPool{{ loop.index }}TaskDefinition
     {% if pool.aws and pool.aws.ecs %}
      DesiredCount: {{ pool.aws.ecs.task_count | default(pool.instances) }}
     {% else %}
      DesiredCount: {{ pool.instances }}
     {% endif %}
      LaunchType: EC2
      # Workers don't need placement constraints, they can run on any instance

  # Auto Scaling for Worker Pool {{ loop.index }}
  WorkerPool{{ loop.index }}ScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 20
      {% if pool.aws and pool.aws.ecs %}
      MinCapacity: {{ pool.aws.ecs.task_count | default(pool.instances) }}
      {% else %}
      MinCapacity: {{ pool.instances }}
      {% endif %}
      ResourceId: !Sub 'service/${MainECSClusterName}/${WorkerPool{{ loop.index }}Service.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  WorkerPool{{ loop.index }}ScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-worker-pool-{{ loop.index }}-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref WorkerPool{{ loop.index }}ScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endfor %}
  {% endif %}

  # ============================================================================
  # GLOBAL API SERVICE
  # ============================================================================
  {% if config.global_services and config.global_services.api_service and config.global_services.api_service.enabled %}
  ApiServiceTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-api-service'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      {% if config.global_services.api_service.aws %}
      Cpu: '{{ config.global_services.api_service.aws.cpu }}'
      Memory: '{{ config.global_services.api_service.aws.memory }}'
      {% endif %}
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: api-service
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - qed_api_services
            {% for key, value in (config.global_services.api_service.args | default({}) | dictsort) %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endfor %}
          Environment:
            {% if config.global_services.timescaledb and config.global_services.timescaledb.enabled %}
            - Name: DATABASE_URL
            {% raw %}
              Value: !Sub 'postgresql://postgres:{{resolve:secretsmanager:${DBPasswordSecret}:SecretString:password}}@${TimescaleDBEndpoint}:5432/qed'
            {% endraw %}

            {% endif %}
            {% for key, value in (config.global_services.api_service.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          {% if config.global_services.api_service.aws %}
          Memory: {{ config.global_services.api_service.aws.memory }}
          MemoryReservation: {{ (config.global_services.api_service.aws.memory * 0.75) | int }}
          Cpu: {{ config.global_services.api_service.aws.cpu }}
          {% endif %}
          LinuxParameters:
            InitProcessEnabled: true
          PortMappings:
            - ContainerPort: 3000
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:3000/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: api-service
          Essential: true

  ApiService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-api-service'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ApiServiceTaskDefinition
      {% if config.global_services.api_service.aws and config.global_services.api_service.aws.ecs %}
      DesiredCount: {{ config.global_services.api_service.aws.ecs.task_count | default(1) }}
      {% else %}
      DesiredCount: 1
      {% endif %}
      LaunchType: EC2
      ServiceRegistries:
        - RegistryArn: !GetAtt ApiServiceDiscovery.Arn
          ContainerName: api-service
          ContainerPort: 3000

  ApiServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: api-service
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for API Service
  ApiServiceScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 5
      MinCapacity: 1
      ResourceId: !Sub 'service/${MainECSClusterName}/${ApiService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ApiServiceScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-api-service-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ApiServiceScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0
  {% endif %}

  # ============================================================================
  # PROVER SERVICE (if enabled)
  # ============================================================================
  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-prover'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.prover.aws.cpu }}'
      Memory: '{{ config.nodes.prover.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: prover
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - |
              # Generate config.json dynamically for prover
              cat > /qed-rollup/config.json << 'EOF'
              {
                "network": {
                  "users_per_realm": {{ config.network.users_per_realm }},
                  "global_user_tree_height": {{ config.network.global_user_tree_height }},
                  "realm_user_tree_height": {{ config.network.realm_user_tree_height }},
                  "realm_configs": [
                    {% for realm in config.nodes.realms %}
                    {
                      "id": {{ realm.id }},
                      "rpc_url": ["http://realm-{{ realm.id }}-edge.qed.local:{{ 8546 + realm.id }}"]
                    }{{ "," if not loop.last }}
                    {% endfor %}
                  ],
                  "coordinator_configs": [
                    {
                      "id": 0,
                      "rpc_url": ["http://coordinator-edge.qed.local:8545"]
                    }
                  ],
                  "prove_proxy_url": "http://prover.qed.local:9999"
                }
              }
              EOF
              # Start the prover service
              cd /qed-rollup && ./qed_user_cli local-prover {% for key, value in config.nodes.prover.args | dictsort %}--{{ key | replace('_', '-') }} '{{ value }}' {% endfor %}
          Environment:
            {% for key, value in (config.nodes.prover.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          PortMappings:
            - ContainerPort: 8888
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8888/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: prover

  ProverService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-prover'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ProverTaskDefinition
      DesiredCount: {{ config.nodes.prover.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-edge'  # Run on coordinator edge instances
      ServiceRegistries:
        - RegistryArn: !GetAtt ProverServiceDiscovery.Arn
          ContainerName: prover
          ContainerPort: 8888

  ProverServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: prover
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Prover
  ProverScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: 1
      ResourceId: !Sub 'service/${MainECSClusterName}/${ProverService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ProverScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-prover-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ProverScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endif %}

Outputs:
  # Coordinator Service Outputs
  CoordinatorEdgeServiceName:
    Value: !Ref CoordinatorEdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-service'

  {% if config.nodes.coordinator.watcher and config.nodes.coordinator.watcher.enabled %}
  CoordinatorWatcherServiceName:
    Value: !Ref CoordinatorWatcherService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-watcher-service'
  {% endif %}

  # Realm Service Outputs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeServiceName:
    Value: !Ref Realm{{ realm.id }}EdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-service'

  {% if realm.watcher and realm.watcher.enabled %}
  Realm{{ realm.id }}WatcherServiceName:
    Value: !Ref Realm{{ realm.id }}WatcherService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher-service'
  {% endif %}
  {% endfor %}

  # Independent Worker Outputs
  {% if config.nodes.workers and config.nodes.workers.enabled %}
  {% for pool in config.nodes.workers.worker_pools %}
  WorkerPool{{ loop.index }}ServiceName:
    Value: !Ref WorkerPool{{ loop.index }}Service
    Export:
      Name: !Sub '${ProjectName}-${Environment}-worker-pool-{{ loop.index }}-service'
  {% endfor %}
  {% endif %}

  # Global Service Outputs
  {% if config.global_services and config.global_services.api_service and config.global_services.api_service.enabled %}
  ApiServiceName:
    Value: !Ref ApiService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service'

  ApiServiceDiscoveryArn:
    Value: !GetAtt ApiServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-api-service-sd'
  {% endif %}

  # Service Discovery
  CoordinatorEdgeServiceDiscoveryArn:
    Value: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-sd'

  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverServiceName:
    Value: !Ref ProverService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-service'

  ProverServiceDiscoveryArn:
    Value: !GetAtt ProverServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-sd'
  {% endif %}