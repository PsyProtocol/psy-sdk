AWSTemplateFormatVersion: '2010-09-09'
Description: 'QED Protocol ECS Services - Edge and Worker Services Only (Processors run on EC2)'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}

  Environment:
    Type: String
    Default: dev

  # ECS Cluster (from main stack)
  MainECSClusterName:
    Type: String
    Description: Main ECS Cluster name from main stack

  ECRRepositoryURI:
    Type: String
    Description: ECR Repository URI from main stack

  # ALB Target Groups
  ALBTargetGroupCoordinatorArn:
    Type: String
    Description: ALB Target Group ARN for Coordinator

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Type: String
    Description: ALB Target Group ARN for Realm {{ realm.id }}
  {% endfor %}

  TaskExecutionRoleArn:
    Type: String
    Description: ECS Task Execution Role ARN

  TaskRoleArn:
    Type: String
    Description: ECS Task Role ARN

  ServiceDiscoveryNamespaceId:
    Type: String
    Description: Service Discovery Namespace ID from main stack

  # Redis Endpoints
  RedisCoordinatorEndpoint:
    Type: String
    Description: Redis Coordinator NLB endpoint

  {% for realm in config.nodes.realms %}
  RedisRealm{{ realm.id }}Endpoint:
    Type: String
    Description: Redis Realm {{ realm.id }} NLB endpoint
  {% endfor %}

  ALBDNSName:
    Type: String
    Description: Application Load Balancer DNS name

Resources:
  # ============================================================================
  # COORDINATOR ECS SERVICES (Edge & Worker only)
  # ============================================================================

  # Coordinator Edge Service
  CoordinatorEdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: coordinator-data
          Host:
            SourcePath: /data/coordinator
      ContainerDefinitions:
        - Name: coordinator-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - coordinator-edge
            - --database
            - lmdbx
            - --lmdbx-path
            - /data  # Mounted from processor instance
            - --redis-uri
            - !Sub 'redis://${RedisCoordinatorEndpoint}:6379'
            - --listen-addr
            - '0.0.0.0:8545'
          Environment:
            - Name: RUST_LOG
              Value: '{{ config.nodes.coordinator.edge.env.RUST_LOG }}'
          Memory: {{ config.nodes.coordinator.edge.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.edge.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: coordinator-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: 8545
              HostPort: 0
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8545/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-edge
          Essential: true

  CoordinatorEdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorEdgeTaskDefinition
      DesiredCount: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-processor'
      LoadBalancers:
        - ContainerName: coordinator-edge
          ContainerPort: 8545
          TargetGroupArn: !Ref ALBTargetGroupCoordinatorArn
      HealthCheckGracePeriodSeconds: 60
      ServiceRegistries:
        - RegistryArn: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
          ContainerName: coordinator-edge
          ContainerPort: 8545

  CoordinatorEdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: coordinator-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Coordinator Edge
  CoordinatorEdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${CoordinatorEdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  CoordinatorEdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-coordinator-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref CoordinatorEdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0

  # Coordinator Worker Service
  CoordinatorWorkerTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-worker'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: coordinator-worker
          Memory: {{ config.nodes.coordinator.worker.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.worker.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.worker.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - coordinator-worker
            - --redis-uri
            - !Sub 'redis://${RedisCoordinatorEndpoint}:6379'
          Environment:
            - Name: RUST_LOG
              Value: '{{ config.nodes.coordinator.worker.env.RUST_LOG }}'
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-worker
          Essential: true

  CoordinatorWorkerService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-worker'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorWorkerTaskDefinition
      DesiredCount: {{ config.nodes.coordinator.worker.aws.ecs.task_count }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-worker'

  # Auto Scaling for Coordinator Worker
  CoordinatorWorkerScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ config.nodes.coordinator.worker.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${CoordinatorWorkerService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  CoordinatorWorkerScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-coordinator-worker-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref CoordinatorWorkerScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0

  # ============================================================================
  # REALM ECS SERVICES (Edge & Worker only)
  # ============================================================================

  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Edge Service
  Realm{{ realm.id }}EdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ realm.edge.aws.cpu }}'
      Memory: '{{ realm.edge.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: realm{{ realm.id }}-data
          Host:
            SourcePath: /data/realm{{ realm.id }}
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - realm-edge
            - --database
            - lmdbx
            - --lmdbx-path
            - /data  # Mounted from processor instance
            - --redis-uri
            - !Sub 'redis://${RedisRealm{{ realm.id }}Endpoint}:6379'
            - --realm-id
            - '{{ realm.id }}'
            - --coordinator-addr
            - 'http://coordinator-edge.qed.local:{{ config.nodes.coordinator.edge.aws.load_balancer.port }}'
            - --listen-addr
            - '0.0.0.0:{{ realm.edge.aws.load_balancer.port }}'
            {% for key, value in realm.edge.args | items %}
            {% if key not in ['coordinator_addr', 'listen_addr'] %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endif %}
            {% endfor %}
          Environment:
            - Name: RUST_LOG
              Value: '{{ realm.edge.env.RUST_LOG }}'
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-data
              ContainerPath: /data
          PortMappings:
            - ContainerPort: {{ realm.edge.aws.load_balancer.port }}
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:{{ realm.edge.aws.load_balancer.port }}{{ realm.edge.aws.load_balancer.health_check_path }} || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge

  Realm{{ realm.id }}EdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}EdgeTaskDefinition
      DesiredCount: {{ realm.edge.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-processor'
      LoadBalancers:
        - ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ realm.edge.aws.load_balancer.port }}
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}Arn
      HealthCheckGracePeriodSeconds: 120

  # Auto Scaling for Realm {{ realm.id }} Edge
  Realm{{ realm.id }}EdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ realm.edge.aws.ecs.task_count | default(1) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${Realm{{ realm.id }}EdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  Realm{{ realm.id }}EdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref Realm{{ realm.id }}EdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0

  # Realm {{ realm.id }} Worker Service
  Realm{{ realm.id }}WorkerTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ realm.worker.aws.cpu }}'
      Memory: '{{ realm.worker.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-worker
          Image: !Sub '${ECRRepositoryURI}:latest'
          Command:
            - realm-worker
            - --redis-uri
            - !Sub 'redis://${RedisRealm{{ realm.id }}Endpoint}:6379'
            {% for key, value in realm.worker.args | items %}
            - --{{ key | replace('_', '-') }}
            - '{{ value }}'
            {% endfor %}
          Environment:
            - Name: RUST_LOG
              Value: '{{ realm.worker.env.RUST_LOG }}'
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-worker

  Realm{{ realm.id }}WorkerService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}WorkerTaskDefinition
      DesiredCount: {{ realm.worker.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == realm-{{ realm.id }}-worker'

  # Auto Scaling for Realm {{ realm.id }} Worker
  Realm{{ realm.id }}WorkerScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 20
      MinCapacity: {{ realm.worker.aws.ecs.task_count | default(1) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${Realm{{ realm.id }}WorkerService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  Realm{{ realm.id }}WorkerScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref Realm{{ realm.id }}WorkerScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endfor %}

  # ============================================================================
  # PROVER SERVICE (if enabled)
  # ============================================================================
  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-prover'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.prover.aws.cpu }}'
      Memory: '{{ config.nodes.prover.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: prover
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - |
              # Generate config.json dynamically for prover
              cat > /qed-rollup/config.json << 'EOF'
              {
                "network": {
                  "users_per_realm": {{ config.network.users_per_realm }},
                  "global_user_tree_height": {{ config.network.global_user_tree_height }},
                  "realm_user_tree_height": {{ config.network.realm_user_tree_height }},
                  "realm_configs": [
                    {% for realm in config.nodes.realms %}
                    {
                      "id": {{ realm.id }},
                      "rpc_url": ["http://realm-{{ realm.id }}-edge.qed.local:{{ realm.edge.aws.load_balancer.port }}"]
                    }{{ "," if not loop.last }}
                    {% endfor %}
                  ],
                  "coordinator_configs": [
                    {
                      "id": 0,
                      "rpc_url": ["http://coordinator-edge.qed.local:8545"]
                    }
                  ],
                  "prover_url": "http://prover.qed.local:8888"
                }
              }
              EOF
              # Start the prover service
              cd /qed-rollup && ./qed_user_cli local-prover {% for key, value in config.nodes.prover.args | items %}--{{ key | replace('_', '-') }} '{{ value }}' {% endfor %}
          Environment:
            - Name: RUST_LOG
              Value: '{{ config.nodes.prover.env.RUST_LOG }}'
          PortMappings:
            - ContainerPort: 8888
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -f http://localhost:8888/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: prover

  ProverService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-prover'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ProverTaskDefinition
      DesiredCount: {{ config.nodes.prover.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:service == coordinator-edge'  # Run on coordinator edge instances
      ServiceRegistries:
        - RegistryArn: !GetAtt ProverServiceDiscovery.Arn
          ContainerName: prover
          ContainerPort: 8888

  ProverServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: prover
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Prover
  ProverScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: 1
      ResourceId: !Sub 'service/${MainECSClusterName}/${ProverService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ProverScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-prover-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ProverScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endif %}

Outputs:
  # Coordinator Service Outputs
  CoordinatorEdgeServiceName:
    Value: !Ref CoordinatorEdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-service'

  CoordinatorWorkerServiceName:
    Value: !Ref CoordinatorWorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-worker-service'

  # Realm Service Outputs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeServiceName:
    Value: !Ref Realm{{ realm.id }}EdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-service'

  Realm{{ realm.id }}WorkerServiceName:
    Value: !Ref Realm{{ realm.id }}WorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-worker-service'
  {% endfor %}

  # Service Discovery
  CoordinatorEdgeServiceDiscoveryArn:
    Value: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-sd'
