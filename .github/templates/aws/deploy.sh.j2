#!/bin/bash
set -e

# AWS Deployment Script for QED Protocol
# Generated from config.json

# Change to script directory
cd "$(dirname "$0")"

PROJECT_NAME="{{ config.nodes.deployment.aws.project_name }}"
REGION="{{ config.nodes.deployment.aws.region }}"
ECR_REPOSITORY="{{ config.nodes.deployment.aws.ecr.repository_name }}"
CLUSTER_NAME="{{ config.nodes.deployment.aws.ecs.cluster_name }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_debug() {
    echo -e "${BLUE}[DEBUG]${NC} $1"
}

# Function to show help
show_help() {
    cat << EOF
Usage: $0 [COMMAND] [OPTIONS]

Commands:
    deploy              Deploy the full QED Protocol infrastructure
    destroy             Destroy all infrastructure
    cleanup             Clean up orphaned resources
    status              Show deployment status
    build               Build and push Docker image only
    update-services     Update ECS services with new image
    monitor             Monitor deployment progress
    logs                Show CloudWatch logs

Options:
    --force             Force operation without confirmation
    --skip-build        Skip Docker build step
    --tag TAG           Use specific Docker image tag (default: latest)
    --profile PROFILE   AWS profile to use
    --verbose           Enable verbose output
    --dry-run           Show what would be done without executing

Examples:
    $0 deploy                    # Deploy everything
    $0 deploy --skip-build       # Deploy without rebuilding Docker image
    $0 destroy --force           # Destroy without confirmation
    $0 cleanup                   # Clean up orphaned resources
    $0 status                    # Check deployment status
    $0 logs coordinator-processor # Show logs for a specific service

EOF
}

# Function to check if AWS CLI is configured
check_aws_cli() {
    if ! command -v aws &> /dev/null; then
        log_error "AWS CLI is not installed. Please install it first."
        exit 1
    fi
    
    # Check AWS credentials
    if ! aws sts get-caller-identity &> /dev/null; then
        log_error "AWS credentials not configured. Please run 'aws configure'"
        exit 1
    fi
    
    # Get AWS account ID
    AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
    if [ -z "$AWS_ACCOUNT_ID" ]; then
        log_error "Failed to get AWS account ID."
        exit 1
    fi
    
    ECR_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com/${ECR_REPOSITORY}"
}

# Function to cleanup EBS volumes
cleanup_ebs_volumes() {
    log_info "Cleaning up orphaned EBS volumes..."
    
    # Find volumes tagged with our project that are available (not attached)
    ORPHANED_VOLUMES=$(aws ec2 describe-volumes \
        --filters "Name=status,Values=available" \
                  "Name=tag:Project,Values=${PROJECT_NAME}" \
        --query "Volumes[].VolumeId" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$ORPHANED_VOLUMES" ]; then
        log_warning "Found orphaned EBS volumes: $ORPHANED_VOLUMES"
        
        if [ "$DRY_RUN" = true ]; then
            log_info "[DRY RUN] Would delete volumes: $ORPHANED_VOLUMES"
        else
            for volume in $ORPHANED_VOLUMES; do
                log_info "Deleting volume: $volume"
                aws ec2 delete-volume --volume-id "$volume" --region "${REGION}" || \
                    log_warning "Failed to delete volume: $volume"
            done
        fi
    else
        log_info "No orphaned EBS volumes found"
    fi
}

# Function to check if stack exists
check_stack_exists() {
    local stack_name=$1
    aws cloudformation describe-stacks \
        --stack-name "$stack_name" \
        --region "${REGION}" &> /dev/null
}

# Function to get stack status
get_stack_status() {
    local stack_name=$1
    aws cloudformation describe-stacks \
        --stack-name "$stack_name" \
        --query "Stacks[0].StackStatus" \
        --output text \
        --region "${REGION}" 2>/dev/null || echo "DOES_NOT_EXIST"
}

# Function to cleanup ElastiCache clusters
cleanup_elasticache() {
    log_info "Checking for ElastiCache clusters..."
    
    CACHE_CLUSTERS=$(aws elasticache describe-cache-clusters \
        --query "CacheClusters[?contains(CacheClusterId, '${PROJECT_NAME}')].CacheClusterId" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$CACHE_CLUSTERS" ]; then
        for cluster in $CACHE_CLUSTERS; do
            log_warning "Force deleting ElastiCache cluster: $cluster"
            if [ "$DRY_RUN" = true ]; then
                log_info "[DRY RUN] Would delete cache cluster: $cluster"
            else
                aws elasticache delete-cache-cluster \
                    --cache-cluster-id "$cluster" \
                    --no-final-snapshot \
                    --region "${REGION}" || \
                    log_warning "Failed to delete cache cluster: $cluster"
            fi
        done
    fi
}

# Function to cleanup ECR images
cleanup_ecr_images() {
    log_info "Cleaning up ECR images..."
    
    # Check if repository exists
    if ! aws ecr describe-repositories \
        --repository-names "${ECR_REPOSITORY}" \
        --region "${REGION}" &> /dev/null; then
        log_info "ECR repository ${ECR_REPOSITORY} does not exist"
        return
    fi
    
    # Get all image IDs except the latest 5
    IMAGE_IDS=$(aws ecr describe-images \
        --repository-name "${ECR_REPOSITORY}" \
        --query 'sort_by(imageDetails,& imagePushedAt)[:-5].imageDigest' \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$IMAGE_IDS" ]; then
        log_info "Cleaning up old ECR images..."
        if [ "$DRY_RUN" = true ]; then
            log_info "[DRY RUN] Would delete old ECR images"
        else
            for digest in $IMAGE_IDS; do
                aws ecr batch-delete-image \
                    --repository-name "${ECR_REPOSITORY}" \
                    --image-ids imageDigest="$digest" \
                    --region "${REGION}" &> /dev/null || \
                    log_warning "Failed to delete image: $digest"
            done
        fi
    fi
}

# Function to force cleanup ECS services
force_cleanup_ecs() {
    log_info "Force cleaning up ECS resources..."
    
    # Stop all services
    SERVICES=$(aws ecs list-services \
        --cluster "${CLUSTER_NAME}" \
        --query "serviceArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$SERVICES" ]; then
        for service in $SERVICES; do
            log_info "Stopping service: $service"
            if [ "$DRY_RUN" != true ]; then
                # Set desired count to 0
                aws ecs update-service \
                    --cluster "${CLUSTER_NAME}" \
                    --service "$service" \
                    --desired-count 0 \
                    --region "${REGION}" &> /dev/null || true
                
                # Delete service
                aws ecs delete-service \
                    --cluster "${CLUSTER_NAME}" \
                    --service "$service" \
                    --force \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
    
    # Stop all tasks
    TASKS=$(aws ecs list-tasks \
        --cluster "${CLUSTER_NAME}" \
        --query "taskArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$TASKS" ]; then
        for task in $TASKS; do
            log_info "Stopping task: $task"
            if [ "$DRY_RUN" != true ]; then
                aws ecs stop-task \
                    --cluster "${CLUSTER_NAME}" \
                    --task "$task" \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
}

# Function to force cleanup Auto Scaling Groups
force_cleanup_asg() {
    log_info "Force cleaning up Auto Scaling Groups..."
    
    ASG_NAMES=$(aws autoscaling describe-auto-scaling-groups \
        --query "AutoScalingGroups[?contains(AutoScalingGroupName, '${PROJECT_NAME}')].AutoScalingGroupName" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$ASG_NAMES" ]; then
        for asg in $ASG_NAMES; do
            log_info "Force deleting ASG: $asg"
            if [ "$DRY_RUN" != true ]; then
                # Set desired capacity to 0
                aws autoscaling update-auto-scaling-group \
                    --auto-scaling-group-name "$asg" \
                    --min-size 0 \
                    --desired-capacity 0 \
                    --region "${REGION}" &> /dev/null || true
                
                # Force delete
                aws autoscaling delete-auto-scaling-group \
                    --auto-scaling-group-name "$asg" \
                    --force-delete \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
}

# Function to delete CloudFormation stack with retries
delete_stack() {
    local stack_name=$1
    local max_retries=5
    local retry_count=0
    
    while [ $retry_count -lt $max_retries ]; do
        log_info "Attempting to delete stack: $stack_name (attempt $((retry_count + 1))/$max_retries)"
        
        if ! check_stack_exists "$stack_name"; then
            log_info "Stack $stack_name does not exist"
            return 0
        fi
        
        # Delete the stack
        aws cloudformation delete-stack \
            --stack-name "$stack_name" \
            --region "${REGION}"
        
        # Wait for deletion with timeout
        if aws cloudformation wait stack-delete-complete \
            --stack-name "$stack_name" \
            --region "${REGION}" 2>/dev/null; then
            log_info "Stack $stack_name deleted successfully"
            return 0
        else
            local status=$(get_stack_status "$stack_name")
            if [ "$status" = "DELETE_FAILED" ]; then
                log_error "Stack deletion failed. Attempting cleanup..."
                
                # Get failed resources
                FAILED_RESOURCES=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "StackResources[?ResourceStatus=='DELETE_FAILED'].{Type:ResourceType,Id:PhysicalResourceId}" \
                    --output json \
                    --region "${REGION}")
                
                log_warning "Failed resources: $FAILED_RESOURCES"
                
                # Force cleanup specific resource types
                if echo "$FAILED_RESOURCES" | grep -q "ElastiCache"; then
                    cleanup_elasticache
                fi
                
                if echo "$FAILED_RESOURCES" | grep -q "ECS::Service"; then
                    force_cleanup_ecs
                fi
                
                if echo "$FAILED_RESOURCES" | grep -q "AutoScaling"; then
                    force_cleanup_asg
                fi
                
                retry_count=$((retry_count + 1))
                sleep 30
            else
                log_error "Unexpected stack status: $status"
                return 1
            fi
        fi
    done
    
    log_error "Failed to delete stack after $max_retries attempts"
    return 1
}

# Monitor CloudFormation stack progress
monitor_stack_progress() {
    local stack_name=$1
    local operation=$2
    
    log_info "Monitoring $operation progress for stack: $stack_name"
    
    while true; do
        local status=$(get_stack_status "$stack_name")
        
        case "$status" in
            "CREATE_IN_PROGRESS"|"UPDATE_IN_PROGRESS"|"DELETE_IN_PROGRESS")
                # Get current time
                local current_time=$(date '+%H:%M:%S')
                
                # Show resource counts
                local total=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "length(StackResources)" \
                    --output text \
                    --region "${REGION}" 2>/dev/null || echo "0")
                
                local completed=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "length(StackResources[?ResourceStatus=='CREATE_COMPLETE' || ResourceStatus=='UPDATE_COMPLETE' || ResourceStatus=='DELETE_COMPLETE'])" \
                    --output text \
                    --region "${REGION}" 2>/dev/null || echo "0")
                
                # Get the latest event
                local latest_event=$(aws cloudformation describe-stack-events \
                    --stack-name "$stack_name" \
                    --query "StackEvents[0].{Resource:LogicalResourceId,Status:ResourceStatus}" \
                    --output text \
                    --region "${REGION}" 2>/dev/null | tr '\t' ':')
                
                # Clear line and show progress
                echo -ne "\r\033[K${current_time} ${YELLOW}[PROGRESS]${NC} $operation: "
                
                if [ "$total" -gt 0 ]; then
                    local percentage=$((completed * 100 / total))
                    echo -ne "$completed/$total ($percentage%) - $latest_event"
                else
                    echo -ne "$latest_event"
                fi
                
                # Show ECS service status if deploying services (on new line)
                if [[ "$stack_name" == *"services"* ]] && [[ "$status" == "CREATE_IN_PROGRESS" ]]; then
                    echo ""
                    show_ecs_service_status
                    echo -ne "\r"
                fi
                
                sleep 3
                ;;
            "CREATE_COMPLETE"|"UPDATE_COMPLETE")
                echo -e "\n${GREEN}[SUCCESS]${NC} $operation completed successfully!"
                # Show final ECS service status for services stack
                if [[ "$stack_name" == *"services"* ]]; then
                    show_ecs_service_status
                fi
                break
                ;;
            "DELETE_COMPLETE"|"DOES_NOT_EXIST")
                echo -e "\n${GREEN}[SUCCESS]${NC} Stack deleted successfully!"
                break
                ;;
            "CREATE_FAILED"|"UPDATE_FAILED"|"DELETE_FAILED"|"ROLLBACK_COMPLETE"|"UPDATE_ROLLBACK_COMPLETE")
                echo -e "\n${RED}[FAILED]${NC} $operation failed with status: $status"
                
                # Show error events
                log_error "Recent error events:"
                aws cloudformation describe-stack-events \
                    --stack-name "$stack_name" \
                    --query "StackEvents[?ResourceStatus=='CREATE_FAILED' || ResourceStatus=='UPDATE_FAILED' || ResourceStatus=='DELETE_FAILED'][0:5].{Resource:LogicalResourceId,Reason:ResourceStatusReason}" \
                    --output table \
                    --region "${REGION}"
                
                return 1
                ;;
            *)
                echo -e "\n${YELLOW}[WARNING]${NC} Unexpected status: $status"
                sleep 5
                ;;
        esac
    done
}

# Show ECS service deployment status
show_ecs_service_status() {
    local services=$(aws ecs list-services --cluster "${CLUSTER_NAME}" --region "${REGION}" --query "serviceArns[]" --output text 2>/dev/null)
    if [ -n "$services" ]; then
        echo "  ECS Service Status:"
        for service_arn in $services; do
            local service_name=$(echo "$service_arn" | awk -F'/' '{print $NF}')
            local service_info=$(aws ecs describe-services \
                --cluster "${CLUSTER_NAME}" \
                --services "$service_arn" \
                --region "${REGION}" \
                --query "services[0].{desired:desiredCount,running:runningCount,pending:pendingCount}" \
                --output json 2>/dev/null)
            
            if [ -n "$service_info" ] && [ "$service_info" != "null" ]; then
                local desired=$(echo "$service_info" | jq -r '.desired // 0')
                local running=$(echo "$service_info" | jq -r '.running // 0')
                local pending=$(echo "$service_info" | jq -r '.pending // 0')
                
                if [ "$running" -eq "$desired" ] && [ "$pending" -eq 0 ]; then
                    echo -e "    ${GREEN}✓${NC} $service_name: $running/$desired running"
                else
                    echo -e "    ${YELLOW}⟳${NC} $service_name: $running/$desired running, $pending pending"
                fi
            fi
        done
    else
        # If no services in ECS yet, show CloudFormation resource status
        echo "  CloudFormation Resource Status:"
        local cf_services=$(aws cloudformation describe-stack-resources \
            --stack-name "${stack_name}" \
            --query "StackResources[?ResourceType=='AWS::ECS::Service'].{Name:LogicalResourceId,Status:ResourceStatus}" \
            --output json \
            --region "${REGION}" 2>/dev/null)
        
        if [ -n "$cf_services" ] && [ "$cf_services" != "[]" ]; then
            echo "$cf_services" | jq -r '.[] | "    \(.Name): \(.Status)"'
        fi
    fi
}

# Build and push Docker image with retry
build_and_push_image() {
    local tag=${1:-latest}
    
    log_info "Building Docker image..."
    
    # Check if Dockerfile exists in parent directory (Git root)
    if [ ! -f "../Dockerfile" ]; then
        log_error "Dockerfile not found in parent directory (project root)"
        return 1
    fi
    
    # Build image using parent directory as context
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would build Docker image: ${ECR_URI}:${tag}"
    else
        if ! docker build -t "${ECR_URI}:${tag}" -f ../Dockerfile ..; then
            log_error "Failed to build Docker image"
            return 1
        fi
    fi
    
    # Login to ECR
    log_info "Logging in to ECR..."
    if [ "$DRY_RUN" != true ]; then
        aws ecr get-login-password --region "${REGION}" | \
            docker login --username AWS --password-stdin "${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
    fi
    
    # Create repository if it doesn't exist
    if ! aws ecr describe-repositories \
        --repository-names "${ECR_REPOSITORY}" \
        --region "${REGION}" &> /dev/null; then
        log_info "Creating ECR repository..."
        if [ "$DRY_RUN" != true ]; then
            aws ecr create-repository \
                --repository-name "${ECR_REPOSITORY}" \
                --image-scanning-configuration scanOnPush=true \
                --region "${REGION}" &> /dev/null
        fi
    fi
    
    # Push image with retry
    push_with_retry() {
        local max_retries=3
        local retry_count=0
        
        while [ $retry_count -lt $max_retries ]; do
            log_info "Pushing Docker image (attempt $((retry_count + 1))/$max_retries)..."
            
            if [ "$DRY_RUN" = true ]; then
                log_info "[DRY RUN] Would push Docker image: ${ECR_URI}:${tag}"
                return 0
            fi
            
            if docker push "${ECR_URI}:${tag}"; then
                log_info "Docker image pushed successfully"
                return 0
            else
                retry_count=$((retry_count + 1))
                if [ $retry_count -lt $max_retries ]; then
                    log_warning "Push failed, retrying in 10 seconds..."
                    sleep 10
                fi
            fi
        done
        
        log_error "Failed to push Docker image after $max_retries attempts"
        return 1
    }
    
    push_with_retry
}

# Upload template to S3 with proper URL format
upload_template_to_s3() {
    local template_file="$1"
    local template_size=$(wc -c < "$template_file")

    log_info "Template size: $template_size bytes. Uploading to S3..." >&2

    # Create S3 bucket for templates if it doesn't exist
    local bucket_name="${PROJECT_NAME}-cf-templates-${AWS_ACCOUNT_ID}-${REGION}"

    # Check if bucket exists, create if not
    if ! aws s3api head-bucket --bucket "$bucket_name" --region "${REGION}" 2>/dev/null; then
        log_info "Creating S3 bucket for templates: $bucket_name" >&2

        # Create bucket with proper location constraint
        if [ "${REGION}" = "us-east-1" ]; then
            aws s3api create-bucket \
                --bucket "$bucket_name" \
                --region "${REGION}" >/dev/null
        else
            aws s3api create-bucket \
                --bucket "$bucket_name" \
                --region "${REGION}" \
                --create-bucket-configuration LocationConstraint="${REGION}" >/dev/null
        fi

        # Wait for bucket to be available
        aws s3api wait bucket-exists --bucket "$bucket_name" --region "${REGION}"

        # Enable versioning
        aws s3api put-bucket-versioning \
            --bucket "$bucket_name" \
            --versioning-configuration Status=Enabled \
            --region "${REGION}" >/dev/null

        # Set bucket policy to allow CloudFormation access
        aws s3api put-bucket-policy \
            --bucket "$bucket_name" \
            --policy "{
                \"Version\": \"2012-10-17\",
                \"Statement\": [
                    {
                        \"Sid\": \"AllowCloudFormationRead\",
                        \"Effect\": \"Allow\",
                        \"Principal\": {
                            \"Service\": \"cloudformation.amazonaws.com\"
                        },
                        \"Action\": \"s3:GetObject\",
                        \"Resource\": \"arn:aws:s3:::${bucket_name}/*\"
                    }
                ]
            }" \
            --region "${REGION}" >/dev/null 2>&1 || {
                # If policy fails, try with public read access
                log_warning "Failed to set CloudFormation service policy, trying public read access..." >&2
                aws s3api put-bucket-policy \
                    --bucket "$bucket_name" \
                    --policy "{
                        \"Version\": \"2012-10-17\",
                        \"Statement\": [
                            {
                                \"Sid\": \"PublicReadGetObject\",
                                \"Effect\": \"Allow\",
                                \"Principal\": \"*\",
                                \"Action\": \"s3:GetObject\",
                                \"Resource\": \"arn:aws:s3:::${bucket_name}/*\"
                            }
                        ]
                    }" \
                    --region "${REGION}" >/dev/null
            }
    fi

    # Generate unique template key
    local timestamp=$(date +%s)
    local template_basename=$(basename "$template_file" .yaml)
    local template_key="${template_basename}-${timestamp}.yaml"

    # Upload template to S3
    log_info "Uploading template to s3://${bucket_name}/${template_key}..." >&2
    if ! aws s3 cp "$template_file" "s3://${bucket_name}/${template_key}" \
        --region "${REGION}" \
        --content-type "text/yaml" >/dev/null; then
        log_error "Failed to upload template to S3" >&2
        return 1
    fi

    # Verify upload was successful
    if ! aws s3api head-object \
        --bucket "$bucket_name" \
        --key "$template_key" \
        --region "${REGION}" >/dev/null 2>&1; then
        log_error "Template upload verification failed" >&2
        return 1
    fi

    # Return the correct CloudFormation-compatible S3 URL
    echo "https://s3.amazonaws.com/${bucket_name}/${template_key}"
}
# Alternative function that checks template size first
deploy_with_template() {
    local template_file="$1"
    local stack_name="$2"
    local parameters=("${@:3}")

    local template_size=$(wc -c < "$template_file")
    local max_local_size=51200  # 50KB limit for direct template body

    if [ "$template_size" -gt "$max_local_size" ]; then
        log_info "Template size ($template_size bytes) exceeds limit. Using S3..."
        local template_url=$(upload_template_to_s3 "$template_file")
        local template_param="--template-url"
        local template_value="$template_url"
    else
        log_info "Template size ($template_size bytes) is within limit. Using direct upload..."
        local template_param="--template-body"
        local template_value="file://$template_file"
    fi

    # Return the parameters for use in CloudFormation commands
    echo "$template_param"
    echo "$template_value"
}

# Updated deploy_infrastructure function
deploy_infrastructure() {
    log_info "Deploying infrastructure stack..."

    local template_file="cloudformation/main.yaml"
    if [ ! -f "$template_file" ]; then
        log_error "CloudFormation template not found: $template_file"
        return 1
    fi

    # Validate template first
    log_info "Validating CloudFormation template..."
    if ! aws cloudformation validate-template \
        --template-body "file://$template_file" \
        --region "${REGION}" >/dev/null; then
        log_error "Template validation failed"
        return 1
    fi

    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would deploy stack: ${PROJECT_NAME}-main"
        return 0
    fi

    # Check template size to determine deployment method
    local template_size=$(wc -c < "$template_file")
    local max_local_size=51200  # 50KB limit for direct template body

    local template_param=""
    local template_value=""

    if [ "$template_size" -gt "$max_local_size" ]; then
        log_info "Template size ($template_size bytes) exceeds limit. Uploading to S3..."
        template_value=$(upload_template_to_s3 "$template_file")
        if [ $? -ne 0 ] || [ -z "$template_value" ]; then
            log_error "Failed to upload template to S3"
            return 1
        fi
        template_param="--template-url"
        log_info "Using S3 template URL: $template_value"
    else
        log_info "Template size ($template_size bytes) is within limit. Using direct upload..."
        template_param="--template-body"
        template_value="file://$template_file"
    fi

    # Prepare parameters
    local params=(
        "ParameterKey=ProjectName,ParameterValue=${PROJECT_NAME}"
        "ParameterKey=Environment,ParameterValue=${ENVIRONMENT:-dev}"
    )

    # Check if stack exists
    local stack_name="${PROJECT_NAME}-main"
    local stack_exists=false
    if check_stack_exists "$stack_name"; then
        stack_exists=true
        log_info "Stack exists, updating..."
    else
        log_info "Creating new stack..."
    fi

    # Execute stack operation with proper command structure
    if [ "$stack_exists" = true ]; then
        log_info "Executing: aws cloudformation update-stack $template_param \"$template_value\" --stack-name \"$stack_name\" ..."
        if ! aws cloudformation update-stack \
            $template_param "$template_value" \
            --stack-name "$stack_name" \
            --parameters "${params[@]}" \
            --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
            --region "${REGION}"; then

            local update_status=$?
            if [ $update_status -eq 254 ]; then
                log_info "No changes detected for infrastructure stack"
                return 0
            else
                log_error "Failed to update stack (exit code: $update_status)"
                return $update_status
            fi
        fi
    else
        log_info "Executing: aws cloudformation create-stack $template_param \"$template_value\" --stack-name \"$stack_name\" ..."
        if ! aws cloudformation create-stack \
            $template_param "$template_value" \
            --stack-name "$stack_name" \
            --parameters "${params[@]}" \
            --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
            --region "${REGION}"; then
            log_error "Failed to create stack"
            return 1
        fi
    fi

    # Monitor progress
    monitor_stack_progress "$stack_name" "Infrastructure deployment"
    local monitor_result=$?

    if [ $monitor_result -ne 0 ]; then
        log_error "Infrastructure deployment failed"
        return 1
    fi

    log_info "Infrastructure deployment completed successfully"
    return 0
}
deploy_ecs_services() {
    log_info "Deploying ECS services stack..."

    local template_file="cloudformation/ecs-services.yaml"
    if [ ! -f "$template_file" ]; then
        log_error "ECS services template not found: $template_file"
        return 1
    fi

    # CRITICAL: Wait for main stack to be completely ready
    local main_stack_name="${PROJECT_NAME}-main"
    log_info "Waiting for main stack to be ready..."

    # Wait for main stack to be in a completed state
    local max_wait_attempts=60  # 10 minutes max wait
    local wait_attempt=0
    while [ $wait_attempt -lt $max_wait_attempts ]; do
        local main_status=$(get_stack_status "$main_stack_name")
        case "$main_status" in
            "CREATE_COMPLETE"|"UPDATE_COMPLETE")
                log_info "Main stack is ready: $main_status"
                break
                ;;
            "CREATE_IN_PROGRESS"|"UPDATE_IN_PROGRESS")
                log_info "Waiting for main stack... (attempt $((wait_attempt + 1))/$max_wait_attempts) Status: $main_status"
                sleep 10
                wait_attempt=$((wait_attempt + 1))
                ;;
            "CREATE_FAILED"|"UPDATE_FAILED"|"ROLLBACK_COMPLETE"|"UPDATE_ROLLBACK_COMPLETE")
                log_error "Main stack is in failed state: $main_status. Cannot deploy services."
                return 1
                ;;
            "DOES_NOT_EXIST")
                log_error "Main stack does not exist. Deploy infrastructure first."
                return 1
                ;;
            *)
                log_error "Main stack is in unexpected state: $main_status"
                return 1
                ;;
        esac
    done

    if [ $wait_attempt -ge $max_wait_attempts ]; then
        log_error "Timed out waiting for main stack to complete"
        return 1
    fi

    # Always upload template to S3 (services template is large)
    local template_url=$(upload_template_to_s3 "$template_file")
    log_info "Using S3 template URL: $template_url"

    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would deploy services stack"
        # Validate template
        aws cloudformation validate-template \
            --template-url "$template_url" \
            --region "${REGION}" >/dev/null 2>&1 && \
            log_info "Services template validation passed"
        return 0
    fi

    # Get outputs from main stack with retry
    log_info "Getting outputs from main stack..."
    local outputs
    local get_outputs_attempts=0
    while [ $get_outputs_attempts -lt 5 ]; do
        if outputs=$(aws cloudformation describe-stacks \
            --stack-name "$main_stack_name" \
            --query "Stacks[0].Outputs" \
            --output json \
            --region "${REGION}" 2>/dev/null); then
            break
        else
            log_warning "Failed to get outputs, retrying... (attempt $((get_outputs_attempts + 1))/5)"
            sleep 5
            get_outputs_attempts=$((get_outputs_attempts + 1))
        fi
    done

    if [ $get_outputs_attempts -ge 5 ]; then
        log_error "Failed to get outputs from main stack after multiple attempts"
        return 1
    fi

    # Build the required outputs list dynamically based on your config
    # This should match exactly what your main.yaml template exports
    local required_outputs=(
        "MainECSClusterName"
        "ECRRepositoryURI"
        "ALBDNSName"
        "TaskExecutionRoleArn"
        "TaskRoleArn"
        "ServiceDiscoveryNamespaceId"
        "ALBTargetGroupCoordinatorArn"
    )

    # Add realm-specific outputs dynamically
    # Extract realm IDs from config or hardcode based on your setup
    local realm_ids=("0" "1")  # Adjust this to match your config
    for realm_id in "${realm_ids[@]}"; do
        required_outputs+=("ALBTargetGroupRealm${realm_id}Arn")
        required_outputs+=("RedisRealm${realm_id}Endpoint")
    done

    # Add Redis coordinator endpoint
    required_outputs+=("RedisCoordinatorEndpoint")

    # Build parameters array with validation
    local params_array=()
    local missing_params=()

    log_info "Building parameters from main stack outputs..."
    for param in "${required_outputs[@]}"; do
        local value=$(echo "$outputs" | jq -r ".[] | select(.OutputKey==\"$param\") | .OutputValue // \"\"")
        if [ -n "$value" ] && [ "$value" != "null" ] && [ "$value" != "" ]; then
            params_array+=("ParameterKey=$param,ParameterValue=$value")
            log_debug "Found parameter: $param = $value"
        else
            missing_params+=("$param")
            log_warning "Missing parameter: $param"
        fi
    done

    # Check for missing required parameters
    local missing_count=$(printf '%s\n' "${missing_params[@]}" 2>/dev/null | wc -l)
    if [ "${missing_count:-0}" -gt 0 ]; then
        log_error "Missing required parameters from main stack outputs:"
        printf '%s\n' "${missing_params[@]}"
        log_info "Available outputs from main stack:"
        echo "$outputs" | jq -r '.[] | "\(.OutputKey) = \(.OutputValue)"'
        return 1
    fi

    local param_count=$(printf '%s\n' "${params_array[@]}" 2>/dev/null | wc -l)
    log_info "Successfully found all ${param_count:-0} required parameters"

    # Deploy services stack
    local stack_name="${PROJECT_NAME}-services"
    local stack_exists=false
    if check_stack_exists "$stack_name"; then
        stack_exists=true
        log_info "Services stack exists, updating..."
    else
        log_info "Creating new services stack..."
    fi

    # Execute stack operation with proper error handling
    if [ "$stack_exists" = true ]; then
        log_info "Updating services stack with $(printf '%s\n' "${params_array[@]}" | wc -l) parameters..."
        if ! aws cloudformation update-stack \
            --template-url "$template_url" \
            --stack-name "$stack_name" \
            --parameters "${params_array[@]}" \
            --capabilities CAPABILITY_IAM \
            --region "${REGION}"; then

            local update_status=$?
            # AWS CLI returns 254 when no changes are needed
            if [ $update_status -eq 254 ]; then
                log_info "No changes detected for services stack"
                return 0
            else
                log_error "Failed to update services stack (AWS CLI exit code: $update_status)"
                return $update_status
            fi
        fi
    else
        log_info "Creating new services stack with $(printf '%s\n' "${params_array[@]}" | wc -l) parameters..."
        if ! aws cloudformation create-stack \
            --template-url "$template_url" \
            --stack-name "$stack_name" \
            --parameters "${params_array[@]}" \
            --capabilities CAPABILITY_IAM \
            --region "${REGION}"; then
            log_error "Failed to create services stack"
            return 1
        fi
    fi

    # Monitor progress
    log_info "Monitoring services stack deployment..."
    monitor_stack_progress "$stack_name" "Services deployment"
    local monitor_result=$?

    if [ $monitor_result -ne 0 ]; then
        log_error "Services deployment failed"

        # Show recent stack events for debugging
        log_error "Recent stack events:"
        aws cloudformation describe-stack-events \
            --stack-name "$stack_name" \
            --query "StackEvents[0:10].{Time:Timestamp,Status:ResourceStatus,Reason:ResourceStatusReason,Resource:LogicalResourceId}" \
            --output table \
            --region "${REGION}" || true

        return 1
    fi

    log_info "Services deployment completed successfully"
    return 0
}
# Show deployment status
show_status() {
    log_info "Deployment Status for ${PROJECT_NAME}"
    echo "=================================="
    
    # Check main stack
    local main_status=$(get_stack_status "${PROJECT_NAME}-main")
    echo -e "Main Stack: ${main_status}"
    
    # Check services stack
    local services_status=$(get_stack_status "${PROJECT_NAME}-services")
    echo -e "Services Stack: ${services_status}"
    
    # Also check for dev services stack (alternative naming)
    local dev_services_status=$(get_stack_status "${PROJECT_NAME}-${ENVIRONMENT}-services")
    if [ "$dev_services_status" != "DOES_NOT_EXIST" ]; then
        echo -e "Dev Services Stack: ${dev_services_status}"
    fi
    
    # Check ECS cluster
    if aws ecs describe-clusters --clusters "${CLUSTER_NAME}" --region "${REGION}" &> /dev/null; then
        local container_instances=$(aws ecs describe-clusters \
            --clusters "${CLUSTER_NAME}" \
            --query "clusters[0].registeredContainerInstancesCount" \
            --output text \
            --region "${REGION}")
        echo -e "ECS Container Instances: ${container_instances}"
        
        # List services
        echo -e "\nECS Services:"
        aws ecs list-services \
            --cluster "${CLUSTER_NAME}" \
            --query "serviceArns[]" \
            --output table \
            --region "${REGION}"
    fi
    
    # Show endpoints
    if [ "$main_status" = "CREATE_COMPLETE" ] || [ "$main_status" = "UPDATE_COMPLETE" ]; then
        echo -e "\nEndpoints:"
        local alb_dns=$(aws cloudformation describe-stacks \
            --stack-name "${PROJECT_NAME}-main" \
            --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
            --output text \
            --region "${REGION}")
        
        if [ -n "$alb_dns" ]; then
            echo "Coordinator: http://${alb_dns}:{{ config.nodes.coordinator.edge.aws.load_balancer.port }}"
            {% for realm in config.nodes.realms %}
            echo "Realm {{ realm.id }}: http://${alb_dns}:{{ realm.edge.aws.load_balancer.port }}"
            {% endfor %}
        fi
    fi
}

# Show CloudWatch logs
show_logs() {
    local service_name=$1
    if [ -z "$service_name" ]; then
        log_error "Please specify a service name"
        echo "Available services:"
        aws logs describe-log-streams \
            --log-group-name "{{ config.nodes.deployment.aws.ecs.log_group }}" \
            --query "logStreams[].logStreamName" \
            --output table \
            --region "${REGION}" 2>/dev/null | head -20
        return 1
    fi
    
    log_info "Showing logs for: $service_name"
    aws logs tail "{{ config.nodes.deployment.aws.ecs.log_group }}" \
        --log-stream-name-prefix "$service_name" \
        --follow \
        --region "${REGION}"
}

# Main deployment function
deploy() {
    log_info "Starting QED Protocol deployment..."
    
    # Build and push Docker image
    if [ "$SKIP_BUILD" != true ]; then
        if ! build_and_push_image "$IMAGE_TAG"; then
            log_error "Failed to build and push Docker image"
            return 1
        fi
    else
        log_info "Skipping Docker build as requested"
    fi
    
    # Deploy infrastructure first
    log_info "=== Phase 1: Infrastructure Deployment ==="
    if ! deploy_infrastructure; then
        log_error "Infrastructure deployment failed"
        return 1
    fi

    # Wait a moment for resources to stabilize
    log_info "Waiting for infrastructure to stabilize..."
    sleep 10

    # Deploy ECS services
    log_info "=== Phase 2: Services Deployment ==="
    if ! deploy_ecs_services; then
        log_error "Services deployment failed"
        return 1
    fi

    log_info "=== Deployment Completed Successfully! ==="
    show_status
    
    # Print ALB URLs and helpful commands
    print_deployment_info
}

# Function to print deployment information
print_deployment_info() {
    echo -e "\n${GREEN}=== Deployment Information ===${NC}"
    
    # Get ALB DNS name
    local alb_dns=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$alb_dns" ]; then
        echo -e "\n${BLUE}ALB Endpoints:${NC}"
        echo "Coordinator: http://${alb_dns}:{{ config.nodes.coordinator.edge.aws.load_balancer.port }}"
        {% for realm in config.nodes.realms %}
        echo "Realm {{ realm.id }}: http://${alb_dns}:{{ realm.edge.aws.load_balancer.port }}"
        {% endfor %}
    fi
    
    echo -e "\n${BLUE}Useful Commands:${NC}"
    echo ""
    echo "# View logs for specific services:"
    echo "$0 logs coordinator-processor"
    echo "$0 logs coordinator-edge"
    echo "$0 logs coordinator-worker"
    {% for realm in config.nodes.realms %}
    echo "$0 logs realm-{{ realm.id }}-processor"
    echo "$0 logs realm-{{ realm.id }}-edge"
    echo "$0 logs realm-{{ realm.id }}-worker"
    {% endfor %}
    echo "$0 logs prover"
    
    echo ""
    echo "# Monitor deployment status:"
    echo "$0 status"
    
    echo ""
    echo "# Update services after code changes:"
    echo "$0 build && $0 update-services"
    
    {% set uses_scylla = false %}
    {% if config.nodes.coordinator.backend.type == "scylla" %}
      {% set uses_scylla = true %}
    {% endif %}
    {% for realm in config.nodes.realms %}
      {% if realm.backend.type == "scylla" %}
        {% set uses_scylla = true %}
      {% endif %}
    {% endfor %}
    {% if uses_scylla %}
    echo ""
    echo "# Access ScyllaDB (via ECS Exec):"
    echo "# First, find the container instance ID:"
    echo "aws ecs list-container-instances --cluster ${CLUSTER_NAME} --region ${REGION}"
    echo "# Then access the instance:"
    echo "aws ssm start-session --target <instance-id> --region ${REGION}"
    echo "# Inside the instance, access ScyllaDB containers:"
    echo "docker exec -it qed-scylla-coordinator-1 cqlsh"
    {% endif %}
    
    echo ""
    echo "# View all ECS services:"
    echo "aws ecs list-services --cluster ${CLUSTER_NAME} --region ${REGION}"
    
    echo ""
    echo "# Tail all logs in log group:"
    echo "aws logs tail {{ config.nodes.deployment.aws.ecs.log_group }} --follow --region ${REGION}"
    
    echo -e "\n${GREEN}Deployment complete!${NC}"
}

# Main destroy function
destroy() {
    if [ "$FORCE" != true ]; then
        log_warning "This will destroy all infrastructure for ${PROJECT_NAME}"
        read -p "Are you sure? (yes/no): " -r
        if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
            log_info "Destruction cancelled"
            return 0
        fi
    fi
    
    log_warning "Destroying all stacks..."
    
    # Delete services stack first
    delete_stack "${PROJECT_NAME}-services"
    
    # Delete main stack
    delete_stack "${PROJECT_NAME}-main"
    
    # Cleanup orphaned resources
    cleanup_ebs_volumes
    cleanup_ecr_images
    
    log_info "Destruction completed"
}

# Main cleanup function
cleanup() {
    log_info "Running comprehensive cleanup..."
    
    force_cleanup_ecs
    force_cleanup_asg
    cleanup_elasticache
    cleanup_ebs_volumes
    cleanup_ecr_images
    
    log_info "Cleanup completed"
}

# Parse command line arguments
COMMAND=""
FORCE=false
SKIP_BUILD=false
IMAGE_TAG="latest"
VERBOSE=false
DRY_RUN=false
ENVIRONMENT="dev"

while [[ $# -gt 0 ]]; do
    case $1 in
        deploy|destroy|cleanup|status|build|update-services|monitor|logs)
            COMMAND=$1
            shift
            ;;
        --force|-f)
            FORCE=true
            shift
            ;;
        --skip-build)
            SKIP_BUILD=true
            shift
            ;;
        --tag)
            IMAGE_TAG="$2"
            shift 2
            ;;
        --profile)
            export AWS_PROFILE="$2"
            shift 2
            ;;
        --verbose|-v)
            VERBOSE=true
            set -x
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --env|--environment)
            ENVIRONMENT="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$COMMAND" ] && [ "$1" = "logs" ]; then
                COMMAND="logs"
            else
                SERVICE_NAME="$1"
            fi
            shift
            ;;
    esac
done

# Check prerequisites
check_aws_cli

# Execute command
case "$COMMAND" in
    deploy)
        deploy
        ;;
    destroy)
        destroy
        ;;
    cleanup)
        cleanup
        ;;
    status)
        show_status
        ;;
    build)
        build_and_push_image "$IMAGE_TAG"
        ;;
    update-services)
        SKIP_BUILD=true
        deploy_ecs_services
        ;;
    monitor)
        if check_stack_exists "${PROJECT_NAME}-main"; then
            monitor_stack_progress "${PROJECT_NAME}-main" "Stack operation"
        elif check_stack_exists "${PROJECT_NAME}-services"; then
            monitor_stack_progress "${PROJECT_NAME}-services" "Stack operation"
        else
            log_error "No active stacks found"
        fi
        ;;
    logs)
        show_logs "$SERVICE_NAME"
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac