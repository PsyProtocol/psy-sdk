# Show deployment status
show_status() {
    log_info "Deployment Status for ${PROJECT_NAME}"
    echo "=================================="
    
    # Check main stack
    local main_status=$(get_stack_status "${PROJECT_NAME}-main")
    echo -e "Main Stack: ${main_status}"
    
    # Check services stack
    local services_status=$(get_stack_status "${PROJECT_NAME}-services")
    echo -e "Services Stack: ${services_status}"
    
    # Get the actual cluster name from CloudFormation outputs
    local actual_cluster_name=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='MainECSClusterName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$actual_cluster_name" ]; then
        # Fallback to constructed name
        actual_cluster_name="${PROJECT_NAME}-${ENVIRONMENT:-dev}-main-ecs"
    fi
    
    # Check ECS cluster using the actual name
    if aws ecs describe-clusters --clusters "$actual_cluster_name" --region "${REGION}" &> /dev/null; then
        local container_instances=$(aws ecs describe-clusters \
            --clusters "$actual_cluster_name" \
            --query "clusters[0].registeredContainerInstancesCount" \
            --output text \
            --region "${REGION}")
        echo -e "ECS Container Instances: ${container_instances}"
        
        # List services
        echo -e "\nECS Services:"
        aws ecs list-services \
            --cluster "$actual_cluster_name" \
            --query "serviceArns[]" \
            --output table \
            --region "${REGION}"
    else
        echo "ECS Cluster not found or not accessible"
    fi
    
    # Show endpoints
    if [ "$main_status" = "CREATE_COMPLETE" ] || [ "$main_status" = "UPDATE_COMPLETE" ]; then
        echo -e "\nEndpoints:"
        local alb_dns=$(aws cloudformation describe-stacks \
            --stack-name "${PROJECT_NAME}-main" \
            --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
            --output text \
            --region "${REGION}")
        
        if [ -n "$alb_dns" ]; then
            echo "Coordinator: http://${alb_dns}:{{ config.nodes.coordinator.edge.aws.load_balancer.port }}"
            {% for realm in config.nodes.realms %}
            echo "Realm {{ realm.id }}: http://${alb_dns}:{{ realm.edge.aws.load_balancer.port }}"
            {% endfor %}
        fi
    fi
}
# Show CloudWatch logs
show_logs() {
    local service_name=$1
    
    # Get actual cluster name
    local actual_cluster_name=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='MainECSClusterName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$actual_cluster_name" ]; then
        actual_cluster_name="${PROJECT_NAME}-${ENVIRONMENT:-dev}-main-ecs"
    fi
    
    if [ -z "$service_name" ]; then
        log_error "Please specify a service name"
        echo "Available services:"
        aws logs describe-log-streams \
            --log-group-name "{{ config.nodes.deployment.aws.ecs.log_group }}" \
            --query "logStreams[].logStreamName" \
            --output table \
            --region "${REGION}" 2>/dev/null | head -20
        return 1
    fi
    
    log_info "Showing logs for: $service_name"
    aws logs tail "{{ config.nodes.deployment.aws.ecs.log_group }}" \
        --log-stream-name-prefix "$service_name" \
        --follow \
        --region "${REGION}"
}

# Main deployment function
deploy() {
    log_info "Starting QED Protocol deployment..."
    
    # Build and push Docker image
    if [ "$SKIP_BUILD" != true ]; then
        if ! build_and_push_image "$IMAGE_TAG"; then
            log_error "Failed to build and push Docker image"
            return 1
        fi
    else
        log_info "Skipping Docker build as requested"
    fi
    
    # Deploy infrastructure first
    log_info "=== Phase 1: Infrastructure Deployment ==="
    if ! deploy_infrastructure; then
        log_error "Infrastructure deployment failed"
        return 1
    fi

    # Wait a moment for resources to stabilize
    log_info "Waiting for infrastructure to stabilize..."
    sleep 10

    # Deploy ECS services
    log_info "=== Phase 2: Services Deployment ==="
    if ! deploy_ecs_services; then
        log_error "Services deployment failed"
        return 1
    fi

    # Wait for services stack to complete
    log_info "Waiting for services deployment to complete..."
    local services_status=$(get_stack_status "${PROJECT_NAME}-services")
    local wait_count=0
    while [[ "$services_status" == *"IN_PROGRESS"* ]] && [ $wait_count -lt 60 ]; do
        sleep 5
        services_status=$(get_stack_status "${PROJECT_NAME}-services")
        wait_count=$((wait_count + 1))
    done

    log_info "=== Deployment Completed Successfully! ==="
    show_status
    
    # Print ALB URLs and helpful commands
    print_deployment_info
}

