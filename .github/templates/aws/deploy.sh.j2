#!/bin/bash
set -e

# AWS Deployment Script for QED Protocol
# Generated from config.json

# Change to script directory
cd "$(dirname "$0")"

PROJECT_NAME="{{ config.nodes.deployment.aws.project_name }}"
REGION="{{ config.nodes.deployment.aws.region }}"
ECR_REPOSITORY="{{ config.nodes.deployment.aws.ecr.repository_name }}"
ENVIRONMENT="${ENVIRONMENT:-dev}"
CLUSTER_NAME="${PROJECT_NAME}-${ENVIRONMENT}-main-ecs"  # Use consistent naming

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_debug() {
    echo -e "${BLUE}[DEBUG]${NC} $1"
}

# Function to show help
show_help() {
    cat << EOF
Usage: $0 [COMMAND] [OPTIONS]

Commands:
    deploy              Deploy the full QED Protocol infrastructure
    destroy             Destroy all infrastructure
    cleanup             Clean up orphaned resources
    status              Show deployment status
    build               Build and push Docker image only
    update-services     Update ECS services with new image
    monitor             Monitor deployment progress
    logs                Show CloudWatch logs

Options:
    --force             Force operation without confirmation
    --skip-build        Skip Docker build step
    --tag TAG           Use specific Docker image tag (default: latest)
    --profile PROFILE   AWS profile to use
    --verbose           Enable verbose output
    --dry-run           Show what would be done without executing

Examples:
    $0 deploy                    # Deploy everything
    $0 deploy --skip-build       # Deploy without rebuilding Docker image
    $0 destroy --force           # Destroy without confirmation
    $0 cleanup                   # Clean up orphaned resources
    $0 status                    # Check deployment status
    $0 logs coordinator-processor # Show logs for a specific service

EOF
}

# Function to check if AWS CLI is configured
check_aws_cli() {
    if ! command -v aws &> /dev/null; then
        log_error "AWS CLI is not installed. Please install it first."
        exit 1
    fi
    
    # Check AWS credentials
    if ! aws sts get-caller-identity &> /dev/null; then
        log_error "AWS credentials not configured. Please run 'aws configure'"
        exit 1
    fi
    
    # Get AWS account ID
    AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
    if [ -z "$AWS_ACCOUNT_ID" ]; then
        log_error "Failed to get AWS account ID."
        exit 1
    fi
    
    ECR_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com/${ECR_REPOSITORY}"
}

# Function to cleanup EBS volumes
cleanup_ebs_volumes() {
    log_info "Cleaning up orphaned EBS volumes..."
    
    # Find volumes tagged with our project that are available (not attached)
    ORPHANED_VOLUMES=$(aws ec2 describe-volumes \
        --filters "Name=status,Values=available" \
                  "Name=tag:Project,Values=${PROJECT_NAME}" \
        --query "Volumes[].VolumeId" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$ORPHANED_VOLUMES" ]; then
        log_warning "Found orphaned EBS volumes: $ORPHANED_VOLUMES"
        
        if [ "$DRY_RUN" = true ]; then
            log_info "[DRY RUN] Would delete volumes: $ORPHANED_VOLUMES"
        else
            for volume in $ORPHANED_VOLUMES; do
                log_info "Deleting volume: $volume"
                aws ec2 delete-volume --volume-id "$volume" --region "${REGION}" || \
                    log_warning "Failed to delete volume: $volume"
            done
        fi
    else
        log_info "No orphaned EBS volumes found"
    fi
}

# Function to check if stack exists
check_stack_exists() {
    local stack_name=$1
    aws cloudformation describe-stacks \
        --stack-name "$stack_name" \
        --region "${REGION}" &> /dev/null
}

# Function to get stack status
get_stack_status() {
    local stack_name=$1
    aws cloudformation describe-stacks \
        --stack-name "$stack_name" \
        --query "Stacks[0].StackStatus" \
        --output text \
        --region "${REGION}" 2>/dev/null || echo "DOES_NOT_EXIST"
}

# Function to cleanup ElastiCache clusters
cleanup_elasticache() {
    log_info "Checking for ElastiCache clusters..."
    
    CACHE_CLUSTERS=$(aws elasticache describe-cache-clusters \
        --query "CacheClusters[?contains(CacheClusterId, '${PROJECT_NAME}')].CacheClusterId" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$CACHE_CLUSTERS" ]; then
        for cluster in $CACHE_CLUSTERS; do
            log_warning "Force deleting ElastiCache cluster: $cluster"
            if [ "$DRY_RUN" = true ]; then
                log_info "[DRY RUN] Would delete cache cluster: $cluster"
            else
                aws elasticache delete-cache-cluster \
                    --cache-cluster-id "$cluster" \
                    --no-final-snapshot \
                    --region "${REGION}" || \
                    log_warning "Failed to delete cache cluster: $cluster"
            fi
        done
    fi
}

# Function to cleanup ECR images
cleanup_ecr_images() {
    log_info "Cleaning up ECR images..."
    
    # Check if repository exists
    if ! aws ecr describe-repositories \
        --repository-names "${ECR_REPOSITORY}" \
        --region "${REGION}" &> /dev/null; then
        log_info "ECR repository ${ECR_REPOSITORY} does not exist"
        return
    fi
    
    # Get all image IDs except the latest 5
    IMAGE_IDS=$(aws ecr describe-images \
        --repository-name "${ECR_REPOSITORY}" \
        --query 'sort_by(imageDetails,& imagePushedAt)[:-5].imageDigest' \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$IMAGE_IDS" ]; then
        log_info "Cleaning up old ECR images..."
        if [ "$DRY_RUN" = true ]; then
            log_info "[DRY RUN] Would delete old ECR images"
        else
            for digest in $IMAGE_IDS; do
                aws ecr batch-delete-image \
                    --repository-name "${ECR_REPOSITORY}" \
                    --image-ids imageDigest="$digest" \
                    --region "${REGION}" &> /dev/null || \
                    log_warning "Failed to delete image: $digest"
            done
        fi
    fi
}

# Function to force cleanup ECS services
force_cleanup_ecs() {
    log_info "Force cleaning up ECS resources..."
    
    # Stop all services
    SERVICES=$(aws ecs list-services \
        --cluster "${CLUSTER_NAME}" \
        --query "serviceArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$SERVICES" ]; then
        for service in $SERVICES; do
            log_info "Stopping service: $service"
            if [ "$DRY_RUN" != true ]; then
                # Set desired count to 0
                aws ecs update-service \
                    --cluster "${CLUSTER_NAME}" \
                    --service "$service" \
                    --desired-count 0 \
                    --region "${REGION}" &> /dev/null || true
                
                # Delete service
                aws ecs delete-service \
                    --cluster "${CLUSTER_NAME}" \
                    --service "$service" \
                    --force \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
    
    # Stop all tasks
    TASKS=$(aws ecs list-tasks \
        --cluster "${CLUSTER_NAME}" \
        --query "taskArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$TASKS" ]; then
        for task in $TASKS; do
            log_info "Stopping task: $task"
            if [ "$DRY_RUN" != true ]; then
                aws ecs stop-task \
                    --cluster "${CLUSTER_NAME}" \
                    --task "$task" \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
}

# Function to force cleanup Auto Scaling Groups
force_cleanup_asg() {
    log_info "Force cleaning up Auto Scaling Groups..."
    
    ASG_NAMES=$(aws autoscaling describe-auto-scaling-groups \
        --query "AutoScalingGroups[?contains(AutoScalingGroupName, '${PROJECT_NAME}')].AutoScalingGroupName" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$ASG_NAMES" ]; then
        for asg in $ASG_NAMES; do
            log_info "Force deleting ASG: $asg"
            if [ "$DRY_RUN" != true ]; then
                # Set desired capacity to 0
                aws autoscaling update-auto-scaling-group \
                    --auto-scaling-group-name "$asg" \
                    --min-size 0 \
                    --desired-capacity 0 \
                    --region "${REGION}" &> /dev/null || true
                
                # Force delete
                aws autoscaling delete-auto-scaling-group \
                    --auto-scaling-group-name "$asg" \
                    --force-delete \
                    --region "${REGION}" &> /dev/null || true
            fi
        done
    fi
}

# Function to delete CloudFormation stack with retries
delete_stack() {
    local stack_name=$1
    local max_retries=5
    local retry_count=0
    
    while [ $retry_count -lt $max_retries ]; do
        log_info "Attempting to delete stack: $stack_name (attempt $((retry_count + 1))/$max_retries)"
        
        if ! check_stack_exists "$stack_name"; then
            log_info "Stack $stack_name does not exist"
            return 0
        fi
        
        # Delete the stack
        aws cloudformation delete-stack \
            --stack-name "$stack_name" \
            --region "${REGION}"
        
        # Wait for deletion with timeout
        if aws cloudformation wait stack-delete-complete \
            --stack-name "$stack_name" \
            --region "${REGION}" 2>/dev/null; then
            log_info "Stack $stack_name deleted successfully"
            return 0
        else
            local status=$(get_stack_status "$stack_name")
            if [ "$status" = "DELETE_FAILED" ]; then
                log_error "Stack deletion failed. Attempting cleanup..."
                
                # Get failed resources
                FAILED_RESOURCES=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "StackResources[?ResourceStatus=='DELETE_FAILED'].{Type:ResourceType,Id:PhysicalResourceId}" \
                    --output json \
                    --region "${REGION}")
                
                log_warning "Failed resources: $FAILED_RESOURCES"
                
                # Force cleanup specific resource types
                if echo "$FAILED_RESOURCES" | grep -q "ElastiCache"; then
                    cleanup_elasticache
                fi
                
                if echo "$FAILED_RESOURCES" | grep -q "ECS::Service"; then
                    force_cleanup_ecs
                fi
                
                if echo "$FAILED_RESOURCES" | grep -q "AutoScaling"; then
                    force_cleanup_asg
                fi
                
                retry_count=$((retry_count + 1))
                sleep 30
            else
                log_error "Unexpected stack status: $status"
                return 1
            fi
        fi
    done
    
    log_error "Failed to delete stack after $max_retries attempts"
    return 1
}

# Monitor CloudFormation stack progress
monitor_stack_progress() {
    local stack_name=$1
    local operation=$2
    
    log_info "Monitoring $operation progress for stack: $stack_name"
    
    while true; do
        local status=$(get_stack_status "$stack_name")
        
        case "$status" in
            "CREATE_IN_PROGRESS"|"UPDATE_IN_PROGRESS"|"DELETE_IN_PROGRESS")
                # Get current time
                local current_time=$(date '+%H:%M:%S')
                
                # Show resource counts
                local total=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "length(StackResources)" \
                    --output text \
                    --region "${REGION}" 2>/dev/null || echo "0")
                
                local completed=$(aws cloudformation describe-stack-resources \
                    --stack-name "$stack_name" \
                    --query "length(StackResources[?ResourceStatus=='CREATE_COMPLETE' || ResourceStatus=='UPDATE_COMPLETE' || ResourceStatus=='DELETE_COMPLETE'])" \
                    --output text \
                    --region "${REGION}" 2>/dev/null || echo "0")
                
                # Get the latest event
                local latest_event=$(aws cloudformation describe-stack-events \
                    --stack-name "$stack_name" \
                    --query "StackEvents[0].{Resource:LogicalResourceId,Status:ResourceStatus}" \
                    --output text \
                    --region "${REGION}" 2>/dev/null | tr '\t' ':')
                
                # Clear line and show progress
                echo -ne "\r\033[K${current_time} ${YELLOW}[PROGRESS]${NC} $operation: "
                
                if [ "$total" -gt 0 ]; then
                    local percentage=$((completed * 100 / total))
                    echo -ne "$completed/$total ($percentage%) - $latest_event"
                else
                    echo -ne "$latest_event"
                fi
                
                # Show ECS service status if deploying services (on new line)
                if [[ "$stack_name" == *"services"* ]] && [[ "$status" == "CREATE_IN_PROGRESS" ]]; then
                    echo ""
                    show_ecs_service_status
                    echo -ne "\r"
                fi
                
                sleep 3
                ;;
            "CREATE_COMPLETE"|"UPDATE_COMPLETE")
                echo -e "\n${GREEN}[SUCCESS]${NC} $operation completed successfully!"
                # Show final ECS service status for services stack
                if [[ "$stack_name" == *"services"* ]]; then
                    show_ecs_service_status
                fi
                break
                ;;
            "DELETE_COMPLETE"|"DOES_NOT_EXIST")
                echo -e "\n${GREEN}[SUCCESS]${NC} Stack deleted successfully!"
                break
                ;;
            "CREATE_FAILED"|"UPDATE_FAILED"|"DELETE_FAILED"|"ROLLBACK_COMPLETE"|"UPDATE_ROLLBACK_COMPLETE")
                echo -e "\n${RED}[FAILED]${NC} $operation failed with status: $status"
                
                # Show error events
                log_error "Recent error events:"
                aws cloudformation describe-stack-events \
                    --stack-name "$stack_name" \
                    --query "StackEvents[?ResourceStatus=='CREATE_FAILED' || ResourceStatus=='UPDATE_FAILED' || ResourceStatus=='DELETE_FAILED'][0:5].{Resource:LogicalResourceId,Reason:ResourceStatusReason}" \
                    --output table \
                    --region "${REGION}"
                
                return 1
                ;;
            *)
                echo -e "\n${YELLOW}[WARNING]${NC} Unexpected status: $status"
                sleep 5
                ;;
        esac
    done
}

# Show ECS service deployment status
show_ecs_service_status() {
    local services=$(aws ecs list-services --cluster "${CLUSTER_NAME}" --region "${REGION}" --query "serviceArns[]" --output text 2>/dev/null)
    if [ -n "$services" ]; then
        echo "  ECS Service Status:"
        for service_arn in $services; do
            local service_name=$(echo "$service_arn" | awk -F'/' '{print $NF}')
            local service_info=$(aws ecs describe-services \
                --cluster "${CLUSTER_NAME}" \
                --services "$service_arn" \
                --region "${REGION}" \
                --query "services[0].{desired:desiredCount,running:runningCount,pending:pendingCount}" \
                --output json 2>/dev/null)
            
            if [ -n "$service_info" ] && [ "$service_info" != "null" ]; then
                local desired=$(echo "$service_info" | jq -r '.desired // 0')
                local running=$(echo "$service_info" | jq -r '.running // 0')
                local pending=$(echo "$service_info" | jq -r '.pending // 0')
                
                if [ "$running" -eq "$desired" ] && [ "$pending" -eq 0 ]; then
                    echo -e "    ${GREEN}✓${NC} $service_name: $running/$desired running"
                else
                    echo -e "    ${YELLOW}⟳${NC} $service_name: $running/$desired running, $pending pending"
                fi
            fi
        done
    else
        # If no services in ECS yet, show CloudFormation resource status
        echo "  CloudFormation Resource Status:"
        local cf_services=$(aws cloudformation describe-stack-resources \
            --stack-name "${stack_name}" \
            --query "StackResources[?ResourceType=='AWS::ECS::Service'].{Name:LogicalResourceId,Status:ResourceStatus}" \
            --output json \
            --region "${REGION}" 2>/dev/null)
        
        if [ -n "$cf_services" ] && [ "$cf_services" != "[]" ]; then
            echo "$cf_services" | jq -r '.[] | "    \(.Name): \(.Status)"'
        fi
    fi
}

# Build and push Docker image with retry
build_and_push_image() {
    local tag=${1:-latest}
    
    log_info "Building Docker image..."
    
    # Check if Dockerfile exists in parent directory (Git root)
    if [ ! -f "../Dockerfile" ]; then
        log_error "Dockerfile not found in parent directory (project root)"
        return 1
    fi
    
    # Build image using parent directory as context
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would build Docker image: ${ECR_URI}:${tag}"
    else
        if ! docker build -t "${ECR_URI}:${tag}" -f ../Dockerfile ..; then
            log_error "Failed to build Docker image"
            return 1
        fi
    fi
    
    # Login to ECR
    log_info "Logging in to ECR..."
    if [ "$DRY_RUN" != true ]; then
        aws ecr get-login-password --region "${REGION}" | \
            docker login --username AWS --password-stdin "${AWS_ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
    fi
    
    # Create repository if it doesn't exist
    if ! aws ecr describe-repositories \
        --repository-names "${ECR_REPOSITORY}" \
        --region "${REGION}" &> /dev/null; then
        log_info "Creating ECR repository..."
        if [ "$DRY_RUN" != true ]; then
            aws ecr create-repository \
                --repository-name "${ECR_REPOSITORY}" \
                --image-scanning-configuration scanOnPush=true \
                --region "${REGION}" &> /dev/null
        fi
    fi
    
    # Push image with retry
    push_with_retry() {
        local max_retries=3
        local retry_count=0
        
        while [ $retry_count -lt $max_retries ]; do
            log_info "Pushing Docker image (attempt $((retry_count + 1))/$max_retries)..."
            
            if [ "$DRY_RUN" = true ]; then
                log_info "[DRY RUN] Would push Docker image: ${ECR_URI}:${tag}"
                return 0
            fi
            
            if docker push "${ECR_URI}:${tag}"; then
                log_info "Docker image pushed successfully"
                return 0
            else
                retry_count=$((retry_count + 1))
                if [ $retry_count -lt $max_retries ]; then
                    log_warning "Push failed, retrying in 10 seconds..."
                    sleep 10
                fi
            fi
        done
        
        log_error "Failed to push Docker image after $max_retries attempts"
        return 1
    }
    
    push_with_retry
}
# Upload template to S3 with proper URL format - FIXED VERSION
upload_template_to_s3() {
    local template_file="$1"
    local template_size=$(wc -c < "$template_file")

    log_info "Template size: $template_size bytes. Uploading to S3..." >&2

    # Create S3 bucket for templates if it doesn't exist
    local bucket_name="${PROJECT_NAME}-cf-templates-${AWS_ACCOUNT_ID}-${REGION}"

    # Check if bucket exists using a different approach to avoid table output
    local bucket_exists=false
    if aws s3 ls "s3://${bucket_name}" --region "${REGION}" >/dev/null 2>&1; then
        bucket_exists=true
    fi

    if [ "$bucket_exists" = false ]; then
        log_info "Creating S3 bucket for templates: $bucket_name" >&2

        # Create bucket with proper location constraint
        if [ "${REGION}" = "us-east-1" ]; then
            aws s3api create-bucket \
                --bucket "$bucket_name" \
                --region "${REGION}" >/dev/null 2>&1
        else
            aws s3api create-bucket \
                --bucket "$bucket_name" \
                --region "${REGION}" \
                --create-bucket-configuration LocationConstraint="${REGION}" >/dev/null 2>&1
        fi

        # Wait a moment for bucket creation to propagate
        sleep 2

        # Enable versioning
        aws s3api put-bucket-versioning \
            --bucket "$bucket_name" \
            --versioning-configuration Status=Enabled \
            --region "${REGION}" >/dev/null 2>&1

        # Set bucket policy to allow CloudFormation access
        aws s3api put-bucket-policy \
            --bucket "$bucket_name" \
            --policy "{
                \"Version\": \"2012-10-17\",
                \"Statement\": [
                    {
                        \"Sid\": \"AllowCloudFormationRead\",
                        \"Effect\": \"Allow\",
                        \"Principal\": {
                            \"Service\": \"cloudformation.amazonaws.com\"
                        },
                        \"Action\": \"s3:GetObject\",
                        \"Resource\": \"arn:aws:s3:::${bucket_name}/*\"
                    }
                ]
            }" \
            --region "${REGION}" >/dev/null 2>&1 || {
                # If policy fails, continue without it - CloudFormation can still access public buckets
                log_warning "Could not set bucket policy, continuing..." >&2
            }
    fi

    # Generate unique template key
    local timestamp=$(date +%s)
    local template_basename=$(basename "$template_file" .yaml)
    local template_key="${template_basename}-${timestamp}.yaml"

    # Upload template to S3
    log_info "Uploading template to s3://${bucket_name}/${template_key}..." >&2
    if ! aws s3 cp "$template_file" "s3://${bucket_name}/${template_key}" \
        --region "${REGION}" \
        --content-type "text/yaml" >/dev/null 2>&1; then
        log_error "Failed to upload template to S3" >&2
        return 1
    fi

    # Return the correct CloudFormation-compatible S3 URL
    # Use the regional S3 format that CloudFormation expects
    echo "https://${bucket_name}.s3.${REGION}.amazonaws.com/${template_key}"
}
# Alternative function that checks template size first
deploy_with_template() {
    local template_file="$1"
    local stack_name="$2"
    local parameters=("${@:3}")

    local template_size=$(wc -c < "$template_file")
    local max_local_size=51200  # 50KB limit for direct template body

    if [ "$template_size" -gt "$max_local_size" ]; then
        log_info "Template size ($template_size bytes) exceeds limit. Using S3..."
        local template_url=$(upload_template_to_s3 "$template_file")
        local template_param="--template-url"
        local template_value="$template_url"
    else
        log_info "Template size ($template_size bytes) is within limit. Using direct upload..."
        local template_param="--template-body"
        local template_value="file://$template_file"
    fi

    # Return the parameters for use in CloudFormation commands
    echo "$template_param"
    echo "$template_value"
}
# Updated deploy_infrastructure function - always use S3 for large templates
deploy_infrastructure() {
    log_info "Deploying infrastructure stack..."

    local template_file="cloudformation/main.yaml"
    if [ ! -f "$template_file" ]; then
        log_error "CloudFormation template not found: $template_file"
        return 1
    fi

    # Check template size first
    local template_size=$(wc -c < "$template_file")
    log_info "Template size: $template_size bytes"

    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would deploy stack: ${PROJECT_NAME}-main"
        return 0
    fi

    # For large templates, always use S3 upload
    local max_local_size=40960  # 40KB limit to be safe (AWS limit is 51200)
    local template_param=""
    local template_value=""

    if [ "$template_size" -gt "$max_local_size" ]; then
        log_info "Template size ($template_size bytes) exceeds AWS limit. Uploading to S3..."
        template_value=$(upload_template_to_s3 "$template_file")
        if [ $? -ne 0 ] || [ -z "$template_value" ]; then
            log_error "Failed to upload template to S3"
            return 1
        fi
        template_param="--template-url"
        log_info "Using S3 template URL: $template_value"
    else
        log_info "Template size ($template_size bytes) is within limit. Using direct upload..."
        # First validate template locally
        log_info "Validating CloudFormation template..."
        if ! aws cloudformation validate-template \
            --template-body "file://$template_file" \
            --region "${REGION}" >/dev/null 2>&1; then
            log_error "Template validation failed"
            return 1
        fi
        template_param="--template-body"
        template_value="file://$template_file"
    fi

    log_info "⭐ template_value : $template_value"
    # Prepare parameters
    local params=(
        "ParameterKey=ProjectName,ParameterValue=${PROJECT_NAME}"
        "ParameterKey=Environment,ParameterValue=${ENVIRONMENT:-dev}"
    )

    # Check if stack exists
    local stack_name="${PROJECT_NAME}-main"
    local stack_exists=false
    if check_stack_exists "$stack_name"; then
        stack_exists=true
        log_info "Stack exists, updating..."
    else
        log_info "Creating new stack..."
    fi

    # Execute stack operation with proper command structure
    if [ "$stack_exists" = true ]; then
        log_info "Executing update-stack command..."
        if ! aws cloudformation update-stack \
            $template_param "$template_value" \
            --stack-name "$stack_name" \
            --parameters "${params[@]}" \
            --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
            --region "${REGION}"; then

            local update_status=$?
            if [ $update_status -eq 254 ]; then
                log_info "No changes detected for infrastructure stack"
                return 0
            else
                log_error "Failed to update stack (exit code: $update_status)"
                # Show the actual error from CloudFormation
                aws cloudformation describe-stack-events \
                    --stack-name "$stack_name" \
                    --query "StackEvents[?ResourceStatus=='UPDATE_FAILED'][0:3].{Resource:LogicalResourceId,Reason:ResourceStatusReason}" \
                    --output table \
                    --region "${REGION}" 2>/dev/null || true
                return $update_status
            fi
        fi
    else
        log_info "Executing create-stack command..."
        if ! aws cloudformation create-stack \
            $template_param "$template_value" \
            --stack-name "$stack_name" \
            --parameters "${params[@]}" \
            --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
            --region "${REGION}"; then
            log_error "Failed to create stack"
            return 1
        fi
    fi

    # Monitor progress
    monitor_stack_progress "$stack_name" "Infrastructure deployment"
    local monitor_result=$?

    if [ $monitor_result -ne 0 ]; then
        log_error "Infrastructure deployment failed"
        return 1
    fi

    log_info "Infrastructure deployment completed successfully"
    return 0
}
deploy_ecs_services() {
    log_info "Deploying ECS services stack..."
    
    local template_file="cloudformation/ecs-services.yaml"
    if [ ! -f "$template_file" ]; then
        log_error "ECS services template not found: $template_file"
        return 1
    fi
    
    # Check if template needs S3 upload
    local template_url=$(upload_template_to_s3 "$template_file")
    local template_param
    local template_value
    if [[ "$template_url" == "https://"* ]]; then
        template_param="--template-url"
        template_value="$template_url"
        log_info "Using S3 template URL for services: $template_url"
    else
        template_param="--template-body"
        template_value="file://$template_file"
        log_info "Using local template file for services"
    fi
    
    # Get outputs from main stack
    log_info "Getting outputs from main stack..."
    local outputs=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs" \
        --output json \
        --region "${REGION}")
    
    # Get TiKV PD endpoints dynamically
    log_info "Discovering TiKV PD endpoints..."
    local PD_ENDPOINTS=""
    
    # Try to get the ASG name from the main stack outputs first
    local tikv_pd_asg_name="${PROJECT_NAME}-${ENVIRONMENT:-dev}-tikv-pd-asg"
    
    if [ -z "$tikv_pd_asg_name" ]; then
        # Fallback to constructed name
        tikv_pd_asg_name="${PROJECT_NAME}-${ENVIRONMENT:-dev}-tikv-pd-asg"
        log_warning "TiKV PD ASG name not found in outputs, using: $tikv_pd_asg_name"
    fi
    
    # Get PD instance IDs
    local PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
        --auto-scaling-group-names "$tikv_pd_asg_name" \
        --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
        --output text \
        --region "${REGION}" 2>/dev/null || echo "")
    
    if [ -n "$PD_INSTANCE_IDS" ]; then
        for id in $PD_INSTANCE_IDS; do
            local IP=$(aws ec2 describe-instances \
                --instance-ids $id \
                --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                --output text \
                --region "${REGION}" 2>/dev/null)
            if [ -n "$IP" ]; then
                if [ -z "$PD_ENDPOINTS" ]; then
                    PD_ENDPOINTS="${IP}:2379"
                else
                    PD_ENDPOINTS="${PD_ENDPOINTS},${IP}:2379"
                fi
            fi
        done
        log_info "Discovered TiKV PD endpoints: $PD_ENDPOINTS"
    else
        # Fallback to default if TiKV is not deployed or not ready
        log_warning "Could not discover TiKV PD endpoints, using defaults"
        PD_ENDPOINTS="127.0.0.1:2379,127.0.0.1:2381,127.0.0.1:2383"
    fi
    
    # Create a temporary JSON file for parameters to avoid shell interpretation issues
    local params_file="/tmp/cf-params-$$.json"
    
    # Start building the JSON parameters array
    echo '[' > "$params_file"
    echo '  {"ParameterKey": "ProjectName", "ParameterValue": "'"${PROJECT_NAME}"'"},' >> "$params_file"
    echo '  {"ParameterKey": "Environment", "ParameterValue": "'"${ENVIRONMENT:-dev}"'"},' >> "$params_file"
    echo '  {"ParameterKey": "TiKVPDEndpoints", "ParameterValue": "'"${PD_ENDPOINTS}"'"}' >> "$params_file"
    
    # List of parameters that the services template expects from main stack outputs
    local expected_params=(
        "MainECSClusterName"
        "ECRRepositoryURI"
        {# "ALBDNSName" #}
        "TaskExecutionRoleArn"
        "TaskRoleArn"
        "ServiceDiscoveryNamespaceId"
        {# "ALBTargetGroupCoordinatorArn" #}
        {# {% for realm in config.nodes.realms %}"ALBTargetGroupRealm{{ realm.id }}Arn" {% endfor %} #}
        "RedisCoordinatorEndpoint"
        {# {% for realm in config.nodes.realms %}"RedisRealm{{ realm.id }}Endpoint" {% endfor %} #}
        {# {% if config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled %}"TimescaleDBEndpoint"{% endif %} #}
        {# {% if config.global_services and config.global_services.timescaledb and config.global_services.timescaledb.enabled %}"DBPasswordSecretArn"{% endif %} #}
    )
    
    # Extract only the expected parameters
    for param in "${expected_params[@]}"; do
        local value=$(echo "$outputs" | jq -r ".[] | select(.OutputKey==\"$param\") | .OutputValue // \"\"")
        if [ -n "$value" ]; then
            # Add comma before this parameter
            echo ',' >> "$params_file"
            # Properly escape the value for JSON
            echo -n '  {"ParameterKey": "'"$param"'", "ParameterValue": ' >> "$params_file"
            echo -n "$value" | jq -Rs . >> "$params_file"
            echo -n '}' >> "$params_file"
        else
            log_warning "Expected parameter $param not found in main stack outputs"
        fi
    done
    
    echo '' >> "$params_file"
    echo ']' >> "$params_file"
    
    # Debug: show parameters if verbose
    if [ "$VERBOSE" = true ]; then
        log_debug "Parameters JSON:"
        cat "$params_file"
    fi
    
    if [ "$DRY_RUN" = true ]; then
        log_info "[DRY RUN] Would deploy services stack with parameters:"
        cat "$params_file"
    else
        local stack_name="${PROJECT_NAME}-services"
        
        # Check if stack exists
        if check_stack_exists "$stack_name"; then
            log_info "Services stack exists, updating..."
            aws cloudformation update-stack \
                $template_param "$template_value" \
                --stack-name "$stack_name" \
                --parameters file://"$params_file" \
                --capabilities CAPABILITY_IAM \
                --region "${REGION}" 2>/dev/null || {
                    local update_status=$?
                    if [ $update_status -eq 254 ]; then
                        log_info "No changes detected for services stack"
                        rm -f "$params_file"
                        return 0
                    else
                        log_error "Failed to update services stack"
                        rm -f "$params_file"
                        return $update_status
                    fi
                }
        else
            log_info "Creating new services stack..."
            
            # Use the file:// syntax for parameters
            if ! aws cloudformation create-stack \
                $template_param "$template_value" \
                --stack-name "$stack_name" \
                --parameters file://"$params_file" \
                --capabilities CAPABILITY_IAM \
                --region "${REGION}"; then
                
                log_error "Failed to create services stack"
                rm -f "$params_file"
                return 1
            fi
        fi
        
        # Clean up temp file
        rm -f "$params_file"
        
        # Monitor progress
        monitor_stack_progress "$stack_name" "Services deployment"
    fi
}
